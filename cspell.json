{
	"$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
	"version": "0.2",
	"language": "en-US",
	"dictionaryDefinitions": [
		{
			"name": "project-words",
			"path": "./project-words.txt",
			"addWords": true
		}
	],
	"dictionaries": [
		"project-words"
	],
	"files": [
		"**/*.{md,mdx,astro,ts}"
	],
	"ignorePaths": [
		"node_modules/**",
		"dist/**",
		".astro/**",
		".lighthouseci/**",
		".claude/kb/**",
		"package-lock.json",
		"design/**",
		"tests/fixtures/**",
		"src/content/docs/vi/**",
		"src/i18n/home/vi.ts",
		"src/i18n/site-ui.ts",
		"src/content/i18n/vi.json",
		"research/**"
	],
	"ignoreRegExpList": [
		"Urls",
		"Email",
		"/```[\\s\\S]*?```/g",
		"/`[^`\\n]+`/g"
	]
}
