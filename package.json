{
  "name": "datafromzero",
  "version": "0.0.0",
  "private": true,
  "description": "From A1 to AI: a free, open roadmap for learning data from zero.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "kb": "node scripts/kb.mjs build",
    "check": "node scripts/check.mjs",
    "check:graph": "node scripts/check-graph.ts",
    "check:kb": "node scripts/kb.mjs check",
    "check:notebooks": "node scripts/check-notebooks.mjs",
    "spell": "cspell --no-progress --no-summary",
    "lint:md": "markdownlint-cli2",
    "test": "npm run test:unit && npm run test:fixtures",
    "test:unit": "node --test tests/graph.test.ts tests/review.test.ts tests/roadmap.test.ts",
    "test:fixtures": "node --test tests/fixtures.test.mjs",
    "review-report": "node scripts/review-report.ts",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/starlight": "0.43.1",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "astro": "7.4.12",
    "astro-auto-import": "0.6.0",
    "gsap": "3.15.1",
    "katex": "0.16.22",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "cspell": "10.5.1",
    "markdownlint-cli2": "0.24.1",
    "starlight-links-validator": "0.27.0",
    "yaml": "2.9.1"
  }
}
