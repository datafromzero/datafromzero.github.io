{
  "name": "datafromzero",
  "version": "1.0.0",
  "private": true,
  "description": "From A1 to AI: a free, open roadmap for learning data from zero.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "kb": "node scripts/kb.mjs build",
    "check": "node scripts/check.mjs",
    "check:graph": "node scripts/check-graph.ts",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:changelog": "node scripts/check-changelog.ts",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:figures": "node scripts/check-figure-centering.mjs && node scripts/refresh-concept-figures.mjs --check",
    "check:kb": "node scripts/kb.mjs check",
    "check:notebooks": "node scripts/check-notebooks.mjs",
    "check:cheatsheet-python": "python3 scripts/check-cheatsheet-python.py",
    "check:app-events": "python3 scripts/build-app-events.py --check",
    "check:extras": "python3 scripts/build-settlements-extract.py --check && python3 scripts/build-sales-clean.py --check && python3 scripts/build-take-home-extract.py --check",
    "spell": "cspell --no-progress --no-summary",
    "lint:md": "markdownlint-cli2",
    "test": "npm run test:unit && npm run test:fixtures",
    "test:unit": "node --test tests/graph.test.ts tests/review.test.ts tests/roadmap.test.ts tests/deep-dives.test.ts tests/career-quiz.test.ts tests/sql-errors.test.ts tests/cafe-schema.test.ts tests/cheatsheet.test.ts tests/step-animation.test.ts tests/figure-extent.test.ts tests/changelog.test.ts tests/feedback-worker.test.ts tests/citation.test.ts",
    "test:fixtures": "node --test tests/fixtures.test.mjs",
    "review-report": "node scripts/review-report.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "perf": "node scripts/perf.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "research:sync": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/sync-research-issues.mjs && npm run kb"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/starlight": "0.43.1",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "astro": "7.4.12",
    "astro-auto-import": "0.6.0",
    "gsap": "3.15.1",
    "katex": "0.16.47",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "cspell": "10.5.1",
    "markdownlint-cli2": "0.24.1",
    "starlight-links-validator": "0.27.0",
    "yaml": "2.9.1"
  }
}
