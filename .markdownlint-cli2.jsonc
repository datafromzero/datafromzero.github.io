{
	// Starlight content: frontmatter is YAML, headings come from the title (so pages start at h2),
	// and MDX components appear as inline HTML/JSX. Fixtures and generated files are not linted.
	"config": {
		"default": true,
		"MD013": false,
		"MD025": false,
		"MD033": false,
		"MD041": false,
		"MD022": false,
		"MD031": false,
		"MD032": false,
		"MD034": false,
		"MD040": false,
		"MD060": false,
		"MD024": { "siblings_only": true },
		"MD007": { "indent": 2 },
		"MD029": { "style": "ordered" },
		"MD046": { "style": "fenced" },
		"MD049": { "style": "asterisk" },
		"MD050": { "style": "asterisk" }
	},
	"globs": ["**/*.{md,mdx}"],
	"ignores": [
		"node_modules/**",
		"dist/**",
		".astro/**",
		".lighthouseci/**",
		".claude/**",
		"design/**",
		"tests/fixtures/**"
	]
}
