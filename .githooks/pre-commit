#!/bin/sh
# Keep the knowledge graph fresh (CLAUDE.md, "Knowledge graph"): when the files kb reads changed and
# .claude/kb/ is stale, rebuild it and add it to this commit. About a second, no network.
# Installed by `npm run setup-hooks` (also run by `npm ci` through "prepare"). Skip once with SKIP_KB_HOOK=1.
[ -n "$SKIP_KB_HOOK" ] && exit 0
command -v node >/dev/null 2>&1 || exit 0
[ -f scripts/kb.mjs ] || exit 0
if ! node scripts/kb.mjs check >/dev/null 2>&1; then
	if node scripts/kb.mjs build >/dev/null; then
		git add .claude/kb/graph.json .claude/kb/GRAPH_REPORT.md
		echo "pre-commit: knowledge graph was stale; rebuilt it and added it to this commit"
	else
		echo "pre-commit: npm run kb failed; fix it or commit with SKIP_KB_HOOK=1" >&2
		exit 1
	fi
fi
