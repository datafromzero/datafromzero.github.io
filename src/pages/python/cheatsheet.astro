---
// SPEC §3.1 / D44: "Python in a nutshell", the one-page, printable cheatsheet of the Python stage. A page, not a lesson: its
// content is the data module `src/data/cheatsheets/python.ts` (distilled from published lessons only), drawn by the reusable
// `Cheatsheet` component. A normal docs page (sidebar in the Python group, "On this page" list); no JavaScript of its own.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Cheatsheet from '../../components/cheatsheet/Cheatsheet.astro';
import { pythonCheatsheet } from '../../data/cheatsheets/python.ts';

const headings = pythonCheatsheet.parts.map((p) => ({ depth: 2, slug: p.id, text: p.title }));
---

<StarlightPage
	frontmatter={{
		title: pythonCheatsheet.title,
		description: pythonCheatsheet.description,
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
	}}
	headings={headings}
>
	<Cheatsheet sheet={pythonCheatsheet} />
</StarlightPage>
