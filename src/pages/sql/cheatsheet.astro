---
// SPEC §3.1 / D44: "SQL in a nutshell", the one-page, printable cheatsheet of the SQL stage. A page, not a lesson: its
// content is the data module `src/data/cheatsheets/sql.ts` (distilled from published lessons only), drawn by the reusable
// `Cheatsheet` component. A normal docs page (sidebar in the SQL group, "On this page" list); no JavaScript of its own.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Cheatsheet from '../../components/cheatsheet/Cheatsheet.astro';
import { sqlCheatsheet } from '../../data/cheatsheets/sql.ts';

const headings = sqlCheatsheet.parts.map((p) => ({ depth: 2, slug: p.id, text: p.title }));
---

<StarlightPage
	frontmatter={{
		title: sqlCheatsheet.title,
		description: sqlCheatsheet.description,
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
	}}
	headings={headings}
>
	<Cheatsheet sheet={sqlCheatsheet} />
</StarlightPage>
