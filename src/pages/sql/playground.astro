---
// SPEC §3.1 / D42: the SQL playground. A full-height online compiler for the five cafe-sales tables: editor first,
// output beside it (below on phones), Tables as a side drawer, a "Try:" list of examples. Everything is set up before
// the learner arrives; the learner writes a query and sees the output. Nothing is stored or sent anywhere.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SqlPad from '../../components/content/SqlPad.astro';

const start = `-- Welcome. Press Run to see everything the cafe sells, priciest first.
SELECT product_name, category, unit_price_usd
FROM products
ORDER BY unit_price_usd DESC;`;

const examples = [
	{ label: 'All three stores', sql: 'SELECT * FROM stores;' },
	{
		label: 'Gold customers',
		sql: "SELECT customer_id, city, signup_date\nFROM customers\nWHERE loyalty_tier = 'gold'\nORDER BY signup_date;",
	},
	{
		label: 'Orders per store',
		sql: 'SELECT store_id, COUNT(*) AS orders\nFROM orders\nGROUP BY store_id\nORDER BY store_id;',
	},
	{
		label: 'Orders per month',
		sql: "SELECT strftime(ordered_at, '%Y-%m') AS month, COUNT(*) AS orders\nFROM orders\nWHERE status = 'completed'\nGROUP BY month\nORDER BY month;",
	},
	{
		label: 'Five best sellers',
		sql: 'SELECT p.product_name, SUM(oi.quantity) AS units\nFROM order_items oi\nJOIN products p ON p.product_id = oi.product_id\nGROUP BY p.product_name\nORDER BY units DESC\nLIMIT 5;',
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'SQL playground',
		description: 'Write SQL and see the result at once, on five practice tables of a small cafe chain. Nothing to install, nothing saved.',
		template: 'splash',
		tableOfContents: false,
	}}
>
	<div class="dfz-playground">
		<p class="dfz-playground-intro">
			Five practice tables are ready. Write a query, press Run, and read the output. Open <strong>Tables</strong> to see the
			columns. Nothing is saved and nothing leaves your browser.
		</p>
		<noscript>
			<p><strong>The playground needs JavaScript</strong> to run queries. Turn it on and reload. Meanwhile, here are the example queries to try:</p>
			{examples.map((x) => <pre><code>{x.sql}</code></pre>)}
		</noscript>
		<SqlPad sql={start} variant="page" examples={examples} />
	</div>
</StarlightPage>

<style is:global>
	/* Wider than a lesson column: the editor and the output sit side by side. */
	.dfz-playground {
		width: min(100%, 72rem);
		margin-inline: auto;
	}
	.dfz-playground-intro {
		margin: 0 0 1rem;
		color: var(--mute);
	}
	[data-has-sidebar] .dfz-playground,
	main:has(.dfz-playground) {
		max-width: none;
	}
</style>
