---
// SPEC §3.1 / D44: "Excel in a nutshell", the one-page, printable cheatsheet of the Excel stage. A page, not a lesson: its
// content is the data module `src/data/cheatsheets/excel.ts` (distilled from published lessons only), drawn by the reusable
// `Cheatsheet` component. A normal docs page (sidebar in the Excel group, "On this page" list); no JavaScript of its own.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Cheatsheet from '../../components/cheatsheet/Cheatsheet.astro';
import { excelCheatsheet } from '../../data/cheatsheets/excel.ts';

const headings = excelCheatsheet.parts.map((p) => ({ depth: 2, slug: p.id, text: p.title }));
---

<StarlightPage
	frontmatter={{
		title: excelCheatsheet.title,
		description: excelCheatsheet.description,
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
	}}
	headings={headings}
>
	<Cheatsheet sheet={excelCheatsheet} />
</StarlightPage>
