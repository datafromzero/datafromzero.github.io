---
// SPEC §3.1 / D69: the printable completion page. The learner types a name, picks a track (four radio buttons, CSS only),
// adds a date and a link, and prints one page. It is not a certificate and says so on the page. No JavaScript, no form
// that sends anything: what is typed stays in the browser and prints as it is. A page, not a lesson (`src/pages/`).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CERTIFICATE_MESSAGE, COMPLETION_TRACKS, NOT_VERIFIED } from '../data/completion.ts';

// The first sentence of the line is bold: "This page is not a verified certificate."
const cut = NOT_VERIFIED.indexOf('. ') + 1;
const notFirst = NOT_VERIFIED.slice(0, cut);
const notRest = NOT_VERIFIED.slice(cut + 1);
---

<StarlightPage
	frontmatter={{
		title: 'Completion page',
		description: 'Print a one-page note that you finished a datafromzero career roadmap, with the capstone artifacts to attach. It is not a verified certificate.',
		tableOfContents: false,
	}}
>
	<div class="cp">
		<p class="cp-screen">
			Finished a career roadmap? Pick your track, type your name and the date, and print this page (Ctrl or Cmd + P). Put the artifacts of your
			capstone with it. <strong>This is not a certificate:</strong> datafromzero has no accounts, so it cannot check who finished. What you type
			stays in this browser tab and is sent nowhere.
		</p>

		<fieldset class="cp-pick">
			<legend>Your track</legend>
			{
				COMPLETION_TRACKS.map((t) => (
					<label class="cp-radio">
						<input type="radio" name="track" id={`cp-t-${t.id}`} value={t.id} />
						{t.name}
					</label>
				))
			}
		</fieldset>
		<p class="cp-hint cp-screen">Pick a track to see its artifacts.</p>

		<div class="cp-sheet">
			<p class="cp-site">datafromzero · From A1 to AI</p>
			<p class="cp-stmt">
				I completed the datafromzero{' '}
				{COMPLETION_TRACKS.map((t) => <strong class={`cp-tn cp-t-${t.id}`}>{t.name}</strong>)}
				<span class="cp-blank" aria-hidden="true"></span> roadmap.
			</p>

			<div class="cp-fields">
				<label class="cp-field">
					<span>Name</span>
					<input type="text" name="name" autocomplete="name" spellcheck="false" />
				</label>
				<label class="cp-field cp-field-date">
					<span>Date</span>
					<input type="date" name="date" />
				</label>
				<label class="cp-field cp-field-wide">
					<span>Where my project is published</span>
					<input type="text" name="link" inputmode="url" autocomplete="off" spellcheck="false" />
				</label>
			</div>

			{
				COMPLETION_TRACKS.map((t) => (
					<section class={`cp-art cp-a-${t.id}`}>
						<h2>Attach the artifacts of the capstone</h2>
						<p>
							<a href={t.capstone.href}>{t.capstone.title}</a> ({t.capstone.code}): the things it asks you to <a href={`${t.capstone.href}${t.capstone.handIn}`}>hand in</a>.
						</p>
						<ul>
							{t.artifacts.map((a) => (
								<li>{a}</li>
							))}
						</ul>
					</section>
				))
			}

			<p class="cp-not"><strong>{notFirst}</strong> {notRest}</p>

			<blockquote class="cp-msg">
				<p>{CERTIFICATE_MESSAGE}</p>
				<footer>The author of datafromzero</footer>
			</blockquote>
			<p class="cp-url">datafromzero.github.io · content CC BY 4.0</p>
		</div>
	</div>
</StarlightPage>

<style is:global>
	.cp {
		max-width: 44rem;
	}
	.cp-pick {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 1rem 0 0;
		padding: 0.75rem 1rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.cp-pick legend {
		padding: 0 0.4rem;
		color: var(--mute);
		font-size: 0.875rem;
	}
	.cp-radio {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem; /* a touch target of 44 px */
		cursor: pointer;
	}
	.cp-radio input {
		width: 1.15rem;
		height: 1.15rem;
		accent-color: var(--fg);
	}
	.cp-hint {
		margin: 0.5rem 0 0;
		color: var(--mute);
	}
	.cp-sheet {
		margin-top: 1.25rem;
		padding: 1.25rem 1.5rem 1rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.cp-site {
		margin: 0;
		color: var(--mute);
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
	}
	.cp-stmt {
		margin: 0.5rem 0 1rem;
		font-size: 1.6rem;
		line-height: 1.25;
		font-weight: 600;
	}
	.cp-fields {
		display: grid;
		grid-template-columns: 1fr 12rem;
		gap: 0.75rem 1.25rem;
	}
	.cp-field {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		color: var(--mute);
		font-size: 0.8125rem;
	}
	.cp-field-wide {
		grid-column: 1 / -1;
	}
	.cp-field input {
		box-sizing: border-box;
		width: 100%;
		min-height: 2.5rem;
		padding: 0.25rem 0.1rem;
		border: 0;
		border-bottom: 1px solid var(--fg);
		border-radius: 0;
		background: transparent;
		color: var(--fg);
		font: inherit;
		font-size: 1.05rem;
	}
	.cp-field input:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.cp-art {
		display: none;
		margin-top: 1.25rem;
	}
	.cp-art h2 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		font-weight: 600;
	}
	.cp-art p {
		margin: 0 0 0.4rem;
	}
	.cp-art ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cp-art li {
		margin: 0.2rem 0;
		padding-inline-start: 1.6rem;
		position: relative;
	}
	.cp-art li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.3em;
		width: 0.85em;
		height: 0.85em;
		border: 1.5px solid var(--fg);
		border-radius: 2px;
	}
	.cp-not {
		margin: 1.25rem 0 0;
		padding: 0.6rem 0.8rem;
		border: 1.5px solid var(--fg);
		border-radius: 6px;
	}
	.cp-msg {
		margin: 1rem 0 0;
		padding: 0 0 0 1rem;
		border-inline-start: 3px solid var(--line);
		color: var(--mute);
	}
	.cp-msg p {
		margin: 0;
	}
	.cp-msg footer {
		margin-top: 0.3rem;
		font-size: 0.8125rem;
	}
	.cp-url {
		margin: 0.9rem 0 0;
		color: var(--mute);
		font-size: 0.8125rem;
	}
	/* The choice, with no script: the block of the checked track shows, and the blank line shows until one is checked. */
	.cp-tn {
		display: none;
	}
	.cp-blank {
		display: inline-block;
		min-width: 9rem;
		border-bottom: 1px solid var(--fg);
	}
	.cp:has(.cp-radio input:checked) .cp-blank,
	.cp:has(.cp-radio input:checked) .cp-hint {
		display: none;
	}
	.cp:has(#cp-t-data-analyst:checked) .cp-t-data-analyst,
	.cp:has(#cp-t-data-engineer:checked) .cp-t-data-engineer,
	.cp:has(#cp-t-data-scientist:checked) .cp-t-data-scientist,
	.cp:has(#cp-t-ml-engineer:checked) .cp-t-ml-engineer {
		display: inline;
	}
	.cp:has(#cp-t-data-analyst:checked) .cp-a-data-analyst,
	.cp:has(#cp-t-data-engineer:checked) .cp-a-data-engineer,
	.cp:has(#cp-t-data-scientist:checked) .cp-a-data-scientist,
	.cp:has(#cp-t-ml-engineer:checked) .cp-a-ml-engineer {
		display: block;
	}

	@media (max-width: 30rem) {
		.cp-sheet {
			padding: 1rem;
		}
		.cp-stmt {
			font-size: 1.35rem;
		}
		.cp-fields {
			grid-template-columns: 1fr;
		}
	}

	/* Print: one sheet on A4 or Letter. Black on white, no site chrome, nothing after the sheet. */
	@media print {
		@page {
			margin: 14mm;
		}
		:root:has(.cp) .cp-screen,
		:root:has(.cp) .cp-pick,
		:root:has(.cp) footer,
		:root:has(.cp) .tb-gap,
		:root:has(.cp) main h1,
		:root:has(.cp) #_top {
			display: none !important;
		}
		:root:has(.cp) main,
		:root:has(.cp) .sl-markdown-content,
		:root:has(.cp) .content-panel {
			min-height: 0 !important;
			padding: 0 !important;
			margin: 0 !important;
		}
		.cp {
			max-width: none;
		}
		.cp-sheet {
			margin: 0;
			padding: 0;
			border: 0;
			break-inside: avoid;
		}
		.cp-site {
			color: #444;
		}
		.cp-stmt {
			margin: 4mm 0 8mm;
			font-size: 24pt;
		}
		.cp-fields {
			gap: 6mm 8mm;
		}
		.cp-field {
			color: #444;
			font-size: 9pt;
		}
		.cp-field input {
			min-height: 9mm;
			border-bottom-color: #000;
			color: #000;
			font-size: 13pt;
		}
		.cp-art {
			margin-top: 8mm;
		}
		.cp-art h2 {
			font-size: 12pt;
			font-weight: 600;
		}
		.cp-field input::-webkit-calendar-picker-indicator {
			display: none;
		}
		.cp-art li::before {
			border-color: #000;
		}
		.cp-not {
			margin-top: 8mm;
			border-color: #000;
		}
		.cp-msg {
			color: #333;
			border-inline-start-color: #999;
		}
		.cp-url {
			color: #444;
		}
		.cp-sheet a,
		.cp-sheet a[href^='http']::after {
			color: #000;
			text-decoration: none;
		}
		.cp-sheet a::after {
			content: none !important;
		}
	}
</style>
