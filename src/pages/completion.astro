---
// SPEC §3.1 / D69: the printable completion page. The learner types a name, a date and a link and picks a track (four radio
// buttons, CSS only); the page shows the two sheets it prints as: a landscape sheet in a certificate's style and a portrait
// page of the capstone's artifacts. It is not a certificate and says so on the page. No JavaScript, no form that sends
// anything: what is typed stays in this browser tab and prints as it is. A page, not a lesson (`src/pages/`).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CERTIFICATE_MESSAGE, COMPLETION_TRACKS, NOT_VERIFIED } from '../data/completion.ts';

// The first sentence of the line is bold: "This page is not a verified certificate."
const cut = NOT_VERIFIED.indexOf('. ') + 1;
const notFirst = NOT_VERIFIED.slice(0, cut);
const notRest = NOT_VERIFIED.slice(cut + 1);
// The ring of the badge: the name and the tagline, twice, so that the ring closes on itself.
const RING = 'DATAFROMZERO · FROM A1 TO AI · DATAFROMZERO · FROM A1 TO AI ·';
---

<StarlightPage
	frontmatter={{
		title: 'Completion page',
		description: 'Print a two-page note that you finished a datafromzero career roadmap, with the capstone artifacts to attach. It is not a verified certificate.',
		tableOfContents: false,
	}}
>
	<div class="cp">
		<blockquote class="cp-note cp-screen">
			<p>{CERTIFICATE_MESSAGE}</p>
			<p class="cp-by">The author of datafromzero</p>
		</blockquote>
		<p class="cp-screen">
			Finished a career roadmap? Pick your track and fill in the sheets below, then print this page (Ctrl or Cmd + P). It prints two pages: the
			first is landscape, the second lists the artifacts of your capstone to attach. <strong>This is not a certificate:</strong> datafromzero has
			no accounts, so it cannot check who finished. What you type stays in this browser tab and is sent nowhere.
		</p>

		<fieldset class="cp-pick">
			<legend>Your track</legend>
			{
				COMPLETION_TRACKS.map((t) => (
					<label class="cp-radio">
						<input type="radio" name="track" id={`cp-t-${t.id}`} value={t.id} />
						{t.name}
					</label>
				))
			}
		</fieldset>
		<p class="cp-hint cp-screen">Pick a track to see its artifacts.</p>

		<section class="cp-cert" aria-label="Page 1: completion sheet">
			<div class="cp-frame">
				<svg class="cp-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
					<circle cx="50" cy="50" r="46"></circle>
					<path d="M29 31C29 17 71 17 71 31V69C71 83 29 83 29 69Z"></path>
					<path d="M29 31C29 45 71 45 71 31"></path>
					<path d="M29 45C29 59 71 59 71 45"></path>
					<path d="M29 59C29 73 71 73 71 59"></path>
				</svg>

				<div class="cp-head">
					<svg class="cp-logo" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
						<circle cx="50" cy="50" r="46" fill="#000"></circle>
						<path d="M29 31C29 17 71 17 71 31V69C71 83 29 83 29 69Z" fill="#fff"></path>
						<g fill="none" stroke="#000" stroke-width="4" stroke-linecap="round">
							<path d="M29 31C29 45 71 45 71 31"></path>
							<path d="M29 45C29 59 71 59 71 45"></path>
							<path d="M29 59C29 73 71 73 71 59"></path>
						</g>
					</svg>
					<p class="cp-word">datafromzero</p>
					<p class="cp-tag">From A1 to AI</p>
				</div>

				<div class="cp-mid">
					<p class="cp-kicker">Roadmap completion</p>
					<p class="cp-records">datafromzero records that</p>
					<label class="cp-name">
						<span class="cp-sr">Your name</span>
						<input type="text" name="name" autocomplete="name" spellcheck="false" placeholder="Your name" />
					</label>
					<p class="cp-has">
						{
							COMPLETION_TRACKS.map((t) => (
								<span class={`cp-tn cp-t-${t.id}`}>
									completed the <strong>{t.name}</strong> roadmap, {t.summary}
								</span>
							))
						}
						<span class="cp-blank" aria-hidden="true">completed the <span class="cp-gap"></span> roadmap</span>
					</p>
				</div>

				<div class="cp-sign">
					<svg class="cp-seal" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
						<defs>
							<path id="cp-ring" d="M60,60 m-45.5,0 a45.5,45.5 0 1,1 91,0 a45.5,45.5 0 1,1 -91,0"></path>
						</defs>
						<circle class="cp-seal-bg" cx="60" cy="60" r="57"></circle>
						<circle class="cp-seal-a" cx="60" cy="60" r="57"></circle>
						<circle class="cp-seal-b" cx="60" cy="60" r="54.2"></circle>
						<circle class="cp-seal-b" cx="60" cy="60" r="38"></circle>
						<text class="cp-seal-t">
							<textPath href="#cp-ring" textLength="284" lengthAdjust="spacing">{RING}</textPath>
						</text>
						<g transform="translate(60 60) scale(0.58) translate(-50 -50)">
							<circle cx="50" cy="50" r="46" fill="#000"></circle>
							<path d="M29 31C29 17 71 17 71 31V69C71 83 29 83 29 69Z" fill="#fff"></path>
							<g fill="none" stroke="#000" stroke-width="4" stroke-linecap="round">
								<path d="M29 31C29 45 71 45 71 31"></path>
								<path d="M29 45C29 59 71 59 71 45"></path>
								<path d="M29 59C29 73 71 73 71 59"></path>
							</g>
						</g>
					</svg>

					<label class="cp-line">
						<input type="date" name="date" required />
						<span>Date</span>
					</label>
				</div>

				<div class="cp-foot">
					<p class="cp-not"><strong>{notFirst}</strong> {notRest}</p>
				</div>
			</div>
		</section>

		<section class="cp-att" aria-label="Page 2: attachments">
			<p class="cp-att-site">datafromzero · From A1 to AI</p>
			<h2>Attachments: the capstone's artifacts</h2>
			{
				COMPLETION_TRACKS.map((t) => (
					<div class={`cp-art cp-a-${t.id}`}>
						<p>
							Attach these to the printed sheet, from <a href={t.capstone.href}>{t.capstone.title}</a> ({t.capstone.code}), the things it asks you to{' '}
							<a href={`${t.capstone.href}${t.capstone.handIn}`}>hand in</a>:
						</p>
						<ul>
							{t.artifacts.map((a) => (
								<li>{a}</li>
							))}
						</ul>
					</div>
				))
			}
			<p class="cp-pick-first cp-screen">Pick a track above to see its artifacts here.</p>
			<label class="cp-field cp-att-link">
				<span>Project link</span>
				<input type="text" name="link" inputmode="url" autocomplete="off" spellcheck="false" placeholder="github.com/you/your-project" />
			</label>
			<p class="cp-url">datafromzero.github.io · content CC BY 4.0</p>
		</section>
	</div>
</StarlightPage>

<style is:global>
	.cp {
		max-width: 52rem;
	}
	.cp-pick {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 1rem 0 0;
		padding: 0.75rem 1rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.cp-pick legend {
		padding: 0 0.4rem;
		color: var(--mute);
		font-size: 0.875rem;
	}
	.cp-radio {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem; /* a touch target of 44 px */
		cursor: pointer;
	}
	.cp-radio input {
		width: 1.15rem;
		height: 1.15rem;
		accent-color: var(--fg);
	}
	.cp-note {
		margin: 0 0 1.25rem;
		padding: 0.1rem 0 0.1rem 1rem;
		border-inline-start: 3px solid var(--fg);
		color: var(--fg);
	}
	.cp-note p {
		margin: 0;
	}
	.cp-note .cp-by {
		margin-top: 0.35rem;
		color: var(--mute);
		font-size: 0.8125rem;
	}
	.cp-hint {
		margin: 0.5rem 0 0;
		color: var(--mute);
	}

	/* The two sheets are paper on screen in both themes: black text on white, one muted accent, as they print. */
	.cp-cert,
	.cp-att {
		--ink: #000;
		--ink-soft: #444;
		--accent: #1a1a1a; /* near black: the frame, the badge and the labels are black and gray, with nothing in color */
		--sans: var(--font-sans, 'Geist', ui-sans-serif, system-ui, sans-serif);
		--mono: var(--font-mono, 'Geist Mono', ui-monospace, monospace);
		margin-top: 1.25rem;
		background: #fff;
		color: var(--ink);
		border-radius: 6px;
	}
	.cp-cert a,
	.cp-att a {
		color: var(--ink);
	}
	.cp-cert {
		padding: 0.6rem;
	}
	.cp-frame {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 30rem;
		padding: 1.5rem 1.25rem 1.1rem;
		overflow: hidden;
		border: 2px solid var(--accent);
		/* A soft radial gradient from white to light gray. It prints as it is (print-color-adjust: exact); a printer that drops
		   backgrounds leaves the white sheet, and the frame, the badge and the text are black and gray either way. */
		background: radial-gradient(ellipse at 50% 38%, #fff 0%, #f6f6f6 45%, #e2e2e2 100%);
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
		text-align: center;
	}
	.cp-frame::before {
		content: '';
		position: absolute;
		inset: 5px;
		border: 1px solid var(--accent);
		pointer-events: none;
	}
	.cp-frame > *:not(.cp-mark) {
		position: relative;
	}
	/* The large line-art mark behind the text: a faint outline of the logo, clipped by the frame. */
	.cp-mark {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 20rem;
		height: 20rem;
		transform: translate(-50%, -50%);
		fill: none;
		stroke: #555;
		stroke-width: 0.7;
		stroke-linejoin: round;
		opacity: 0.16;
		pointer-events: none;
	}
	.cp-head {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cp-logo {
		width: 2.4rem;
		height: 2.4rem;
	}
	.cp-word {
		margin: 0.3rem 0 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		line-height: 1.2;
	}
	.cp-tag {
		margin: 0.1rem 0 0;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.cp-mid {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cp-kicker {
		margin: 0;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}
	.cp-records {
		margin: 0.9rem 0 0;
		font-family: var(--sans);
		font-size: 1.05rem;
	}
	.cp-name {
		display: block;
		width: 100%;
		margin-top: 0.4rem;
	}
	.cp-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.cp-name input,
	.cp-line input,
	.cp-field input {
		box-sizing: border-box;
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
	}
	.cp-name input {
		max-width: 36rem;
		min-height: 3.5rem;
		font-family: var(--sans);
		font-size: 2.4rem;
		font-weight: 400;
		line-height: 1.2;
		text-align: center;
	}
	.cp-name input::placeholder,
	.cp-line input::placeholder,
	.cp-field input::placeholder {
		color: #666;
		opacity: 1;
	}
	.cp-name input:focus-visible,
	.cp-line input:focus-visible,
	.cp-field input:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}
	.cp-has {
		margin: 0.9rem 0 0;
		max-width: 34rem;
		text-wrap: balance;
		font-family: var(--sans);
		font-size: 1.15rem;
		line-height: 1.45;
	}
	.cp-has strong {
		font-weight: 700;
	}
	.cp-sign {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}
	.cp-sign > .cp-line {
		width: 12rem;
	}
	.cp-seal {
		width: 7.5rem;
		height: 7.5rem;
	}
	.cp-seal circle {
		fill: none;
	}
	.cp-seal .cp-seal-bg {
		fill: #fff; /* hides the line art behind the badge */
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
	}
	.cp-seal-a {
		stroke: var(--accent);
		stroke-width: 1.4;
	}
	.cp-seal-b {
		stroke: var(--accent);
		stroke-width: 0.5;
	}
	.cp-seal-t {
		fill: var(--accent);
		font-family: var(--mono);
		font-size: 6.4px;
		font-weight: 600;
	}
	.cp-line {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.65rem;
		letter-spacing: 0.14em;
		text-align: center;
		text-transform: uppercase;
	}
	.cp-line input {
		min-height: 2rem;
		padding: 0.15rem 0.1rem;
		font-size: 0.95rem;
		letter-spacing: 0;
		text-align: center;
		text-transform: none;
	}
	.cp-foot {
		color: var(--ink-soft);
		font-size: 0.75rem;
		line-height: 1.45;
	}
	.cp-foot p {
		margin: 0;
	}

	.cp-att {
		padding: 1.5rem 1.5rem 1.25rem;
	}
	.cp-att-site {
		margin: 0;
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}
	.cp-att h2 {
		margin: 0.4rem 0 0.9rem;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1.45rem;
		font-weight: 600;
	}
	.cp-art {
		display: none;
	}
	.cp-art p {
		margin: 0 0 0.5rem;
	}
	.cp-art ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cp-art li {
		position: relative;
		margin: 0.35rem 0;
		padding-inline-start: 1.7rem;
	}
	.cp-art li::before {
		content: '';
		position: absolute;
		inset-inline-start: 0;
		top: 0.3em;
		width: 0.85em;
		height: 0.85em;
		border: 1.5px solid var(--ink);
		border-radius: 2px;
	}
	.cp-pick-first {
		margin: 0 0 1rem;
		color: var(--ink-soft);
	}
	.cp-field {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		color: var(--ink-soft);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}
	.cp-field input {
		min-height: 2.5rem;
		padding: 0.2rem 0.1rem;
		font-size: 1rem;
	}
	.cp-att-link {
		margin-top: 1.25rem;
		max-width: 36rem;
	}
	.cp-url {
		margin: 1rem 0 0;
		color: var(--ink-soft);
		font-size: 0.75rem;
	}

	/* The choice, with no script: the sentence of the checked track shows, and the blank one shows until a track is checked. */
	.cp-tn {
		display: none;
	}
	.cp-gap {
		display: inline-block;
		min-width: 7rem;
		border-bottom: 1px solid var(--ink);
	}
	.cp:has(.cp-radio input:checked) .cp-blank,
	.cp:has(.cp-radio input:checked) .cp-hint,
	.cp:has(.cp-radio input:checked) .cp-pick-first {
		display: none;
	}
	.cp:has(#cp-t-data-analyst:checked) .cp-t-data-analyst,
	.cp:has(#cp-t-data-engineer:checked) .cp-t-data-engineer,
	.cp:has(#cp-t-data-scientist:checked) .cp-t-data-scientist,
	.cp:has(#cp-t-ml-engineer:checked) .cp-t-ml-engineer {
		display: inline;
	}
	.cp:has(#cp-t-data-analyst:checked) .cp-a-data-analyst,
	.cp:has(#cp-t-data-engineer:checked) .cp-a-data-engineer,
	.cp:has(#cp-t-data-scientist:checked) .cp-a-data-scientist,
	.cp:has(#cp-t-ml-engineer:checked) .cp-a-ml-engineer {
		display: block;
	}

	@media (max-width: 40rem) {
		.cp-frame {
			padding: 1.25rem 0.9rem 1rem;
		}
		.cp-name input {
			font-size: 1.6rem;
		}
		.cp-sign {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.cp-sign > * {
			width: 100%;
		}
		.cp-seal {
			width: 7.5rem;
		}
		.cp-att {
			padding: 1.1rem;
		}
	}

	/* Print, two pages. Page 1 is landscape (a named page), in a certificate's style: a double rule, the mark and the
	   wordmark, the learner's name large in Geist (the site's own font, as are the Geist Mono labels), the track, a badge with
	   the ring of the name, the date and the unverified line. Page 2 is portrait: the artifacts and the project link. Black
	   and gray on a soft white-to-gray gradient, nothing in color; an empty field prints as a blank rule. The author's message
	   is shown on screen before the learner prints and is not printed. */
	@media print {
		@page cert {
			size: landscape;
			margin: 10mm !important;
		}
		@page attach {
			size: portrait;
			margin: 18mm !important;
		}
		:root:has(.cp) .cp-screen,
		:root:has(.cp) .cp-pick,
		:root:has(.cp) footer,
		:root:has(.cp) .tb-gap,
		:root:has(.cp) main h1,
		:root:has(.cp) #_top,
		:root:has(.cp) .content-panel:not(:has(.cp)),
		:root:has(.cp) nav.pagination-links {
			display: none !important;
		}
		:root:has(.cp) main,
		:root:has(.cp) .sl-markdown-content,
		:root:has(.cp) .content-panel {
			min-height: 0 !important;
			padding: 0 !important;
			margin: 0 !important;
		}
		.cp {
			max-width: none;
		}
		.cp input {
			outline: none !important;
			color: #000 !important;
		}
		.cp input::placeholder {
			color: transparent !important;
		}
		/* An empty date shows "mm/dd/yyyy" in the field; it prints as a blank rule (the field has no form, so required only marks it empty). */
		.cp input[type='date']:invalid {
			color: transparent !important;
		}
		.cp input::-webkit-calendar-picker-indicator {
			display: none;
		}
		.cp-cert,
		.cp-att {
			margin: 0 !important;
			border-radius: 0;
		}
		.cp-cert {
			page: cert;
			padding: 0;
			break-after: page;
			break-inside: avoid;
		}
		.cp-att {
			page: attach;
			padding: 0;
			break-inside: avoid;
		}
		/* 186 mm fits the A4 landscape page (190 mm high inside the margins), the shorter of A4 and Letter. */
		.cp-frame {
			height: 186mm;
			min-height: 0;
			gap: 0;
			padding: 9mm 20mm 8mm;
			border-width: 1.5pt;
			box-sizing: border-box;
		}
		.cp-frame::before {
			inset: 2.2mm;
			border-width: 0.5pt;
		}
		.cp-mark {
			width: 112mm;
			height: 112mm;
			stroke-width: 0.6;
		}
		.cp-logo {
			width: 11mm;
			height: 11mm;
		}
		.cp-word {
			margin-top: 1.5mm;
			font-size: 12pt;
		}
		.cp-tag {
			font-size: 6.5pt;
		}
		.cp-kicker {
			font-size: 8.5pt;
			letter-spacing: 0.34em;
		}
		.cp-records {
			margin-top: 6mm;
			font-size: 13pt;
		}
		.cp-name {
			margin-top: 2mm;
		}
		.cp-name input {
			max-width: 215mm;
			min-height: 20mm;
			border-bottom-width: 0.6pt;
			font-size: 40pt;
		}
		.cp-has {
			margin-top: 6mm;
			max-width: 225mm;
			font-size: 16pt;
			text-wrap: balance;
		}
		.cp-sign {
			gap: 2mm;
		}
		.cp-seal {
			width: 34mm;
			height: 34mm;
		}
		.cp-sign > .cp-line {
			width: 60mm;
		}
		.cp-line {
			font-size: 6.5pt;
		}
		.cp-line input {
			min-height: 8mm;
			border-bottom-width: 0.6pt;
			font-size: 11pt;
		}
		.cp-foot {
			margin-top: 5mm;
			font-size: 8pt;
		}
		.cp-att-site {
			font-size: 8pt;
		}
		.cp-att h2 {
			font-size: 20pt;
		}
		.cp-art {
