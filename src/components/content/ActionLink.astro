---
// Shared button-styled link for OpenInColab / OpenInSheets. Internal: not exported to authors.
interface Props {
	href: string;
}
const { href } = Astro.props;
---

<p class="action"><a class="button" href={href} rel="noopener"><slot /></a></p>

<style>
	.action {
		margin: 1rem 0;
	}
	.button {
		display: inline-block;
		padding: 0.5rem 1.25rem;
		border: 1px solid var(--fg);
		border-radius: var(--radius-pill);
		background: var(--fg);
		color: var(--bg);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
	}
	.button:hover {
		background: transparent;
		color: var(--fg);
	}
	/* Print: black text on paper with the address after it (print.css), not a filled pill. */
	@media print {
		.button {
			padding: 0;
			border: 0;
			background: none;
			color: #000;
		}
	}
	.button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
</style>
