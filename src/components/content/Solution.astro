---
// SPEC §6: hidden answer. Native <details>, so it works without JS and by keyboard.
// Placement inside <Exercise> is enforced at build time by src/lib/remark-content-rules.ts.
const t = Astro.locals.t;
---

<details class="solution">
	<summary>{t('component.showSolution')}</summary>
	<div class="solution-body"><slot /></div>
</details>

<style>
	.solution {
		margin: 1rem 0 0;
		border-top: 1px solid var(--line);
		padding-top: 0.75rem;
	}
	summary {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-pill);
		cursor: pointer;
		font-size: var(--sl-text-sm);
		color: var(--fg);
	}
	summary:hover {
		border-color: var(--fg);
	}
	summary:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.solution-body {
		margin-top: 0.75rem;
	}
	.solution-body > :global(:first-child) {
		margin-top: 0;
	}
	.solution-body > :global(:last-child) {
		margin-bottom: 0;
	}
</style>
