---
// SPEC §6: numbered exercise block. The id is permanent: `{lesson-id}-{n}`.
import { claimExerciseId, misuse, pageOf } from '../../lib/content-context.ts';

interface Props {
	id: string;
}
const { id } = Astro.props;
const { file, lesson } = pageOf(Astro.locals);
if (!lesson) misuse(file, 'Exercise', 'can only be used on lesson pages.');
const match = new RegExp(`^${lesson.id}-([1-9][0-9]*)$`).exec(String(id));
if (!match)
	misuse(file, 'Exercise', `id "${String(id)}" must be "${lesson.id}-{n}" (the lesson id, a hyphen and a number such as ${lesson.id}-1).`);
if (!claimExerciseId(Astro.locals, id))
	misuse(file, 'Exercise', `id "${id}" is used more than once on this page; every exercise id must be unique.`);
const t = Astro.locals.t;
const n = match[1];
---

<section class="exercise" id={id} aria-labelledby={`${id}-label`}>
	<p class="exercise-label" id={`${id}-label`}>
		<span>{t('component.exercise', { n })}</span>
		<code translate="no">{id}</code>
	</p>
	<div class="exercise-body"><slot /></div>
</section>

<style>
	.exercise {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
	}
	.exercise-label {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mute);
	}
	.exercise-label span {
		color: var(--fg);
	}
	.exercise-label code {
		padding: 0;
		background: none;
		font-size: inherit;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--mute);
	}
	.exercise-body > :global(:first-child) {
		margin-top: 0;
	}
	.exercise-body > :global(:last-child) {
		margin-bottom: 0;
	}
</style>
