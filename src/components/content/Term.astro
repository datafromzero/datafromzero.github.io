---
// SPEC §6: inline glossary link. The short definition is a popover. Where interest invokers exist
// (Chromium) hover or keyboard focus on the link opens it (`interestfor`); elsewhere (Safari, Firefox)
// a small "?" button opens it by tap or click (`popovertarget`). Both dismiss with Esc or an outside
// click. No JS. The definition is also linked with aria-describedby.
import { findGlossaryTerm, misuse, pageOf, uniqueId } from '../../lib/content-context.ts';

interface Props {
	id: string;
}
const { id } = Astro.props;
const { file, locale } = pageOf(Astro.locals);
const term = await findGlossaryTerm(String(id), locale);
if (!term) misuse(file, 'Term', `id "${String(id)}" is not a glossary term. Use the \`id\` from a file in src/content/docs/reference/glossary/.`);
// Unique per use, even when a term repeats on a page.
const t = Astro.locals.t;
const tip = uniqueId(Astro.locals, `tip-${id}`);
---

<a class="term" href={term.href} interestfor={tip} aria-describedby={tip}><slot /></a><button
	type="button"
	class="term-info"
	popovertarget={tip}
	aria-label={t('component.definition', { term: term.term })}><span aria-hidden="true">?</span></button
><span
	id={tip}
	popover="auto"
	role="tooltip">{term.short}</span
>

<style>
	.term {
		color: inherit;
		text-decoration: underline dotted;
		text-underline-offset: 0.2em;
	}
	.term:hover,
	.term:focus-visible {
		text-decoration-style: solid;
	}
	.term:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	/* Tap/click toggle for browsers without interest invokers. The 24 px target (WCAG 2.5.8) is built
	   from padding and cancelled by negative margins, so it does not change the line height. */
	.term-info {
		display: inline-block;
		box-sizing: border-box;
		width: 1.5rem;
		height: 1.5rem;
		margin: -0.5rem -0.3rem -0.5rem -0.2rem;
		padding: 0;
		text-align: center;
		border: 0;
		background: none;
		color: var(--dim);
		font: 500 0.7em/1.5rem var(--font-mono, ui-monospace, monospace);
		vertical-align: baseline;
		cursor: pointer;
	}
	.term-info:hover {
		color: var(--fg);
	}
	.term-info:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: -2px;
	}
	@supports selector(:interest-source) {
		.term-info {
			display: none;
		}
	}
	[popover] {
		/* Anchored below the link by the browser; no gap, so the pointer can move onto the tip. */
		position-area: block-end span-inline-end;
		position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
		margin: 0;
		width: max-content;
		max-width: min(18rem, calc(100vw - 2rem));
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
		background: var(--bg);
		color: var(--fg);
		font-size: var(--sl-text-sm);
		font-weight: 400;
		line-height: 1.4;
	}
</style>
