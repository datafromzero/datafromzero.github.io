---
// SPEC §6: inline glossary link. The short definition is a hint popover opened by hover or keyboard
// focus (`interestfor`), dismissible with Esc. No JS. Browsers without `interestfor` show a plain
// link: a closed popover stays hidden. The definition is also linked with aria-describedby.
import { findGlossaryTerm, misuse, pageOf, uniqueId } from '../../lib/content-context.ts';

interface Props {
	id: string;
}
const { id } = Astro.props;
const { file, locale } = pageOf(Astro.locals);
const term = await findGlossaryTerm(String(id), locale);
if (!term) misuse(file, 'Term', `id "${String(id)}" is not a glossary term. Use the \`id\` from a file in src/content/docs/reference/glossary/.`);
// Unique per use, even when a term repeats on a page.
const tip = uniqueId(Astro.locals, `tip-${id}`);
---

<a class="term" href={term.href} interestfor={tip} aria-describedby={tip}><slot /></a><span
	id={tip}
	popover="hint"
	role="tooltip">{term.short}</span
>

<style>
	.term {
		color: inherit;
		text-decoration: underline dotted;
		text-underline-offset: 0.2em;
	}
	.term:hover,
	.term:focus-visible {
		text-decoration-style: solid;
	}
	.term:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	[popover] {
		/* Anchored below the link by the browser; no gap, so the pointer can move onto the tip. */
		position-area: block-end span-inline-end;
		position-try-fallbacks: flip-inline, flip-block;
		margin: 0;
		max-width: min(18rem, calc(100vw - 2rem));
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
		background: var(--bg);
		color: var(--fg);
		font-size: var(--sl-text-sm);
		font-weight: 400;
		line-height: 1.4;
	}
</style>
