---
// SPEC §6: inline glossary link. The short definition appears on hover and keyboard focus using CSS
// only; without CSS this is a plain link. Screen readers get the definition via aria-description.
import { findGlossaryTerm, misuse, pageOf } from '../../lib/content-context.ts';

interface Props {
	id: string;
}
const { id } = Astro.props;
const { file, locale } = pageOf(Astro.locals);
const term = await findGlossaryTerm(String(id), locale);
if (!term) misuse(file, 'Term', `id "${String(id)}" is not a glossary term. Use the \`id\` from a file in src/content/docs/reference/glossary/.`);
---

<a class="term" href={term.href} data-short={term.short} aria-description={term.short}><slot /></a>

<style>
	/* The tip is positioned against the content column (not the link) so it can never push the page
	   wider than the viewport; it sits at the link's own line, just below it. */
	:global(.sl-markdown-content) {
		position: relative;
	}
	.term {
		color: inherit;
		text-decoration: underline dotted;
		text-underline-offset: 0.2em;
	}
	.term:hover,
	.term:focus-visible {
		text-decoration-style: solid;
	}
	.term:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.term::after {
		content: attr(data-short);
		display: none;
		position: absolute;
		z-index: 10;
		inset-inline: 0;
		width: max-content;
		max-width: min(18rem, 100%);
		margin-top: 1.7em;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
		background: var(--bg);
		color: var(--fg);
		font-size: var(--sl-text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-decoration: none;
		text-align: start;
	}
	.term:hover::after,
	.term:focus-visible::after {
		display: block;
	}
</style>
