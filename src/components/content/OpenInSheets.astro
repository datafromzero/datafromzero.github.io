---
// SPEC §6: "Make a copy" button built from the lesson's `sheet` field; a plain link without CSS.
import { misuse, pageOf } from '../../lib/content-context.ts';

import ActionLink from './ActionLink.astro';
const { file, lesson } = pageOf(Astro.locals);
if (!lesson?.sheet)
	misuse(file, 'OpenInSheets', 'needs a `sheet` field in this lesson\'s frontmatter (a Google Sheets /copy URL).');
const t = Astro.locals.t;
---

<ActionLink href={lesson.sheet}>{t('component.makeCopy')}</ActionLink>
