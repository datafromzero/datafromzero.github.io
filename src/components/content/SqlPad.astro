---
// SPEC D42: the markup of one SQL block, shared by <RunSQL> (a lesson) and the playground (/sql/playground/).
// Two separate boxes: the editor (with Run, Tables, Auto-run, resets) and the output. Without JavaScript the lesson
// block is the plain highlighted code and the playground says it needs JavaScript. The behavior lives in
// src/scripts/run-sql.ts (small, deferred) and sql-block.ts; the Tables panel is built here from the dataset's SQL file.
import { Code } from '@astrojs/starlight/components';
import { cafeSchema } from '../../lib/cafe-schema.ts';
import '../../styles/sql-runner.css';

interface Props {
	sql: string;
	/** `block` sits in a lesson; `page` fills the playground and shows the Tables panel as a side drawer. */
	variant?: 'block' | 'page';
	examples?: { label: string; sql: string }[];
}
const { sql, variant = 'block', examples = [] } = Astro.props;
const tables = cafeSchema();
---

<div class={`dfz-sql dfz-sql-${variant}`}>
	{variant === 'block' && <div class="dfz-sql-static"><Code code={sql} lang="sql" /></div>}
	<div class="dfz-sql-live not-content" data-pagefind-ignore>
		<div class="dfz-sql-grid">
			<section class="dfz-sql-box dfz-sql-ed" aria-label="SQL editor">
				<div class="dfz-sql-bar">
					<button type="button" class="dfz-sql-run" data-act="run">
						<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"></path></svg>
						Run
					</button>
					<button type="button" class="dfz-sql-tables-btn" data-act="tables" aria-expanded="false">Tables</button>
					<label class="dfz-sql-auto"><input type="checkbox" data-act="auto" /><span>Auto-run</span></label>
				</div>
				{
					examples.length > 0 && (
						<div class="dfz-sql-try">
							<span>Try:</span>
							{examples.map((x) => <button type="button" data-act="example" data-sql={x.sql}>{x.label}</button>)}
						</div>
					)
				}
				<div class="dfz-sql-tables" hidden>
					<div class="dfz-sql-tables-head">
						<p>The five tables you can query. Click a name to add <code translate="no">SELECT * FROM</code> that table to the editor, or Preview to see its first 5 rows.</p>
						<button type="button" class="dfz-sql-close" data-act="tables" aria-label="Close the tables list">Close</button>
					</div>
					<ul>
						{
							tables.map((t) => (
								<li data-t={t.name} data-cols={t.columns.map((c) => c.name).join(',')}>
									<div class="dfz-sql-trow">
										<button type="button" class="dfz-sql-tname" translate="no" data-act="table" data-t={t.name} aria-label={`${t.name}: add a query for this table to the editor`}>{t.name}</button>
										<span class="dfz-sql-count">{t.rows.toLocaleString('en-US')} rows</span>
										<button type="button" class="dfz-sql-prev" data-act="preview" data-t={t.name} aria-label={`Preview the first 5 rows of ${t.name}`}>Preview</button>
									</div>
									<ul class="dfz-sql-cols">
										{t.columns.map((c) => <li><code translate="no">{c.name}</code><span>{c.type.toLowerCase()}</span></li>)}
									</ul>
								</li>
							))
						}
					</ul>
				</div>
				<label class="dfz-sql-ta">
					<span class="dfz-sql-sr">SQL query, editable. Press Ctrl+Enter or Cmd+Enter to run it.</span>
					<textarea translate="no" spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" rows="5">{sql}</textarea>
				</label>
				<div class="dfz-sql-cm" translate="no"></div>
				<div class="dfz-sql-foot">
					<span class="dfz-sql-keys">Ctrl/Cmd+Enter runs the query.</span>
					<span class="dfz-sql-resets">
						<button type="button" class="dfz-sql-ghost" data-act="resetq">Reset query</button>
						<button type="button" class="dfz-sql-ghost" data-act="resetd">Reset data</button>
					</span>
				</div>
			</section>
			<section class="dfz-sql-box dfz-sql-res" aria-label="Output">
				<div class="dfz-sql-head" aria-hidden="true">Output</div>
				<div class="dfz-sql-status" hidden>
					<p>Getting ready…</p>
					<progress max="100" value="0" aria-label="Getting ready"></progress>
					<p class="dfz-sql-first" aria-live="polite"></p>
				</div>
				<div class="dfz-sql-out" aria-live="polite" translate="no">
					<p class="dfz-sql-empty" translate="yes">Your result appears here. Press Run or Ctrl/Cmd+Enter.</p>
				</div>
			</section>
		</div>
	</div>
	{variant === 'block' && <noscript><p class="dfz-sql-note">Turn on JavaScript to run this query on the page.</p></noscript>}
</div>

<script>
	import '../../scripts/run-sql';
</script>
