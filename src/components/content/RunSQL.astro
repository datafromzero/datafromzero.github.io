---
// SPEC §6 / D42: an SQL query the learner can edit and run on the page, against the five cafe-sales tables, in two
// boxes (editor, output). Without JavaScript this is the plain highlighted code block; with it the editor and the
// output appear. The editor and the engine load in the background after the page paints (src/scripts/run-sql.ts).
import { misuse, pageOf } from '../../lib/content-context.ts';
import SqlPad from './SqlPad.astro';

interface Props {
	/** The starting SQL. A blank starter is a comment such as `-- Write your query here`. */
	query: string;
}
const { query } = Astro.props;
const { file } = pageOf(Astro.locals);
if (typeof query !== 'string' || !query.trim())
	misuse(file, 'RunSQL', 'needs a non-empty `query` prop with the starting SQL, e.g. query={`SELECT 1;`}.');
const sql = query.replace(/^\n+|\s+$/g, '');
---

<SqlPad sql={sql} />
