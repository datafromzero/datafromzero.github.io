---
// SPEC §6 / D42: an SQL query the learner can edit and run on the page, against the five cafe-sales tables.
// Without JavaScript this is the plain highlighted code block; with it, a Run button appears. The engine
// (DuckDB-Wasm, self-hosted) loads on the first click, not before; see src/scripts/run-sql.ts.
import { Code } from '@astrojs/starlight/components';
import { misuse, pageOf } from '../../lib/content-context.ts';

interface Props {
	/** The starting SQL. A blank starter is a comment such as `-- Write your query here`. */
	query: string;
}
const { query } = Astro.props;
const { file } = pageOf(Astro.locals);
if (typeof query !== 'string' || !query.trim())
	misuse(file, 'RunSQL', 'needs a non-empty `query` prop with the starting SQL, e.g. query={`SELECT 1;`}.');
const sql = query.replace(/^\n+|\s+$/g, '');
---

<div class="dfz-sql">
	<div class="dfz-sql-static"><Code code={sql} lang="sql" /></div>
	<div class="dfz-sql-live not-content" data-pagefind-ignore>
		<label class="dfz-sql-label">
			<span class="dfz-sql-sr">SQL query, editable. Press Ctrl+Enter or Cmd+Enter to run it.</span>
			<textarea spellcheck="false" autocomplete="off" autocapitalize="off" wrap="off" rows="3">{sql}</textarea>
		</label>
		<div class="dfz-sql-bar">
			<button type="button" class="dfz-sql-run">Run</button>
			<button type="button">Reset query</button>
			<button type="button">Reset data</button>
			<span class="dfz-sql-keys">Ctrl+Enter, or Cmd+Enter on a Mac</span>
		</div>
		<div class="dfz-sql-out" aria-live="polite"></div>
	</div>
	<noscript><p class="dfz-sql-note">Turn on JavaScript to run this query on the page.</p></noscript>
</div>

<style is:global>
	.dfz-sql {
		margin: 1rem 0;
	}
	.dfz-sql-live {
		display: none;
	}
	.dfz-sql.on .dfz-sql-live {
		display: block;
	}
	.dfz-sql.on .dfz-sql-static {
		display: none;
	}
	.dfz-sql-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.dfz-sql-note {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--mute);
	}
	.dfz-sql textarea {
		display: block;
		box-sizing: border-box;
		width: 100%;
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
		background: var(--sl-color-gray-6);
		color: var(--fg);
		font: 400 0.8125rem / 1.6 var(--font-mono);
		tab-size: 2;
		resize: vertical;
		overflow-x: auto;
	}
	.dfz-sql textarea:focus-visible,
	.dfz-sql-scroll:focus-visible,
	.dfz-sql-bar button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.dfz-sql-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.dfz-sql-bar button {
		min-height: 44px;
		padding: 0 1.25rem;
		border: 1px solid var(--fg);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--fg);
		font: 500 var(--sl-text-sm) var(--font-sans, inherit);
		cursor: pointer;
	}
	.dfz-sql-bar .dfz-sql-run {
		background: var(--fg);
		color: var(--bg);
	}
	.dfz-sql-bar button:hover:not(:disabled) {
		background: var(--sl-color-gray-5);
		color: var(--fg);
	}
	.dfz-sql-bar button:disabled {
		opacity: 0.5;
		cursor: progress;
	}
	.dfz-sql-keys {
		font-size: var(--sl-text-xs);
		color: var(--mute);
	}
	.dfz-sql-out {
		margin-top: 0.5rem;
	}
	.dfz-sql-sum,
	.dfz-sql-more {
		margin: 0 0 0.5rem;
		font: 400 var(--sl-text-sm) var(--font-mono);
		color: var(--mute);
	}
	.dfz-sql-more {
		margin: 0.5rem 0 0;
	}
	.dfz-sql-err {
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--fg);
		border-radius: var(--radius-panel);
		font: 400 0.8125rem / 1.5 var(--font-mono);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.dfz-sql-scroll {
		max-height: 24rem;
		overflow: auto;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
	}
	.dfz-sql-scroll table {
		width: max-content;
		min-width: 100%;
		margin: 0;
		border-collapse: collapse;
		font: 400 0.8125rem / 1.4 var(--font-mono);
	}
	.dfz-sql-scroll th,
	.dfz-sql-scroll td {
		padding: 0.375rem 0.75rem;
		border: 0;
		border-bottom: 1px solid var(--dim);
		text-align: left;
		white-space: nowrap;
	}
	.dfz-sql-scroll thead th {
		position: sticky;
		top: 0;
		background: var(--sl-color-gray-6);
		color: var(--fg);
		font-weight: 500;
	}
	.dfz-sql-scroll tr:last-child td {
		border-bottom: 0;
	}
	.dfz-sql-scroll .n {
		text-align: right;
	}
	.dfz-sql-scroll .null {
		color: var(--mute);
		font-style: italic;
	}
	@media print {
		.dfz-sql.on .dfz-sql-live {
			display: none;
		}
		.dfz-sql.on .dfz-sql-static {
			display: block;
		}
	}
</style>

<script>
	import '../../scripts/run-sql';
</script>
