---
// SPEC §6/§7: button built from the lesson's `notebook` field; a plain link without CSS.
import { colabUrl, misuse, pageOf } from '../../lib/content-context.ts';

import ActionLink from './ActionLink.astro';
const { file, lesson } = pageOf(Astro.locals);
if (!lesson?.notebook)
	misuse(file, 'OpenInColab', 'needs a `notebook` field in this lesson\'s frontmatter (e.g. notebooks/sql/sql-joins.ipynb).');
const t = Astro.locals.t;
---

<ActionLink href={colabUrl(lesson.notebook)}>{t('component.openInColab')}</ActionLink>
