---
// Placeholder homepage shell shared by / and /vi/. The approved design
// (design/homepage-prototype/) replaces it in the homepage milestone.
// Always dark: it never reads or sets the docs theme.
import '@fontsource/geist/300.css';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/tokens.css';
import '../styles/print.css';
import markSvg from '../assets/logo/logo-inline-currentColor.svg?raw';
import { SITE_NAME } from '../site';

interface Props {
	lang: 'en' | 'vi';
	title: string;
	description: string;
	tagline: string;
	status: string;
	cta: string;
	href: string;
}
const { lang, title, description, tagline, status, cta, href } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body class="dfz-home">
		<main>
			<div class="lockup">
				<span class="dfz-mark" aria-hidden="true" set:html={markSvg} />
				<p class="name">{SITE_NAME}</p>
			</div>
			<h1>{tagline}</h1>
			<p class="dfz-label">{status}</p>
			<p><a class="button" href={href}>{cta}</a></p>
		</main>
	</body>
</html>

<style is:global>
	.dfz-home {
		margin: 0;
		min-height: 100svh;
		display: grid;
		place-content: center;
		padding: 0 16px;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-sans);
		font-weight: 400;
		line-height: 1.5;
		text-align: center;
		-webkit-font-smoothing: antialiased;
	}
	.dfz-home main {
		display: grid;
		justify-items: center;
		gap: 24px;
	}
	.dfz-home .lockup {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.dfz-home .dfz-mark {
		display: block;
		width: 40px;
		height: 40px;
		color: var(--fg);
	}
	.dfz-home .dfz-mark svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.dfz-home .name {
		margin: 0;
		font-weight: 500;
		font-size: 20px;
		letter-spacing: -0.01em;
	}
	.dfz-home h1 {
		margin: 0;
		font-size: clamp(2.5rem, 12vw, 5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}
	.dfz-home .dfz-label {
		margin: 0;
	}
	.dfz-home p {
		margin: 0;
	}
	.dfz-home .button {
		display: inline-block;
		padding: 12px 28px;
		border-radius: var(--radius-pill);
		background: var(--fg);
		color: var(--bg);
		font-weight: 500;
		text-decoration: none;
	}
	.dfz-home .button:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.dfz-home a:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
</style>
