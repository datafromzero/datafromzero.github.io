---
// One stage's lessons in study order: code, title, the codes they need first, and (when JavaScript runs) a "done" tick for
// each. Used by the map on /start/ and by the stage index pages (/excel/ and the others), so the list is written once
// (SPEC §3.1, D34, D64). The ticks are real checkboxes inside a label; they are hidden until src/scripts/progress.ts
// fills them from this browser's storage, so the list reads the same without JavaScript.
import { countText } from '../../lib/progress.ts';
import type { RoadmapStage } from '../../lib/roadmap.ts';

interface Props {
	stage: RoadmapStage;
	/** Stage pages: show each lesson's minutes and a line with the stage's done count above the list. */
	detail?: boolean;
}
const { stage, detail = false } = Astro.props;
const groups = [stage.lessons.filter((l) => !l.deepDive), stage.lessons.filter((l) => l.deepDive)];
---

{detail && <p class="prog mono" data-n data-t={countText(0, stage.lessons.length)} hidden>{countText(0, stage.lessons.length)}</p>}
{groups.map((group, gi) =>
	group.length === 0 ? null : (
		<>
			{gi === 1 && <p class="deep mono">{stage.deepDiveLabel}</p>}
			<ol class="lessons">
				{group.map((l) => (
					<li>
						<div class="row">
							<label class="dn" hidden>
								<input type="checkbox" data-done={l.id} />
								<span class="sr">Done: {l.code} {l.title}</span>
							</label>
							<div class="main">
								<a href={l.href}>
									<span class="code mono">{l.code}</span>
									<span class="title">{l.title}</span>
									{detail && l.duration !== undefined && <span class="min mono">{l.duration} min</span>}
								</a>
								{l.needs.length > 0 && <span class="needs mono">needs {l.needs.join(', ')}</span>}
							</div>
						</div>
					</li>
				))}
			</ol>
		</>
	),
)}

<style>
	.mono {
		font-family: var(--font-mono);
	}
	.lessons {
		margin: 10px 0 4px;
		padding: 0;
		list-style: none;
	}
	.lessons li {
		margin: 0;
		padding: 2px 0;
		border-bottom: 1px solid var(--line);
	}
	.row {
		display: flex;
		align-items: flex-start;
		gap: 4px;
	}
	.main {
		flex: 1;
		min-width: 0;
		padding: 6px 0;
	}
	.lessons a {
		display: flex;
		gap: 12px;
		align-items: baseline;
		color: var(--fg);
		text-decoration: none;
	}
	.lessons a:hover .title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.code {
		flex: 0 0 3.2em;
		font-size: 12px;
		color: var(--mute);
	}
	.title {
		flex: 1;
		min-width: 0;
	}
	.min {
		flex: none;
		font-size: 11px;
		color: var(--mute);
	}
	.needs {
		display: block;
		margin: 2px 0 0 calc(3.2em + 12px);
		font-size: 11px;
		color: var(--mute);
	}
	/* The tick: a 44 px target around a 20 px box (WCAG 2.2 target size), after the page script shows it. */
	.dn {
		position: relative;
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 36px;
		margin-left: -10px;
		cursor: pointer;
	}
	.dn[hidden] {
		display: none;
	}
	/* While scripting is enabled the tick's room is held but not drawn, so the script showing it moves nothing. Without it the
	   tick stays gone. (Not `:root[data-theme]` as the signal: Starlight writes it into the static HTML.) */
	@media (scripting: enabled) {
		.dn[hidden] {
			display: flex;
			visibility: hidden;
		}
		.prog[hidden] {
			display: block;
			visibility: hidden;
		}
	}
	.dn input {
		width: 20px;
		height: 20px;
		margin: 0;
		accent-color: var(--fg);
		cursor: pointer;
	}
	.dn input:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
	.row:has(input:checked) .title {
		color: var(--mute);
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.prog {
		margin: 14px 0 0;
		font-size: 12px;
		color: var(--mute);
		letter-spacing: 0.04em;
	}
	.deep {
		margin: 14px 0 0;
		padding-top: 10px;
		border-top: 1px dashed var(--mute);
		font-size: 11px;
		color: var(--mute);
		letter-spacing: 0.04em;
	}
	@media print {
		.dn {
			display: none;
		}
	}
</style>
