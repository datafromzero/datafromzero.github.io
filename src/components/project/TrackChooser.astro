---
// The skills chart on /choose-your-track/ (SPEC D49): a radar of the four careers on seven skills, an original
// inline SVG drawn at build time from src/data/track-skills.ts. No JavaScript. Every label is inside the figure; the
// same numbers are in a table below it and the way each score was derived is in a <details> list.
import { AXES, EVIDENCE, ROLES, SCALE, SCORES, type RoleId } from '../../data/track-skills.ts';
import { GITHUB_REPO } from '../../site';

// One small radar per role (owner request, 2026-11-20: four overlaid shapes were hard to read). Same scale on all four.
const W = 300;
const H = 290;
const CX = 150;
const CY = 158;
const R = 72; // radius of score 5
const N = AXES.length;
const angle = (i: number) => ((-90 + (i * 360) / N) * Math.PI) / 180;
const pt = (i: number, r: number): [number, number] => [CX + r * Math.cos(angle(i)), CY + r * Math.sin(angle(i))];
const f = (n: number) => String(Math.round(n * 10) / 10);
const poly = (role: RoleId) => AXES.map((a, i) => pt(i, (R * SCORES[role][a.id].score) / 5).map(f).join(',')).join(' ');
const rings = [1, 2, 3, 4, 5].map((s) => AXES.map((_, i) => pt(i, (R * s) / 5).map(f).join(',')).join(' '));

/** Where a two-line axis label goes: outside the spoke, anchored away from the chart. */
const labels = AXES.map((a, i) => {
	const [x, y] = pt(i, R + 10);
	const c = Math.cos(angle(i));
	const s = Math.sin(angle(i));
	const anchor = c > 0.25 ? 'start' : c < -0.25 ? 'end' : 'middle';
	const first = s < -0.9 ? y - 15 : s > 0.6 ? y + 3 : y - 2;
	return { a, x: Math.round(x), y1: Math.round(first), y2: Math.round(first + 11), anchor };
});
const top = (role: RoleId) =>
	AXES.filter((a) => SCORES[role][a.id].score === Math.max(...AXES.map((b) => SCORES[role][b.id].score)))
		.map((a) => a.name)
		.join(' · ');
const desc = (role: RoleId) =>
	`${ROLES.find((r) => r.id === role)!.name}: ` + AXES.map((a) => `${a.name} ${SCORES[role][a.id].score}`).join(', ') + '.';
const issue = (n: number) => `https://github.com/${GITHUB_REPO}/issues/${n}`;
---

<div class="tc not-content">
	<figure class="tc-fig">
		<div class="tc-grid">
			{
				ROLES.map((r) => (
					<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`tc-t-${r.id} tc-d-${r.id}`} class={`role ${r.id}`} xmlns="http://www.w3.org/2000/svg">
						<title id={`tc-t-${r.id}`}>{r.name}: skills scored 1 to 5</title>
						<desc id={`tc-d-${r.id}`}>{desc(r.id)}</desc>
						<text x="8" y="18" class="name">{r.name}</text>
						<text x="8" y="34" class="top">Strongest: {top(r.id)}</text>
						<g class="grid" fill="none">
							{rings.map((p, i) => <polygon points={p} class={i === 4 ? 'ring outer' : 'ring'} />)}
							{AXES.map((_, i) => <line x1={CX} y1={CY} x2={f(pt(i, R)[0])} y2={f(pt(i, R)[1])} />)}
						</g>
						<polygon points={poly(r.id)} class="area" />
						<g class="axis-labels">
							{labels.map((l) => (
								<text text-anchor={l.anchor}>
									<tspan x={l.x} y={l.y1}>{l.a.lines[0]}</tspan>
									<tspan x={l.x} y={l.y2}>{l.a.lines[1]}</tspan>
								</text>
							))}
						</g>
					</svg>
				))
			}
		</div>
		<figcaption>One chart per career, all on the same scale: rings mark scores 1 to 5, from the center out. Compare where each shape reaches.</figcaption>
	</figure>

	<h2 id="the-numbers">The same numbers in a table</h2>
	<div class="tc-table">
		<table>
			<caption>Score from 1 to 5 for each skill and role</caption>
			<thead>
				<tr>
					<th scope="col">Skill</th>
					{ROLES.map((r) => <th scope="col"><abbr title={r.name}>{r.short}</abbr></th>)}
				</tr>
			</thead>
			<tbody>
				{
					AXES.map((a) => (
						<tr>
							<th scope="row">{a.name}</th>
							{ROLES.map((r) => <td>{SCORES[r.id][a.id].score}</td>)}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<p class="tc-abbr">DA: Data Analyst. DE: Data Engineer. DS: Data Scientist. ML: ML / AI Engineer.</p>
	<ul class="tc-scale">
		{SCALE.map(([n, t]) => <li><span class="n">{n}</span> {t}</li>)}
	</ul>

	<h2 id="where-the-scores-come-from">Where the scores come from</h2>
	<p>
		Each score starts from the strongest direct evidence for that skill and role, and is then checked against the other sources. Where
		they disagree, the score takes the lower value. The sources:
	</p>
	<ul class="tc-ev">
		{
			EVIDENCE.map((e) => (
				<li>
					<span class="tag">[{e.tag}]</span>{' '}
					{e.issue !== null ? <a href={issue(e.issue)}>Research issue #{e.issue}</a> : <span>Curriculum map</span>}: {e.text}
				</li>
			))
		}
	</ul>
	<p>The reasons behind every cell are below. Open a skill to read them.</p>
	{
		AXES.map((a) => (
			<details class="tc-why">
				<summary>{a.name}</summary>
				<p class="about">{a.about}</p>
				<dl>
					{ROLES.map((r) => (
						<>
							<dt>
								{r.name}: {SCORES[r.id][a.id].score}
							</dt>
							<dd>{SCORES[r.id][a.id].why}</dd>
						</>
					))}
				</dl>
			</details>
		))
	}
</div>

<style>
	.tc {
		--tc-da: #0072b2;
		--tc-de: #00805f;
		--tc-ds: #c2338a;
		--tc-ml: #8a7300;
		margin-top: 8px;
	}
	:global(:root:not([data-theme='light'])) .tc {
		--tc-da: #4aa8e8;
		--tc-de: #2ec99d;
		--tc-ds: #f06ab5;
		--tc-ml: #d4b82a;
	}
	.tc a {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.tc a:focus-visible,
	.tc summary:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
	.tc-fig {
		margin: 0 0 24px;
	}
	.tc-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	@media (max-width: 30rem) {
		.tc-grid {
			grid-template-columns: 1fr;
		}
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--font-sans);
		font-size: 10px;
		fill: var(--fg);
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.name {
		font-size: 13px;
		font-weight: 600;
		fill: var(--c, var(--fg));
	}
	.top {
		font-size: 10px;
		fill: var(--sl-color-gray-3);
	}
	.grid line,
	.ring {
		stroke: var(--dim);
		stroke-width: 1;
	}
	.ring.outer {
		stroke: var(--mute);
	}
	.axis-labels text {
		fill: var(--fg);
	}
	.area {
		fill-opacity: 0.22;
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.da {
		--c: var(--tc-da);
	}
	.de {
		--c: var(--tc-de);
	}
	.ds {
		--c: var(--tc-ds);
	}
	.ml {
		--c: var(--tc-ml);
	}
	.role .area {
		fill: var(--c, var(--fg));
		stroke: var(--c, var(--fg));
	}
	figcaption {
		margin-top: 8px;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.tc-table {
		margin: 12px 0 0;
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
	}
	caption {
		margin-bottom: 8px;
		color: var(--sl-color-gray-3);
		font-family: var(--font-sans);
		font-size: var(--sl-text-sm);
		text-align: left;
	}
	th,
	td {
		padding: 8px 6px;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}
	td {
		text-align: center;
	}
	thead th {
		color: var(--sl-color-gray-3);
		font-weight: 500;
		text-align: center;
	}
	thead th:first-child {
		text-align: left;
	}
	abbr {
		text-decoration: none;
	}
	tbody th {
		color: var(--sl-color-white);
		font-weight: 500;
		font-family: var(--font-sans);
		font-size: var(--sl-text-sm);
	}
	.tc-abbr {
		margin: 8px 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.tc-scale {
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}
	.tc-scale li {
		margin: 2px 0;
	}
	.tc-scale .n,
	.tag {
		font-family: var(--font-mono);
		color: var(--sl-color-gray-3);
	}
	.tc-ev {
		padding-left: 1.2em;
	}
	.tc-why {
		margin: 8px 0;
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.tc-why summary {
		min-height: 44px;
		padding: 10px 14px;
		cursor: pointer;
		display: flex;
		align-items: center;
	}
	.tc-why[open] summary {
		border-bottom: 1px solid var(--line);
	}
	.tc-why .about,
	.tc-why dl {
		margin: 0;
		padding: 10px 14px 0;
		font-size: var(--sl-text-sm);
	}
	.tc-why .about {
		color: var(--sl-color-gray-3);
	}
	.tc-why dl {
		padding-bottom: 10px;
	}
	.tc-why dt {
		margin-top: 10px;
		font-weight: 600;
	}
	.tc-why dd {
		margin: 2px 0 0;
		color: var(--sl-color-gray-2);
	}
</style>
