---
// The comparison on /choose-your-track/ (SPEC D50), built at build time from src/data/track-skills.ts. No JavaScript.
// Grouped bars come first: they answer the page's main question ("which career needs the most of this skill?") best
// (research issue #87, section 6). The four small radars follow as each career's profile: one role per chart, one
// axis order, one scale, a light fill, and the numbers already printed in the bars above.
import {
	AXES,
	CHART_SOURCE,
	DEPTHS,
	EVIDENCE,
	MATH,
	MATH_SOURCES,
	MATH_TOPICS,
	ROLES,
	SCALE,
	SCORES,
	WARNINGS,
	type RoleId,
} from '../../data/track-skills.ts';

const W = 320;
const H = 282;
const CX = 160;
const CY = 172;
const R = 66; // radius of score 5
const N = AXES.length;
const angle = (i: number) => ((-90 + (i * 360) / N) * Math.PI) / 180;
const pt = (i: number, r: number): [number, number] => [CX + r * Math.cos(angle(i)), CY + r * Math.sin(angle(i))];
const f = (n: number) => String(Math.round(n * 10) / 10);
const poly = (role: RoleId) => AXES.map((a, i) => pt(i, (R * SCORES[role][a.id].score) / 5).map(f).join(',')).join(' ');
const rings = [1, 2, 3, 4, 5].map((s) => AXES.map((_, i) => pt(i, (R * s) / 5).map(f).join(',')).join(' '));

/** Where a two-line axis label goes: outside the spoke, anchored away from the chart. */
const labels = AXES.map((a, i) => {
	const [x, y] = pt(i, R + 10);
	const c = Math.cos(angle(i));
	const s = Math.sin(angle(i));
	const anchor = c > 0.25 ? 'start' : c < -0.25 ? 'end' : 'middle';
	const first = s < -0.9 ? y - 15 : s > 0.6 ? y + 3 : y - 2;
	return { a, x: Math.round(x), y1: Math.round(first), y2: Math.round(first + 11), anchor };
});
const top = (role: RoleId) => {
	const best = Math.max(...AXES.map((b) => SCORES[role][b.id].score));
	return AXES.filter((a) => SCORES[role][a.id].score === best).map((a) => a.name);
};
const roleName = (role: RoleId) => ROLES.find((r) => r.id === role)!.name;
const desc = (role: RoleId) => `${roleName(role)}: ` + AXES.map((a) => `${a.name} ${SCORES[role][a.id].score}`).join(', ') + '.';
const level = (d: string) => (d === 'Fluency' ? 'd2' : d === 'Intuition' ? 'd1' : 'd0');
const confidence = { high: 'High confidence', medium: 'Medium confidence', low: 'Low confidence' } as const;
---

<div class="tc not-content">
	<h2 id="compare-the-skills">Compare one skill across the four careers</h2>
	<p class="tc-lead">Each bar is a score from 1 to 5. A longer bar means a bigger part of the job at the start.</p>
	<ul class="tc-scale">
		{SCALE.map(([n, t]) => <li><span class="n">{n}</span> {t}</li>)}
	</ul>
	<div class="tc-bars">
		{
			AXES.map((a) => (
				<table>
					<caption>{a.name}</caption>
					<thead class="tc-vh">
						<tr>
							<th scope="col">Career</th>
							<th scope="col">Score from 1 to 5</th>
						</tr>
					</thead>
					<tbody>
						{ROLES.map((r) => (
							<tr class={r.id}>
								<th scope="row">
									<abbr title={r.name}>{r.short}</abbr>
								</th>
								<td>
									<div class="cell">
										<span class="track" aria-hidden="true">
											<span class={`bar s${SCORES[r.id][a.id].score}`} />
										</span>
										<span class="v">{SCORES[r.id][a.id].score}</span>
									</div>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			))
		}
	</div>
	<p class="tc-abbr">DA: Data Analyst. DE: Data Engineer. DS: Data Scientist. ML: ML / AI Engineer.</p>

	<h2 id="each-careers-shape">Each career's shape</h2>
	<figure class="tc-fig">
		<div class="tc-grid">
			{
				ROLES.map((r) => (
					<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`tc-t-${r.id} tc-d-${r.id}`} class={`role ${r.id}`} xmlns="http://www.w3.org/2000/svg">
						<title id={`tc-t-${r.id}`}>{r.name}: skills scored 1 to 5</title>
						<desc id={`tc-d-${r.id}`}>{desc(r.id)}</desc>
						<text x="8" y="18" class="name">{r.name}</text>
						<text class="top">
							{top(r.id).map((name, i) => (
								<tspan x="8" y={34 + 12 * i}>{i === 0 ? `Strongest: ${name}` : `and ${name}`}</tspan>
							))}
						</text>
						<g class="grid" fill="none">
							{rings.map((p, i) => <polygon points={p} class={i === 4 ? 'ring outer' : 'ring'} />)}
							{AXES.map((_, i) => <line x1={CX} y1={CY} x2={f(pt(i, R)[0])} y2={f(pt(i, R)[1])} />)}
						</g>
						<polygon points={poly(r.id)} class="area" />
						<g class="axis-labels">
							{labels.map((l) => (
								<text text-anchor={l.anchor}>
									<tspan x={l.x} y={l.y1}>{l.a.lines[0]}</tspan>
									<tspan x={l.x} y={l.y2}>{l.a.lines[1]}</tspan>
								</text>
							))}
						</g>
					</svg>
				))
			}
		</div>
		<figcaption>
			One chart per career, all on the same scale: rings mark scores 1 to 5, from the center out. A bigger shape is not a better career, and its size
			changes with the order of the skills, so compare where each shape reaches. Studies of this kind of chart find bars easier to read, which is why the
			bars come first (<a href={CHART_SOURCE.href}>{CHART_SOURCE.label}</a>).
		</figcaption>
	</figure>

	<h2 id="how-much-math">How much mathematics each track needs</h2>
	<p>
		Every track is a step up in knowledge and judgment, like a master's degree. The mathematics is not the same for all four. What a first job asks for:
	</p>
	<div class="tc-math">
		<table>
			<caption>Depth of each mathematics topic at the start of the job</caption>
			<thead>
				<tr>
					<th scope="col">Career</th>
					{MATH_TOPICS.map((t) => <th scope="col">{t}</th>)}
				</tr>
			</thead>
			<tbody>
				{
					ROLES.map((r) => (
						<tr>
							<th scope="row">{r.name}</th>
							{MATH[r.id].depth.map((d) => (
								<td class={level(d)}>{d}</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	<ul class="tc-depths">
		{DEPTHS.map(([d, t]) => <li><strong>{d}:</strong> {t}.</li>)}
	</ul>
	<ul class="tc-msgs">
		{ROLES.map((r) => <li><strong>{r.name}.</strong> {MATH[r.id].message}</li>)}
	</ul>
	<p class="tc-src">
		Sources:{' '}
		{
			MATH_SOURCES.map((s, i) => (
				<>
					<a href={s.href}>{s.label}</a>
					{i < MATH_SOURCES.length - 1 ? ' · ' : '.'}
				</>
			))
		}
	</p>

	<h2 id="what-people-misjudge">What people switching careers often get wrong</h2>
	<ul class="tc-warn">
		{
			WARNINGS.map((w) => (
				<li>
					<strong>{w.role === 'all' ? 'Every career' : roleName(w.role)}: "{w.belief}"</strong> {w.reality} <span class="src">(<a href={w.href}>{w.source}</a>)</span>
				</li>
			))
		}
	</ul>

	<h2 id="where-the-scores-come-from">Where the scores come from</h2>
	<p>
		Each score starts from the strongest direct evidence for that skill and role and is checked against the other sources. In the reasons, a count
		such as 9 of 10 is the number of postings in our sample that name the skill. The sources:
	</p>
	<ul class="tc-ev">
		{
			EVIDENCE.map((e) => (
				<li>
					<span class="tag">[{e.tag}]</span> {e.text}{' '}
					{e.links.map((l, i) => (
						<>
							<a href={l.href}>{l.label}</a>
							{i < e.links.length - 1 ? ' · ' : ''}
						</>
					))}
				</li>
			))
		}
	</ul>
	<p>Open a skill to read the reasons behind every score.</p>
	{
		AXES.map((a) => (
			<details class="tc-why">
				<summary>
					{a.name} <span class="conf">{confidence[a.confidence]}</span>
				</summary>
				<p class="about">{a.about}</p>
				<dl>
					{ROLES.map((r) => (
						<>
							<dt>
								{r.name}: {SCORES[r.id][a.id].score}
							</dt>
							<dd>{SCORES[r.id][a.id].why}</dd>
						</>
					))}
				</dl>
			</details>
		))
	}
</div>

<style>
	.tc {
		--tc-da: #0072b2;
		--tc-de: #00805f;
		--tc-ds: #c2338a;
		--tc-ml: #8a7300;
		margin-top: 8px;
	}
	:global(:root:not([data-theme='light'])) .tc {
		--tc-da: #4aa8e8;
		--tc-de: #2ec99d;
		--tc-ds: #f06ab5;
		--tc-ml: #d4b82a;
	}
	.tc h2 {
		margin: 36px 0 12px;
	}
	.tc h2:first-child {
		margin-top: 8px;
	}
	.tc a {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.tc a:focus-visible,
	.tc summary:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
	.tc-lead,
	.tc-abbr,
	.tc-src,
	figcaption {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.tc-vh {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.da {
		--c: var(--tc-da);
	}
	.de {
		--c: var(--tc-de);
	}
	.ds {
		--c: var(--tc-ds);
	}
	.ml {
		--c: var(--tc-ml);
	}

	/* Grouped bars: one small table per skill. */
	.tc-bars {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px 28px;
		margin-top: 16px;
	}
	@media (max-width: 40rem) {
		.tc-bars {
			grid-template-columns: 1fr;
		}
	}
	.tc-bars table {
		width: 100%;
		border-collapse: collapse;
	}
	.tc-bars caption {
		margin-bottom: 6px;
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-sm);
		text-align: left;
	}
	.tc-bars th[scope='row'] {
		width: 2.6em;
		padding: 2px 8px 2px 0;
		color: var(--c);
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		text-align: left;
	}
	.tc-bars abbr {
		text-decoration: none;
	}
	.tc-bars td {
		padding: 2px 0;
	}
	.cell {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.track {
		flex: 1;
		height: 12px;
		/* faint marks at 1 to 5 */
		background: repeating-linear-gradient(to right, transparent 0 calc(20% - 1px), var(--line) calc(20% - 1px) 20%);
		border-left: 1px solid var(--mute);
	}
	.bar {
		display: block;
		height: 100%;
		background: var(--c);
	}
	.s1 {
		width: 20%;
	}
	.s2 {
		width: 40%;
	}
	.s3 {
		width: 60%;
	}
	.s4 {
		width: 80%;
	}
	.s5 {
		width: 100%;
	}
	.v {
		width: 1ch;
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
	}
	.tc-scale {
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}
	.tc-scale li {
		margin: 2px 0;
	}
	.tc-scale .n,
	.tag {
		font-family: var(--font-mono);
		color: var(--sl-color-gray-3);
	}

	/* Four radars */
	.tc-fig {
		margin: 0;
	}
	.tc-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	@media (max-width: 30rem) {
		.tc-grid {
			grid-template-columns: 1fr;
		}
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--font-sans);
		font-size: 10px;
		fill: var(--fg);
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.name {
		font-size: 13px;
		font-weight: 600;
		fill: var(--c, var(--fg));
	}
	.top {
		font-size: 10px;
		fill: var(--sl-color-gray-3);
	}
	.grid line,
	.ring {
		stroke: var(--dim);
		stroke-width: 1;
	}
	.ring.outer {
		stroke: var(--mute);
	}
	.axis-labels text {
		fill: var(--fg);
	}
	.area {
		fill: var(--c, var(--fg));
		fill-opacity: 0.14;
		stroke: var(--c, var(--fg));
		stroke-width: 2;
		stroke-linejoin: round;
	}
	figcaption {
		margin-top: 8px;
	}

	/* Mathematics */
	.tc-math {
		overflow-x: auto;
	}
	.tc-math table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	.tc-math caption {
		margin-bottom: 8px;
		color: var(--sl-color-gray-3);
		text-align: left;
	}
	.tc-math th,
	.tc-math td {
		padding: 8px 6px;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}
	.tc-math thead th {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	.tc-math tbody th {
		color: var(--sl-color-white);
		font-weight: 500;
		white-space: nowrap;
	}
	.tc-math .d0 {
		color: var(--sl-color-gray-3);
	}
	.tc-math .d2 {
		font-weight: 600;
	}
	.tc-depths,
	.tc-msgs,
	.tc-warn,
	.tc-ev {
		padding-left: 1.2em;
		font-size: var(--sl-text-sm);
	}
	.tc-depths {
		color: var(--sl-color-gray-3);
	}
	.tc-msgs li,
	.tc-warn li {
		margin: 6px 0;
	}
	.src {
		color: var(--sl-color-gray-3);
	}

	/* Reasons */
	.tc-why {
		margin: 8px 0;
		border: 1px solid var(--line);
		border-radius: 6px;
	}
	.tc-why summary {
		min-height: 44px;
		padding: 10px 14px;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.conf {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.tc-why[open] summary {
		border-bottom: 1px solid var(--line);
	}
	.tc-why .about,
	.tc-why dl {
		margin: 0;
		padding: 10px 14px 0;
		font-size: var(--sl-text-sm);
	}
	.tc-why .about {
		color: var(--sl-color-gray-3);
	}
	.tc-why dl {
		padding-bottom: 10px;
	}
	.tc-why dt {
		margin-top: 10px;
		font-weight: 600;
	}
	.tc-why dd {
		margin: 2px 0 0;
		color: var(--sl-color-gray-2);
	}
</style>
