---
// The roadmap on /start/ (SPEC §3.1): the stages as a short vertical rail. A stage with published lessons is a
// native <details>: closed, it shows only its number, name and lesson count; open, it lists its lessons with their
// codes (E1, E2 …) and the codes they need first. Plain HTML and CSS; works without JS. With JS a small script adds the
// "done" ticks, the per-stage count and "Clear my progress" (SPEC D64, src/scripts/progress.ts).
import { CHEATSHEETS, type RoadmapStage } from '../../lib/roadmap.ts';
import { loadRoadmap } from '../../lib/roadmap-data.ts';
import LessonList from './LessonList.astro';
import ProgressClear from './ProgressClear.astro';

const stages = await loadRoadmap();
const core = stages.filter((s) => !s.branch);
const branches = stages.filter((s) => s.branch);
const summary = (n: number) => (n === 0 ? 'Coming soon' : `${n} ${n === 1 ? 'lesson' : 'lessons'}`);
const groups: [string | null, RoadmapStage[]][] = [
	[null, core],
	['Then choose a branch', branches],
];
---

<div class="roadmap not-content">
	{groups.map(([label, list]) => (
		<>
			{label && <p class="fork mono">{label}</p>}
			{label && <p class="choose">Not sure which one? <a href="/choose-your-track/">Choose your track</a>: compare the four careers on eight skills.</p>}
			<ol class:list={['rail', { branch: label !== null }]}>
				{list.map((s) => {
					const head = (
						<>
							<span class="num mono">{s.number}</span>
							<span class="name">{s.title}</span>
							<span class="count mono" data-n data-t={summary(s.lessons.length)}>{summary(s.lessons.length)}</span>
						</>
					);
					return (
						<li class="node">
							{s.lessons.length === 0 ? (
								<div class="card">{head}</div>
							) : (
								<details data-stage={s.id}>
									<summary class="card">
										{head}
										<span class="arrow" aria-hidden="true" />
									</summary>
									<LessonList stage={s} />
									{s.href && <a class="overview" href={s.href}>{s.title} overview →</a>}
									{CHEATSHEETS[s.id] && <a class="overview" href={CHEATSHEETS[s.id].href}>{CHEATSHEETS[s.id].label}: the one-page cheatsheet →</a>}
								</details>
							)}
						</li>
					);
				})}
			</ol>
		</>
	))}
	<ProgressClear />
</div>

<style>
	.roadmap {
		margin: 24px 0;
		max-width: 560px;
	}
	.mono {
		font-family: var(--font-mono);
	}
	.rail {
		position: relative;
		margin: 0;
		padding: 0 0 0 28px;
		list-style: none;
	}
	/* The rail: one line down the left, a ring at each stage. */
	.rail::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 8px;
		border-left: 1px solid var(--mute);
	}
	.rail.branch {
		margin-left: 28px;
	}
	.node {
		position: relative;
		margin: 0 0 14px;
	}
	.node::before {
		content: '';
		position: absolute;
		top: 26px;
		left: -25px;
		width: 9px;
		height: 9px;
		border: 1.5px solid var(--fg);
		border-radius: 50%;
		background: var(--bg);
	}
	.card {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas: 'num count' 'name count';
		align-items: center;
		gap: 2px 12px;
		padding: 14px 16px;
		border: 1px solid var(--mute);
		border-radius: 6px;
		background: var(--bg);
		list-style: none;
	}
	summary.card {
		grid-template-columns: 1fr auto auto;
		grid-template-areas: 'num count arrow' 'name count arrow';
		cursor: pointer;
	}
	summary.card::-webkit-details-marker {
		display: none;
	}
	summary.card:hover,
	details[open] > summary.card {
		border-color: var(--fg);
	}
	summary.card:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.num {
		grid-area: num;
		font-size: 11px;
		color: var(--mute);
		letter-spacing: 0.08em;
	}
	.name {
		grid-area: name;
		font-size: 20px;
		letter-spacing: -0.02em;
		color: var(--fg);
	}
	.count {
		grid-area: count;
		font-size: 11px;
		color: var(--mute);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.arrow {
		grid-area: arrow;
		width: 9px;
		height: 9px;
		border-right: 1.5px solid var(--fg);
		border-bottom: 1.5px solid var(--fg);
		transform: rotate(45deg) translateY(-3px);
		transition: transform 0.15s ease;
	}
	details[open] .arrow {
		transform: rotate(225deg) translateY(-3px);
	}
	.overview {
		display: block;
		width: fit-content;
		margin: 8px 0 4px;
		color: var(--fg);
	}
	.fork {
		margin: 4px 0 12px 28px;
		font-size: 11px;
		color: var(--mute);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.choose {
		margin: 0 0 14px 28px;
		font-size: var(--sl-text-sm);
	}
	.choose a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}
	@media (prefers-reduced-motion: reduce) {
		.arrow {
			transition: none;
		}
	}
</style>
