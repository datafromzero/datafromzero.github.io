---
// Control that reopens the consent banner; it lives only on /privacy/ (owner, 2026-11-24). Renders nothing while analytics is off (SPEC §11).
import { ANALYTICS_ENABLED } from '../../site';
import { siteUi } from '../../i18n/site-ui';

interface Props {
	lang?: string;
	class?: string;
}
const { lang = 'en', class: cls } = Astro.props;
---

{ANALYTICS_ENABLED && <button type="button" class:list={['cookie-settings', cls]} data-consent-open>{siteUi(lang).nav.cookies}</button>}

<style>
	button {
		all: unset;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	button:hover {
		color: var(--fg);
	}
	/* On /privacy/ it is a plain bordered button, not a link. */
	.consent-button {
		display: inline-block;
		padding: 0.6rem 1.1rem;
		min-height: 44px;
		margin-top: 0.5rem;
		box-sizing: border-box;
		border: 1px solid currentColor;
		border-radius: 8px;
		text-decoration: none;
		color: var(--sl-color-white, var(--fg));
	}
	.consent-button:hover {
		background: var(--sl-color-gray-6, transparent);
	}
	button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
</style>
