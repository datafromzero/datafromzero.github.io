---
// Footer control that reopens the consent banner. Renders nothing while analytics is off (SPEC §11).
import { ANALYTICS_ENABLED } from '../../site';
import { siteUi } from '../../i18n/site-ui';

interface Props {
	lang?: string;
	class?: string;
}
const { lang = 'en', class: cls } = Astro.props;
---

{ANALYTICS_ENABLED && <button type="button" class:list={['cookie-settings', cls]} data-consent-open>{siteUi(lang).nav.cookies}</button>}

<style>
	button {
		all: unset;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	button:hover {
		color: var(--fg);
	}
	button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
</style>
