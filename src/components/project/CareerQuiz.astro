---
// The career quiz on /career-quiz/ (SPEC D33), built from the research in GitHub issue #32 (all copy in
// src/lib/career-quiz.ts). A real <form>: one fieldset and legend per question, labeled radio buttons (44px
// targets), visible focus. Without script every question is shown and "How to score it yourself" prints the rule,
// the tie-break and every answer's points, so the page works on paper too. The one script (scripts/career-quiz.ts,
// owner-approved exception, under 4 KB gzipped, no library) scores on submit, shows the result in a polite live
// region and moves focus to its heading. Nothing is stored and nothing is sent.
import { CAREERS } from '../../lib/career-quiz-score.ts';
import {
	CAREER_NAMES,
	DISCLAIMER,
	MINI_IP_URL,
	ONET_CREDIT,
	QUESTIONS,
	REASON_THEMES,
	RESULT_COPY,
	RULE,
	SHARED_CORE,
	TIE_RULE,
	encodeWeights,
} from '../../lib/career-quiz.ts';
import { projectHref } from '../../i18n/site-ui';

interface Props {
	lang?: string;
}
const start = projectHref(Astro.props.lang, 'start');
const LETTERS = ['A', 'B', 'C', 'D'];
/** What the script needs to write the result (the rest of the result is static HTML below). */
const copy = {
	names: CAREER_NAMES,
	why: RESULT_COPY,
	themes: REASON_THEMES,
	heading: 'Your suggested direction: ',
	headingTie: 'Your suggested directions: ',
	and: ' and ',
	because: 'Because your answers kept choosing {}.',
	second: 'Close second: {} — worth a look too.',
};
/** "DE2 DA1" → ["DE 2", "DA 1"]: one line per career in the points table, so it fits a phone. */
const points = (code: string) => code.split(' ').map((p) => p.replace(/^([A-Z]{2})/, '$1 '));
---

<div class="cq not-content">
	<section class="cq-start" aria-label="About this quiz">
		<p class="cq-lead">{DISCLAIMER}</p>
		<p>
			Ten questions about how you like to work. Pick the answer that sounds most like you; there are no right or wrong answers.
			Nothing is saved, sent or tracked: your answers never leave this page.
		</p>
		<p>
			Want a validated instrument instead? Try the free <a href={MINI_IP_URL} rel="noopener">Mini Interest Profiler on My Next Move</a>.
		</p>
	</section>

	<form class="cq-form" id="cq-form" data-copy={JSON.stringify(copy)}>
		{
			QUESTIONS.map((q, i) => (
				<fieldset class="cq-q">
					<legend>
						<span class="cq-n">{i + 1}.</span> {q.text}
					</legend>
					<div class="cq-opts">
						{q.options.map((o, j) => (
							<label class="cq-opt">
								<input type="radio" name={`q${i + 1}`} value={LETTERS[j]} data-w={encodeWeights(o.weights)} required={j === 0} />
								<span class="cq-letter" aria-hidden="true">
									{LETTERS[j]}
								</span>
								<span>{o.text}</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}
		<p class="cq-actions" hidden>
			<button class="cq-btn solid" type="submit">See my suggestion</button>
		</p>
	</form>

	<div class="cq-live" aria-live="polite">
		<section class="cq-result" hidden aria-labelledby="cq-result-h">
			<h2 id="cq-result-h" tabindex="-1">Your suggested direction</h2>
			<p class="cq-why"></p>
			<p class="cq-because"></p>
			<p class="cq-second"></p>
			<p>{SHARED_CORE}</p>
			<p class="cq-row">
				<a class="cq-btn solid" href={start}>Start at A1 <span aria-hidden="true">→</span></a>
				<button class="cq-btn ghost cq-reset" type="button">Start over</button>
			</p>
		</section>
	</div>

	<section class="cq-self" aria-labelledby="how-to-score-it-yourself">
		<h2 id="how-to-score-it-yourself">How to score it yourself</h2>
		<p>{RULE}</p>
		<p>{TIE_RULE}</p>
		<p>
			{CAREERS.map((c, i) => (
				<>
					{i > 0 && ', '}
					<abbr title={CAREER_NAMES[c]}>{c}</abbr> = {CAREER_NAMES[c]}
				</>
			))}
			.
		</p>
		<div class="cq-table">
			<table>
				<caption>Points for each answer</caption>
				<thead>
					<tr>
						<th scope="col">Question</th>
						{LETTERS.map((l) => <th scope="col">{l}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						QUESTIONS.map((q, i) => (
							<tr>
								<th scope="row">{i + 1}</th>
								{q.options.map((o) => (
									<td>
										{points(encodeWeights(o.weights)).map((p, k) => (
											<>
												{k > 0 && <br />}
												{p}
											</>
										))}
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<h3 id="what-each-direction-means">What each direction means</h3>
		<ul>
			{CAREERS.map((c) => <li>{RESULT_COPY[c]}</li>)}
		</ul>
		<p>{SHARED_CORE}</p>
	</section>

	<p class="cq-credit">
		{ONET_CREDIT.before}<a href={ONET_CREDIT.licenseUrl} rel="license noopener">{ONET_CREDIT.license}</a>{ONET_CREDIT.after}
	</p>
</div>

<script>
	import '../../scripts/career-quiz';
</script>

<style>
	.cq {
		margin-top: 8px;
	}
	.cq p {
		margin: 0 0 1em;
	}
	.cq a {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.cq :is(a, button, input):focus-visible {
		outline: 2px solid var(--sl-color-white);
		outline-offset: 2px;
	}
	.cq-lead {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.cq-start {
		padding-bottom: 8px;
		color: var(--sl-color-gray-2);
	}

	.cq-q {
		margin: 32px 0 0;
		padding: 0;
		border: 0;
	}
	.cq-q legend {
		margin-bottom: 12px;
		padding: 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 500;
		line-height: 1.35;
	}
	.cq-n {
		color: var(--sl-color-gray-3);
		font-family: var(--font-mono);
		font-weight: 400;
	}
	.cq-opts {
		display: grid;
		gap: 8px;
	}
	.cq-opt {
		display: grid;
		grid-template-columns: auto auto 1fr;
		gap: 10px;
		align-items: center;
		min-height: 44px;
		padding: 10px 14px;
		border: 1px solid var(--dim);
		border-radius: var(--radius-panel);
		color: var(--sl-color-gray-2);
		line-height: 1.4;
		cursor: pointer;
		transition: border-color 0.2s;
	}
	.cq-opt:hover {
		border-color: var(--sl-color-gray-3);
	}
	.cq-opt:has(input:checked) {
		border-color: var(--sl-color-white);
		color: var(--sl-color-white);
	}
	.cq-opt:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-white);
		outline-offset: 2px;
	}
	.cq .cq-opt input:focus-visible {
		outline: none;
	}
	.cq-opt input {
		width: 18px;
		height: 18px;
		margin: 0;
		accent-color: var(--sl-color-white);
	}
	.cq-letter {
		color: var(--sl-color-gray-3);
		font-family: var(--font-mono);
		font-size: var(--sl-text-sm);
	}

	.cq .cq-actions {
		margin: 32px 0 0;
	}
	.cq-actions[hidden],
	.cq-result[hidden],
	.cq-second[hidden] {
		display: none;
	}
	.cq-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		padding: 0 22px;
		border: 1px solid var(--sl-color-white);
		border-radius: var(--radius-pill);
		font: 500 var(--sl-text-sm) / 1 var(--font-sans);
		cursor: pointer;
	}
	.cq .cq-btn {
		text-decoration: none;
	}
	.cq .cq-btn.solid {
		background: var(--sl-color-white);
		color: var(--sl-color-black);
	}
	.cq .cq-btn.ghost {
		background: transparent;
		border-color: var(--dim);
		color: var(--sl-color-white);
	}
	.cq .cq-btn.ghost:hover {
		border-color: var(--sl-color-white);
	}
	.cq-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.cq-result {
		/* clear of Starlight's header above and the taskbar below when the result scrolls into view */
		scroll-margin: calc(var(--sl-nav-height, 64px) + 16px) 0 calc(var(--tb-space, 88px) + 16px);
		margin-top: 32px;
		padding: clamp(20px, 4vw, 32px);
		border: 1px solid var(--sl-color-white);
		border-radius: var(--radius-panel);
		color: var(--sl-color-gray-2);
	}
	.cq-result h2 {
		margin: 0 0 16px;
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.cq-result h2:focus {
		outline: none;
	}
	.cq-result h2:focus-visible {
		outline: 2px solid var(--sl-color-white);
		outline-offset: 4px;
	}
	.cq-why {
		color: var(--sl-color-white);
	}
	.cq .cq-row:last-child {
		margin: 8px 0 0;
	}

	.cq-self {
		margin-top: 48px;
		padding-top: 32px;
		border-top: 1px solid var(--line);
		color: var(--sl-color-gray-2);
	}
	.cq-self h2 {
		margin: 0 0 16px;
		color: var(--sl-color-white);
		font-size: var(--sl-text-h3);
		font-weight: 500;
	}
	.cq-self h3 {
		margin: 32px 0 12px;
		color: var(--sl-color-white);
		font-size: var(--sl-text-h4);
		font-weight: 500;
	}
	.cq-self ul {
		margin: 0 0 1em;
		padding-left: 1.2em;
		list-style: disc;
	}
	.cq-self li {
		margin: 0.4em 0;
	}
	.cq-self abbr {
		text-decoration: none;
		font-family: var(--font-mono);
	}
	.cq-table {
		margin: 16px 0 0;
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
	}
	caption {
		margin-bottom: 8px;
		color: var(--sl-color-gray-3);
		font-family: var(--font-sans);
		font-size: var(--sl-text-sm);
		text-align: left;
	}
	th,
	td {
		padding: 8px 6px;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
		white-space: nowrap;
	}
	thead th {
		color: var(--sl-color-gray-3);
		font-weight: 500;
	}
	tbody th {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.cq-credit {
		margin-top: 40px !important;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.cq .cq-credit a {
		color: inherit;
	}
	@media print {
		.cq-actions,
		.cq-live {
			display: none !important;
		}
		.cq-opt {
			min-height: 0;
			padding: 4px 8px;
			break-inside: avoid;
		}
		.cq-q {
			break-inside: avoid;
		}
	}
</style>
