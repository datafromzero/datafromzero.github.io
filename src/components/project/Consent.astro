---
// Consent banner + Consent Mode v2 + GA4 loader (SPEC §11, D8). Renders nothing, and so adds no HTML,
// CSS or JavaScript, while GA_ID is empty. When set: defaults are `denied` before anything loads, gtag.js
// is requested only after Accept, and the choice lives in localStorage `dfz-consent`.
import { ANALYTICS_ENABLED, GA_ID } from '../../site';
import { projectHref, siteUi } from '../../i18n/site-ui';

interface Props {
	lang?: string;
}
const lang = Astro.props.lang ?? 'en';
const t = siteUi(lang).consent;
---

{ANALYTICS_ENABLED && (
	<>
		<div id="dfz-consent" class="dfz-consent dfz-noprint" role="region" aria-labelledby="dfz-consent-text" hidden>
			<p id="dfz-consent-text">{t.text} <a href={projectHref(lang, 'privacy')}>{t.privacy}</a></p>
			<div class="actions">
				<button type="button" data-consent="denied">{t.decline}</button>
				<button type="button" data-consent="granted" class="primary">{t.accept}</button>
			</div>
		</div>
		<script is:inline define:vars={{ id: GA_ID }}>
			(function () {
				var KEY = 'dfz-consent';
				var w = window;
				w.dataLayer = w.dataLayer || [];
				function gtag() { w.dataLayer.push(arguments); }
				// Consent Mode v2: everything denied until the visitor accepts. Nothing is requested yet.
				gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
				var loaded = false;
				function load() {
					if (loaded) return;
					loaded = true;
					gtag('js', new Date());
					gtag('config', id);
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
					document.head.appendChild(s);
				}
				function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
				function save(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
				function apply(v) {
					if (v === 'granted') {
						w['ga-disable-' + id] = false;
						gtag('consent', 'update', { analytics_storage: 'granted' });
						load();
					} else {
						w['ga-disable-' + id] = true;
						gtag('consent', 'update', { analytics_storage: 'denied' });
					}
				}
				var box = document.getElementById('dfz-consent');
				var opener = null;
				var stored = read();
				if (stored === 'granted' || stored === 'denied') apply(stored);
				else box.hidden = false;
				box.addEventListener('click', function (e) {
					var b = e.target.closest('[data-consent]');
					if (!b) return;
					var v = b.getAttribute('data-consent');
					save(v);
					apply(v);
					box.hidden = true;
					document.dispatchEvent(new Event('dfz:layout'));
					if (opener) { opener.focus(); opener = null; }
				});
				document.addEventListener('click', function (e) {
					var o = e.target.closest('[data-consent-open]');
					if (!o) return;
					opener = o;
					box.hidden = false;
					document.dispatchEvent(new Event('dfz:layout'));
					box.querySelector('button').focus();
				});
			})();
		</script>
		{/* Inline and inside the condition: no stylesheet request at all while analytics is off. */}
		<style is:inline>
			/* Top of the page, in normal flow, never fixed (GOV.UK cookie banner; WCAG 2.2 SC 2.4.11). */
			.dfz-consent {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 12px 16px;
				padding: 16px var(--sl-content-pad-x, 16px);
				background: var(--bg);
				color: var(--fg);
				border-bottom: 1px solid var(--mute);
				font: 400 14px/1.5 var(--font-sans);
			}
			/* The homepage nav is fixed and transparent (72px tall): start the banner below it, on the page's gutter. */
			.home .dfz-consent {
				padding: calc(72px + 8px) var(--pad) 16px;
			}
			.dfz-consent[hidden] {
				display: none;
			}
			.dfz-consent p {
				margin: 0;
				flex: 1 1 16rem;
			}
			.dfz-consent a {
				color: inherit;
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}
			.dfz-consent .actions {
				display: flex;
				gap: 8px;
			}
			.dfz-consent button {
				font: 500 14px/1 var(--font-sans);
				min-height: 44px;
				padding: 0 20px;
				border-radius: var(--radius-pill);
				border: 1px solid var(--mute);
				background: transparent;
				color: var(--fg);
				cursor: pointer;
			}
			.dfz-consent button.primary {
				background: var(--fg);
				color: var(--bg);
				border-color: var(--fg);
			}
			.dfz-consent button:focus-visible,
			.dfz-consent a:focus-visible {
				outline: 2px solid var(--fg);
				outline-offset: 2px;
			}
		</style>
	</>
)}
