---
// "Continue: S7 · Inner join" (SPEC D64): a link to the lesson this browser opened last. Hidden, with the address of /start/,
// until src/scripts/progress.ts finds a valid record in storage, so it takes no room without JavaScript or without data.
interface Props {
	/** Space above the link (a CSS length), for where it follows a heading. */
	top?: string;
}
const { top } = Astro.props;
---

<a class="dfz-continue" href="/start/" data-continue hidden style={top ? `margin-top:${top}` : undefined}></a>

<style>
	.dfz-continue {
		display: block;
		width: fit-content;
		max-width: 100%;
		color: var(--fg);
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 13px;
		line-height: 1.5;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}
	.dfz-continue[hidden] {
		display: none;
	}
	.dfz-continue::after {
		content: ' →';
	}
</style>
