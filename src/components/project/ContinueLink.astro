---
// "Continue: S20 · INNER JOIN: pairing rows on a key" (SPEC D64): a link to the lesson this browser opened last. Hidden, with the address of /start/,
// until src/scripts/progress.ts finds a valid record in storage, so it takes no room without JavaScript or without data.
interface Props {
	/** Space above the link (a CSS length), for where it follows a heading. */
	top?: string;
	/** Hold one line of room while JavaScript runs, so showing the link moves nothing (long titles are cut with an ellipsis). */
	hold?: boolean;
}
const { top, hold = false } = Astro.props;
---

<a class:list={['dfz-continue', { hold }]} href="/start/" data-continue hidden style={top ? `margin-top:${top}` : undefined}></a>

<style>
	.dfz-continue {
		display: block;
		width: fit-content;
		max-width: 100%;
		color: var(--fg);
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 14px;
		line-height: 1.5;
		/* A tap target of at least 24 px high (WCAG 2.5.8): 21 px of text and 4 px above and below. */
		padding-block: 4px;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}
	.dfz-continue[hidden] {
		display: none;
	}
	.dfz-continue.hold {
		height: calc(1.5em + 8px); /* the global reset is border-box: the padding is inside the height */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* While scripting is enabled the line's room is held but not drawn. Without it the link takes no room. (Not
	   `:root[data-theme]`: Starlight writes that into the static HTML, so it matches with JavaScript off.) */
	@media (scripting: enabled) {
		.dfz-continue.hold[hidden] {
			display: block;
			visibility: hidden;
		}
	}
	.dfz-continue::after {
		content: ' →';
	}
</style>
