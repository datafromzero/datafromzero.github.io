---
// Build-time content for project pages whose text comes from a single source elsewhere in the repo
// (SPEC §3.1): the roadmap map, the career quiz (src/lib/career-quiz.ts), the citation from CITATION.cff,
// CHANGELOG.md, LICENSE, LICENSE-CONTENT, and the analytics section of the privacy page. Rendered after the
// page's own Markdown. No client JS, except the career quiz's one small script (SPEC D33).
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import RoadmapMap from './RoadmapMap.astro';
import CareerQuiz from './CareerQuiz.astro';
import CookieSettings from './CookieSettings.astro';
import { loadCitation } from '../../lib/citation.ts';
import { readRepoFile } from '../../lib/repo-files.ts';
import { ANALYTICS_ENABLED, GA_RETENTION, GITHUB_BRANCH, GITHUB_REPO } from '../../site';

interface Props {
	id: string;
	lang?: string;
}
const { id, lang } = Astro.props;
const repo = `https://github.com/${GITHUB_REPO}`;

let changelogHtml = '';
if (id === 'changelog') {
	const md = readRepoFile('CHANGELOG.md').replace(/^# .*\n/, ''); // the page title is the h1
	changelogHtml = (await (await createMarkdownProcessor()).render(md)).code;
}
const cite = id === 'cite' ? loadCitation() : null;
const mit = id === 'license' ? readRepoFile('LICENSE').trim() : '';
const ccby = id === 'license' ? readRepoFile('LICENSE-CONTENT').trim() : '';
---

{id === 'start' && <RoadmapMap />}

{id === 'career-quiz' && <CareerQuiz lang={lang} />}

{cite && (
	<section class="extras">
		<h2 id="apa">APA</h2>
		<pre>{cite.apa}</pre>
		<h2 id="bibtex">BibTeX</h2>
		<pre>{cite.bibtex}</pre>
		<h2 id="doi">DOI</h2>
		<p>{cite.doi ? <a href={`https://doi.org/${cite.doi}`}>{cite.doi}</a> : 'DOI: after the first release.'}</p>
		<p>
			Version {cite.version}, licensed {cite.license}. The same data is in
			<a href={`${repo}/blob/${GITHUB_BRANCH}/CITATION.cff`}>CITATION.cff</a>, which GitHub reads for its "Cite this repository" button.
		</p>
	</section>
)}

{id === 'changelog' && <section class="extras changelog" set:html={changelogHtml} />}

{id === 'license' && (
	<section class="extras">
		<h2 id="content-license-text">Content license text</h2>
		<pre>{ccby}</pre>
		<h2 id="code-license-text">Code license text</h2>
		<pre>{mit}</pre>
	</section>
)}

{id === 'privacy' && (
	<section class="extras">
		<h2 id="analytics">Analytics</h2>
		{ANALYTICS_ENABLED ? (
			<>
				<p>
					This site uses Google Analytics 4 to count visits, but only if you accept. Until you choose, and if you decline,
					Google Analytics is not loaded, no analytics cookies are set and nothing is sent to Google. Consent Mode v2 is on with every
					storage type denied by default. The site works the same whichever you choose.
				</p>
				<p>If you accept, Google Analytics collects:</p>
				<ul>
					<li>page views, with the page address and the page you came from;</li>
					<li>approximate location (country and city), worked out from your IP address; Google Analytics 4 does not log or store IP addresses;</li>
					<li>device, browser, operating system and screen size;</li>
					<li>how long a page was in view;</li>
					<li>a random identifier stored in first-party cookies (<code>_ga</code> and <code>_ga_</code> followed by the property ID) to tell visits apart.</li>
				</ul>
				<p>We use this only to see which pages are read and where people get stuck, in order to improve lessons. We do not use it for advertising and we do not turn on Google's advertising features.</p>
				<p>
					<strong>Retention.</strong> Google Analytics 4 keeps event-level data for {GA_RETENTION}, the period set in the property's data settings.
				</p>
				<h2 id="your-choice">Change your choice</h2>
				<p>
					Your choice is stored in this browser only, under the key <code>dfz-consent</code>. To change it, use <CookieSettings lang={lang} /> in the page footer.
					Switching to Decline stops new data from being sent; to remove cookies already set, clear this site's cookies in your browser settings. You can
					also block Google Analytics everywhere with the <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">browser add-on from Google</a>.
				</p>
			</>
		) : (
			<p>This site does not currently use analytics. No visit counts, cookies or identifiers are collected. If that changes, this page will describe exactly what is collected and ask for your consent first.</p>
		)}
		<h2 id="questions">Questions</h2>
		<p>For privacy questions or requests, <a href={`https://github.com/${GITHUB_REPO}/issues`}>open an issue in the project repository</a>.</p>
	</section>
)}

<style>
	.extras {
		margin-top: 24px;
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		padding: 16px;
		background: var(--sl-color-gray-6);
		border-radius: var(--radius-panel);
	}
	.extras :global(h2),
	.extras :global(h3) {
		margin-top: 1.6em;
	}
	.extras :global(ul) {
		padding-left: 1.4em;
		list-style: disc;
	}
	.changelog :global(li) {
		margin: 0.3em 0;
	}
	.extras :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	@media print {
		.extras :global(a)::after {
			content: none;
		}
	}
</style>
