---
// The lesson list of a stage index page (/excel/, /sql/ … SPEC §3.1, D64), drawn under the page title from the same
// roadmap data as the map on /start/ (src/lib/roadmap-data.ts), with the same done ticks. The page's own Markdown
// (src/content/docs/{stage}/index.md) comes after it: that is where the stage's placement test goes.
import { CHEATSHEETS } from '../../lib/roadmap.ts';
import { loadRoadmap } from '../../lib/roadmap-data.ts';
import LessonList from './LessonList.astro';
import ProgressClear from './ProgressClear.astro';

interface Props {
	stage: string;
}
const stage = (await loadRoadmap()).find((s) => s.id === Astro.props.stage);
const sheet = CHEATSHEETS[Astro.props.stage];
---

{stage && (
	<div class="stage-page not-content" data-stage={stage.id} data-pagefind-ignore>
		<p class="lead">
			{stage.lessons.length} {stage.lessons.length === 1 ? 'lesson' : 'lessons'}, in the order to study them. "Needs" lists the codes to finish first.
		</p>
		<LessonList stage={stage} detail />
		<p class="links">
			<a href="/start/">← Back to the roadmap</a>
			{sheet && <a href={sheet.href}>{sheet.label}: the one-page cheatsheet →</a>}
		</p>
		<ProgressClear />
	</div>
)}

<style>
	.stage-page {
		max-width: 560px;
		margin: 8px 0 24px;
	}
	.lead {
		margin: 0;
		color: var(--mute);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin: 20px 0 0;
	}
	.links a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}
</style>
