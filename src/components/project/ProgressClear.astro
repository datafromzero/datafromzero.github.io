---
// "Clear my progress" and its status line (SPEC D64). Hidden until src/scripts/progress.ts runs, so without JavaScript
// the page shows neither a dead button nor a note about storage. Two taps, so one slip does not wipe the ticks.
---

<div class="clear" data-clear-wrap hidden>
	<button type="button" data-clear>Clear my progress</button>
	<p class="note" role="status" data-status></p>
	<p class="note">Your ticks and your last lesson stay in this browser only. Nothing is sent anywhere. <a href="/privacy/#progress">More on privacy</a></p>
</div>

<script>
	import '../../scripts/progress';
</script>

<style>
	.clear {
		margin: 28px 0 8px;
		max-width: 560px;
	}
	.clear[hidden] {
		display: none;
	}
	button {
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid var(--mute);
		border-radius: 6px;
		background: var(--bg);
		color: var(--fg);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	button:hover {
		border-color: var(--fg);
	}
	button:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	.note {
		margin: 10px 0 0;
		font-size: var(--sl-text-sm);
		color: var(--mute);
	}
	.note:empty {
		display: none;
	}
	.note a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}
</style>
