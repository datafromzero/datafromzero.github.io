---
// The A to Z list of /reference/glossary/ (SPEC §3.1, D68): every glossary term, drawn at build time from the `glossary`
// collection (src/content/docs/reference/glossary/*.md), so no list is kept by hand. Static HTML, no script.
import { getCollection } from 'astro:content';
import { classify } from '../../lib/content-schemas.ts';
import { glossaryGroups } from '../../lib/glossary.ts';

const terms = (await getCollection('docs'))
	.filter((d) => classify(d.id).kind === 'glossary' && classify(d.id).locale === null)
	.map((d) => {
		const g = d.data as unknown as { term: string; short: string; aliases: string[] };
		return { term: g.term, short: g.short, aliases: g.aliases, href: `/${classify(d.id).path}/` };
	});
const groups = glossaryGroups(terms);
---

<div class="glossary not-content" data-pagefind-ignore>
	<p class="lead">{terms.length} words, from A to Z.</p>
	<nav class="az" aria-label="Jump to a letter">
		<ul>
			{groups.map((g) => <li><a href={`#letter-${g.letter.toLowerCase()}`}>{g.letter}</a></li>)}
		</ul>
	</nav>
	{groups.map((g) => (
		<section>
			<h2 id={`letter-${g.letter.toLowerCase()}`}>{g.letter}</h2>
			<dl>
				{g.terms.map((t) => (
					<div class="entry">
						<dt><a href={t.href}>{t.term}</a></dt>
						<dd>
							{t.short}
							{t.aliases.length > 0 && <span class="also mono">Also called: {t.aliases.join(', ')}</span>}
						</dd>
					</div>
				))}
			</dl>
		</section>
	))}
</div>

<style>
	.glossary {
		max-width: 560px;
		margin: 8px 0 24px;
	}
	.mono {
		font-family: var(--font-mono);
	}
	.lead {
		margin: 0;
		color: var(--mute);
	}
	.az ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 4px;
		margin: 14px 0 6px;
		padding: 0;
		list-style: none;
	}
	.az li {
		margin: 0;
	}
	.az a {
		display: inline-block;
		min-width: 2.2rem;
		padding: 0.45rem 0;
		text-align: center;
		color: var(--fg);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
	}
	.az a:hover {
		border-color: var(--fg);
	}
	.az a:focus-visible,
	.entry a:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 2px;
	}
	h2 {
		margin: 1.4em 0 0;
		padding-bottom: 4px;
		border-bottom: 1px solid var(--line);
		font-size: 1.1rem;
		scroll-margin-top: 5rem;
	}
	dl {
		margin: 0;
	}
	.entry {
		padding: 10px 0;
		border-bottom: 1px solid var(--line);
	}
	dt {
		margin: 0;
		font-weight: 600;
	}
	dt a {
		color: var(--fg);
		text-underline-offset: 0.2em;
	}
	dd {
		margin: 2px 0 0;
		color: var(--sl-color-gray-2);
	}
	.also {
		display: block;
		margin-top: 2px;
		font-size: 12px;
		color: var(--mute);
	}
</style>
