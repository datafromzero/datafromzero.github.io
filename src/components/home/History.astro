---
// 04: a short history of data, from the 1804 punched-card loom to 2022 (design/README.md §5). Cards and
// sources come from GitHub issue #29; every card is sourced in the <details> below the slider: a short summary
// (the card's line and why it matters) and two short source links whose accessible names carry the full titles.
// The cards are one <ol> in DOM order. By default (no script, reduced motion, a blocked or failed chunk)
// they are a horizontal scroll-snap list. The deferred chunk (scripts/home/sections/history.ts) sets
// .is-live on the gallery: CSS then draws the slider's first frame, a 3D cover-flow fan (1804 centered; --d is a
// card's signed distance from the center, --ad its absolute value, --sg its side, --o its opacity, --k the shade over it,
// --zi its stacking; the fan's numbers --fx/--fz/--fr/--fp (and -p for phones) come from scripts/home/history-curve.ts like the
// GSAP loop's), and the chunk builds the loop, drag (Draggable), the buttons, ←/→ and the live region on it.
import Heading from './Heading.astro';
import HistoryIcon from './HistoryIcon.astro';
import { FAN, lookAt } from '../../scripts/home/history-curve';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['history'];
	startHref: string;
}
const { t, startHref } = Astro.props;
const cards = [...t.cards.map((c) => ({ ...c, now: false })), { ...t.now, sources: undefined, now: true }];
const n = cards.length;
/** Signed distance from the centered first card, on the loop: the last cards sit to its left. */
const dist = (i: number) => (i > n / 2 ? i - n : i);
// The fan's numbers for the two sizes, one source for the first frame and the loop (read back by history.ts).
// home.css swaps the phone set in below 700px (--fx: var(--fx-p), ...).
const fanVars = (f: typeof FAN.desktop, sfx = '') => `--fx${sfx}:${f.x};--fz${sfx}:${f.z};--fr${sfx}:${f.rot};--fp${sfx}:${f.depth}`;
const fanStyle = `${fanVars(FAN.desktop)};${fanVars(FAN.phone, '-p')}`;
---

<section class="block history" id="history" aria-labelledby="history-h" data-tb-name={t.short}>
	<span class="rule" aria-hidden="true"></span>
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="history-h" />
	</div>
	<div class="gallery" role="region" aria-roledescription="carousel" aria-label={t.carousel} tabindex="0" style={fanStyle}>
		<ol class="cards">
			{
				cards.map((c, i) => {
					const d = dist(i);
					const { opacity, shade, zIndex } = lookAt(d, FAN.desktop);
					return (
						<li class:list={['card', c.now && 'now']} style={`--d:${d};--ad:${Math.abs(d)};--sg:${Math.sign(d)};--o:${+opacity.toFixed(4)};--k:${+shade.toFixed(4)};--zi:${zIndex}`}>
							<span class="yr">{c.year}</span>
							<HistoryIcon name={c.icon} />
							<h3>{c.title}</h3>
							<p>
								{c.line}
								{c.now && (
									<>
										{' '}
										<a href={startHref}>
											{t.now.cta} <span aria-hidden="true">→</span>
										</a>
									</>
								)}
							</p>
						</li>
					);
				})
			}
		</ol>
		<div class="hist-controls" hidden>
			<button class="hist-btn" type="button" data-step="-1" aria-label={t.prev}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
			<span class="hist-count mono" aria-hidden="true"><b>01</b> / {String(t.cards.length).padStart(2, '0')}</span>
			<button class="hist-btn" type="button" data-step="1" aria-label={t.next}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
		</div>
		<p class="sr hist-live" aria-live="polite" aria-atomic="true"></p>
	</div>
	<details class="hist-src">
		<summary class="mono">{t.sourcesSummary}</summary>
		<p>{t.accessed}</p>
		<ol>
			{
				t.cards.map((c) => (
					<li>
						<span class="hist-src-h"><span class="mono">{c.year}</span> {c.title}</span>
						<p>{c.line} {c.why}</p>
						<p class="hist-src-links">
							<a href={c.sources[0].url} rel="noopener" aria-label={`${t.primary}: ${c.sources[0].name}`}>{t.primary} ↗</a>
							<span aria-hidden="true"> · </span>
							<a href={c.sources[1].url} rel="noopener" aria-label={`${t.second}: ${c.sources[1].name}`}>{t.second} ↗</a>
						</p>
					</li>
				))
			}
		</ol>
	</details>
</section>
