---
// 04: a short history of data, from the 1804 punched-card loom to 2022 (design/README.md §5). Cards and
// sources come from GitHub issue #29; every card is sourced in the <details> below the slider.
// The cards are one <ol> in DOM order. Without script, or with reduced motion, they are a horizontal
// scroll-snap list. With motion allowed, CSS alone already lays them out as the slider's first frame
// (1804 centered, the neighbors scaled and faded: --d is the distance from the center, --s the scale and
// opacity GSAP gives that distance), so the deferred chunk (scripts/home/sections/history.ts) takes over
// without a jump and adds the seamless loop, drag (Draggable), the buttons, ←/→ and the live region.
import Heading from './Heading.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['history'];
	startHref: string;
}
const { t, startHref } = Astro.props;
const cards = [...t.cards.map((c) => ({ ...c, now: false })), { ...t.now, sources: undefined, now: true }];
const n = cards.length;
/** Signed distance from the centered first card, on the loop: the last cards sit to its left. */
const dist = (i: number) => (i > n / 2 ? i - n : i);
/** The slider's scale and opacity for a distance (GSAP: power1.in up to the center and back, 0.1 per card). */
const size = (d: number) => Math.max(0, 1 - Math.abs(d) * 0.2) ** 2;
---

<section class="block history" id="history" aria-labelledby="history-h" data-tb-name={t.short}>
	<span class="rule" aria-hidden="true"></span>
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="history-h" />
	</div>
	<div class="gallery" role="region" aria-roledescription="carousel" aria-label={t.carousel} tabindex="0">
		<ol class="cards">
			{
				cards.map((c, i) => {
					const d = dist(i);
					const s = size(d);
					return (
						<li class:list={['card', c.now && 'now']} style={`--d:${d};--s:${+s.toFixed(4)};--z:${n - Math.abs(d)}`}>
							<span class="yr">{c.year}</span>
							<h3>{c.title}</h3>
							<p>
								{c.line}
								{c.now && (
									<>
										{' '}
										<a href={startHref}>
											{t.now.cta} <span aria-hidden="true">→</span>
										</a>
									</>
								)}
							</p>
						</li>
					);
				})
			}
		</ol>
		<div class="hist-controls" hidden>
			<button class="hist-btn" type="button" data-step="-1" aria-label={t.prev}><span aria-hidden="true">←</span></button>
			<button class="hist-btn" type="button" data-step="1" aria-label={t.next}><span aria-hidden="true">→</span></button>
		</div>
		<p class="sr hist-live" aria-live="polite" aria-atomic="true"></p>
	</div>
	<details class="hist-src">
		<summary class="mono">{t.sourcesSummary}</summary>
		<p>{t.accessed}</p>
		<ol>
			{
				t.cards.map((c) => (
					<li>
						<span class="hist-src-h"><span class="mono">{c.year}</span> {c.title}</span>
						<ul>
							<li>
								{t.primary}: <a href={c.sources[0].url} rel="noopener">{c.sources[0].name}</a>
							</li>
							<li>
								{t.second}: <a href={c.sources[1].url} rel="noopener">{c.sources[1].name}</a>
							</li>
						</ul>
					</li>
				))
			}
		</ol>
	</details>
</section>
