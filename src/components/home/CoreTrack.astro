---
import Heading from './Heading.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['core'];
}
const { t } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="block core" id="path" aria-labelledby="path-h" data-tb-name={t.short}>
	<span class="rule" aria-hidden="true"></span>
	<div class="core-grid">
		<div class="core-side">
			<span class="mono">{t.label}</span>
			<div class="core-count" aria-hidden="true">
				<span class="count-mask"><span class="count-cur">{pad(1)}</span></span><span class="count-of"> / {pad(t.steps.length)}</span>
			</div>
		</div>
		<div class="core-main">
			<div class="head-h"><Heading text={t.heading} id="path-h" /></div>
			<div class="track">
				<div class="rail" aria-hidden="true"><div class="rail-fill"></div></div>
				{
					t.steps.map((s, i) => (
						<div class="step">
							<span class="node" aria-hidden="true" />
							<span class="mono">{t.stepLabel} {pad(i + 1)}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
