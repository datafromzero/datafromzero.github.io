---
import type { HomeStrings } from '../../i18n/home';

interface Props {
	words: HomeStrings['marquee'];
	control: HomeStrings['marqueeControl'];
}
const { words, control } = Astro.props;
---

<!-- Static and wrapped without JS or with reduced motion; the script turns it into a loop and shows the copy. -->
<div class="marquee">
	<div class="marquee-inner">
		<div class="m-group">
			{words.map((w) => <span class:list={[w.outline && 'o']}>{w.text}</span>)}
		</div>
		<div class="m-group m-dup" aria-hidden="true">
			{words.map((w) => <span class:list={[w.outline && 'o']}>{w.text}</span>)}
		</div>
	</div>
	<!-- Shown by the script only while the loop runs (WCAG 2.2.2); pauses on hover and keyboard focus too. -->
	<button class="marquee-toggle mono" type="button" hidden aria-label={`${control.pause} ${control.what}`} data-pause={control.pause} data-play={control.play} data-what={control.what}>
		{control.pause}
	</button>
</div>
