---
import Heading from './Heading.astro';
import Lines from './Lines.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['modes'];
}
const { t } = Astro.props;
---

<section class="block" id="modes" aria-labelledby="modes-h">
	<span class="rule" aria-hidden="true"></span>
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="modes-h" />
	</div>
	<div class="modes">
		<div class="panel study">
			<button class="panel-toggle" type="button" hidden aria-pressed="false" aria-labelledby="mode-study-b mode-study-t">
				<span class="sr" id="mode-study-b">{t.toggle}</span><i aria-hidden="true"></i>
			</button>
			<div class="panel-top">
				<span class="mono" id="mode-study-t">{t.study.tag}</span>
				<div class="mock" aria-hidden="true">
					<div class="mono mock-lesson">{t.study.lesson}</div>
					<div class="q"><Lines text={t.study.question} /></div>
					<div class="pips"><i class="done"></i><i class="done"></i><i class="done"></i><i><b></b></i><i><b></b></i><i><b></b></i></div>
				</div>
			</div>
			<div class="panel-copy"><h3>{t.study.title}</h3><p>{t.study.text}</p></div>
		</div>
		<div class="panel ref">
			<button class="panel-toggle" type="button" hidden aria-pressed="false" aria-labelledby="mode-ref-b mode-ref-t">
				<span class="sr" id="mode-ref-b">{t.toggle}</span><i aria-hidden="true"></i>
			</button>
			<div class="panel-top">
				<span class="mono" id="mode-ref-t">{t.reference.tag}</span>
				<div class="mock" aria-hidden="true">
					<div class:list={[t.reference.rows[0]?.highlight && 'hl']}>
						<span>{t.reference.rows[0]?.name}</span><span>{t.reference.rows[0]?.value}</span>
					</div>
					<div class:list={[t.reference.rows[1]?.highlight && 'hl']}>
						<span>{t.reference.rows[1]?.name}</span><span>{t.reference.rows[1]?.value}</span>
					</div>
					<div class="f">{t.reference.formula}</div>
					<div class:list={[t.reference.rows[2]?.highlight && 'hl']}>
						<span>{t.reference.rows[2]?.name}</span><span>{t.reference.rows[2]?.value}</span>
					</div>
				</div>
			</div>
			<div class="panel-copy"><h3>{t.reference.title}</h3><p>{t.reference.text}</p></div>
		</div>
	</div>
</section>
