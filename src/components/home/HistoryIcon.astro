---
// One small line picture per history card (04), drawn here so it follows the text color in both themes.
// 32×32, 1.5 stroke, no brand logos: each shows the idea of the milestone, not a product's mark.
import type { HistoryIconName } from '../../i18n/home/types';

interface Props {
	name: HistoryIconName;
}
const { name } = Astro.props;
---

<svg class="hist-icon" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	{
		name === 'card' && (
			<>
				<path d="M4 8h20l4 4v12H4z" />
				<circle cx="9" cy="13" r="1" />
				<circle cx="14" cy="13" r="1" />
				<circle cx="19" cy="18" r="1" />
				<circle cx="9" cy="19" r="1" />
				<circle cx="24" cy="18" r="1" />
			</>
		)
	}
	{
		name === 'dial' && (
			<>
				<circle cx="16" cy="17" r="10" />
				<path d="M16 17l5-5M16 7v2M26 17h-2M8 17H6M23 10l-1.4 1.4M9 10l1.4 1.4" />
				<path d="M12 27h8" />
			</>
		)
	}
	{
		name === 'table' && (
			<>
				<rect x="4" y="6" width="24" height="20" rx="1.5" />
				<path d="M4 12h24M4 19h24M12 6v20M20 6v20" />
			</>
		)
	}
	{
		name === 'query' && (
			<>
				<rect x="4" y="6" width="24" height="20" rx="1.5" />
				<path d="M9 13l3 3-3 3M15 19h8" />
			</>
		)
	}
	{
		name === 'screen' && (
			<>
				<rect x="4" y="5" width="24" height="17" rx="1.5" />
				<path d="M12 27h8M16 22v5M4 11h24M12 5v17M20 5v17" />
			</>
		)
	}
	{
		name === 'sheet' && (
			<>
				<rect x="4" y="5" width="24" height="22" rx="1.5" />
				<path d="M4 10h24M10 10v17M4 16h24M4 21.5h24M19 10v17" />
				<rect x="10" y="16" width="9" height="5.5" stroke-width="2.5" />
			</>
		)
	}
	{
		name === 'code' && (
			<>
				<path d="M11 9l-7 7 7 7M21 9l7 7-7 7M18 7l-4 18" />
			</>
		)
	}
	{
		name === 'cluster' && (
			<>
				<rect x="4" y="5" width="10" height="7" rx="1" />
				<rect x="18" y="5" width="10" height="7" rx="1" />
				<rect x="4" y="20" width="10" height="7" rx="1" />
				<rect x="18" y="20" width="10" height="7" rx="1" />
				<path d="M9 12v8M23 12v8M14 8.5h4M14 23.5h4" />
			</>
		)
	}
	{
		name === 'frame' && (
			<>
				<rect x="4" y="6" width="24" height="20" rx="1.5" />
				<path d="M10 6v20M4 12h24M4 19h24M19 12v14" />
				<path d="M6.5 15.5h1M6.5 22.5h1" />
			</>
		)
	}
	{
		name === 'person' && (
			<>
				<circle cx="12" cy="10" r="4" />
				<path d="M4 26c0-5 3.6-8 8-8s8 3 8 8" />
				<path d="M22 21l2.5-3 2 2 2.5-4" />
			</>
		)
	}
	{
		name === 'network' && (
			<>
				<circle cx="6" cy="8" r="2" />
				<circle cx="6" cy="16" r="2" />
				<circle cx="6" cy="24" r="2" />
				<circle cx="26" cy="12" r="2" />
				<circle cx="26" cy="20" r="2" />
				<path d="M8 8l16 4M8 8l16 12M8 16l16-4M8 16l16 4M8 24l16-12M8 24l16-4" />
			</>
		)
	}
	{
		name === 'chat' && (
			<>
				<path d="M5 7h22v14H14l-6 5v-5H5z" />
				<path d="M11 14h.01M16 14h.01M21 14h.01" stroke-width="2.5" />
			</>
		)
	}
	{
		name === 'cursor' && (
			<>
				<rect x="4" y="5" width="11" height="8" />
				<path d="M15 5h13M15 13h13M4 13v14M4 21h11" />
				<path d="M17 16l9 3.5-4 1.5-1.5 4z" />
			</>
		)
	}
</svg>
