---
// 03: one business question answered in Excel, SQL and Python, beside the one result they all give
// (design/README.md §5). Without script every solution is shown, stacked, under its tool name; the script
// (scripts/home/tabs.ts, loaded for everyone once the page is idle) turns them into a tab list, and the
// deferred motion chunk adds the animation and the auto-cycle (sections/tools.ts).
import Heading from './Heading.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['tools'];
}
const { t } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** "{KEYWORD}" → a bright span; everything else is plain text (escaped by Astro). */
const tokens = (code: string) => code.split(/(\{[^}]*\})/).map((s) => (s.startsWith('{') ? { k: true, s: s.slice(1, -1) } : { k: false, s }));
---

<section class="block" id="tools" aria-labelledby="tools-h">
	<span class="rule" aria-hidden="true"></span>
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="tools-h" />
	</div>
	<div class="q3">
		<div class="ask">
			<span class="mono">{t.questionLabel}</span>
			<p>{t.question}</p>
			<button class="tools-toggle mono" type="button" hidden aria-pressed="false" data-pause={t.control.pause} data-play={t.control.play}>
				{t.control.pause}
			</button>
		</div>
		<div class="q3-panel tools" data-tabs data-tabs-label={t.tabsLabel}>
			<div class="sols">
				{
					t.solutions.map((sol) => (
						<div class="sol" id={`tool-${slug(sol.tool)}`}>
							<h3 class="mono sol-h">{sol.tool}</h3>
							<pre class="code"><code>{tokens(sol.code).map((p) => (p.k ? <span class="k">{p.s}</span> : p.s))}</code></pre>
						</div>
					))
				}
			</div>
		</div>
		<div class="q3-panel result">
			<table>
				<caption class="mono">{t.result.caption}</caption>
				<thead>
					<tr><th scope="col">{t.result.columns[0]}</th><th scope="col">{t.result.columns[1]}</th></tr>
				</thead>
				<tbody>
					{t.result.rows.map(([store, sales], i) => (
						<tr class:list={[i === 0 && 'top']}><td>{store}</td><td>{sales}</td></tr>
					))}
				</tbody>
			</table>
			<small>{t.result.note}</small>
		</div>
	</div>
</section>
