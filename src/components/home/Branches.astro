---
import Heading from './Heading.astro';
import Lines from './Lines.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['branch'];
}
const { t } = Astro.props;

// viewBox 0 0 1000 400: a trunk that forks at (500,130) into five branches (design/README.md §5).
const trunk = 'M500 0 V130';
const branches = [
	'M500 130 C500 250 100 220 100 360',
	'M500 130 C500 250 300 220 300 360',
	'M500 130 V360',
	'M500 130 C500 250 700 220 700 360',
	'M500 130 C500 250 900 220 900 360',
];
const leaves = [100, 300, 500, 700, 900];
---

<section class="block branch pin-wrap" id="branches" aria-labelledby="branches-h">
	<span class="rule" aria-hidden="true"></span>
	<div class="pin-stage">
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="branches-h" />
	</div>
	<div class="tree">
		<svg viewBox="0 0 1000 400" aria-hidden="true">
			<g class="ghost">
				<path d={trunk} />
				{branches.map((d) => <path d={d} />)}
				{leaves.map((x) => <circle cx={x} cy="360" r="6" />)}
			</g>
			<path class="trunk" d={trunk} />
			{branches.map((d) => <path class="br" d={d} />)}
			<circle class="fork" cx="500" cy="130" r="5" />
			{leaves.map((x) => <circle class="ring" cx={x} cy="360" r="6" />)}
			{leaves.map((x) => <circle class="leaf" cx={x} cy="360" r="6" />)}
		</svg>
		<ul class="labels">
			{
				t.careers.map((c) => (
					<li>
						<b>{c.abbr}</b>
						<span><Lines text={c.name} /></span>
					</li>
				))
			}
		</ul>
	</div>
	</div>
</section>
