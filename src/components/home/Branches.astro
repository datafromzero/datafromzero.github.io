---
import Heading from './Heading.astro';
import Lines from './Lines.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['branch'];
}
const { t } = Astro.props;

// viewBox 0 0 1000 400: a trunk that forks at (500,130) into four branches, one per career (SPEC D32,
// design/README.md §5). The leaves are evenly spaced at the centers of four equal columns (125, 375, 625, 875),
// so each sits above its label in the four-column grid below.
const trunk = 'M500 0 V130';
const leaves = [125, 375, 625, 875];
const branches = leaves.map((x) => `M500 130 C500 250 ${x} 220 ${x} 360`);
---

<section class="block branch pin-wrap" id="branches" aria-labelledby="branches-h" data-tb-name={t.short}>
	<span class="rule" aria-hidden="true"></span>
	<div class="pin-stage">
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="branches-h" />
	</div>
	<div class="tree">
		<svg viewBox="0 0 1000 400" aria-hidden="true">
			<g class="ghost">
				<path d={trunk} />
				{branches.map((d) => <path d={d} />)}
				{leaves.map((x) => <circle cx={x} cy="360" r="6" />)}
			</g>
			<path class="trunk" d={trunk} />
			{branches.map((d) => <path class="br" d={d} />)}
			<circle class="fork" cx="500" cy="130" r="5" />
			{leaves.map((x) => <circle class="ring" cx={x} cy="360" r="6" />)}
			{leaves.map((x) => <circle class="leaf" cx={x} cy="360" r="6" />)}
		</svg>
		<ul class="labels">
			{
				t.careers.map((c) => (
					<li>
						<b>{c.abbr}</b>
						<span><Lines text={c.name} /></span>
					</li>
				))
			}
		</ul>
	</div>
	</div>
</section>
