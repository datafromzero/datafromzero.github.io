---
// The author line above the homepage footer (owner request, 2026-11-17): the owner's GitHub avatar (self-hosted, so
// the homepage makes no request to GitHub), the name linking to the owner's site, one line of the story and a link to
// /about/. Static: no script and no motion.
import { Image } from 'astro:assets';
import avatar from '../../assets/author.jpg';
import type { HomeStrings } from '../../i18n/home';
import { projectHref } from '../../i18n/site-ui';

interface Props {
	t: HomeStrings['author'];
	lang: string;
}
const { t, lang } = Astro.props;
---

<aside class="author" aria-label={t.label}>
	<Image class="au-photo" src={avatar} alt="" width={56} height={56} densities={[1, 2]} format="webp" loading="lazy" decoding="async" />
	<div class="au-text">
		<a class="au-name" href={t.href} rel="me noopener">{t.name} <span aria-hidden="true">↗</span></a>
		<p>{t.line}</p>
	</div>
	<a class="au-more" href={projectHref(lang, 'about')}>{t.more} <span aria-hidden="true">→</span></a>
</aside>
