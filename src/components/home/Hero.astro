---
// Hero: the logo and the "From A1 to AI." wordmark as one lockup, centred (design/README.md §4, §5).
// The wordmark is the page's h1. Its accessible name is the plain sentence (aria-label); the visual copy
// below is aria-hidden because it is split into masked words for the CSS entrance, and the last word
// carries the reel: "A" plus a 1em column that rolls from 1 to I (its other glyphs are CSS content, so the
// DOM text stays "From A1 to AI."). With no animation the reel rests on I. The Excel-style selection box
// that moves from A1 to AI is added by the deferred motion chunk (scripts/home/fx/select.ts).
import Logo from './Logo.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['hero'];
	startHref: string;
}
const { t, startHref } = Astro.props;
const words = t.lockup.split(' ').filter(Boolean);
const last = words.length - 1;
const reelAt = /^AI/.test(words[last] ?? '') ? last : -1;
---

<section class="hero" id="top">
	<div class="dots" aria-hidden="true"></div>
	<div class="stage">
		<div class="lockup">
			<div class="mark">
				<button class="stage-logo" type="button" data-replay hidden aria-label={t.replay}></button>
				<Logo class="morph" label={t.logoLabel} animated />
			</div>
			<h1 class="lockup-wm" aria-label={t.lockup}>
				<span class="lockup-wv" aria-hidden="true">
					{
						words.map((word, i) => (
							<>
								{i > 0 && ' '}
								<span class={word === 'A1' ? 'hw a1' : 'hw'}>
									<span style={`--i:${i}`}>
										{i === reelAt ? (
											// one line on purpose: whitespace between these spans would render as a space
											<><span class="ai">A<span class="roll"><span class="reel">I</span></span></span><span class="tail">{word.slice(2)}</span></>
										) : (
											word
										)}
									</span>
								</span>
							</>
						))
					}
				</span>
			</h1>
		</div>
	</div>
	<div class="hero-inner">
		<div class="hero-sub">
			<p class="reveal">{t.sub}</p>
			<div class="ctas reveal">
				<a class="btn solid" href={startHref}>{t.ctaStart} <span class="arr" aria-hidden="true">→</span></a>
				<a class="btn ghost" href="#tools">{t.ctaExample}</a>
			</div>
		</div>
	</div>
	<div class="scroll-hint mono" aria-hidden="true">{t.scroll}<i></i></div>
</section>
