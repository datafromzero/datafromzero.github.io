---
// 05: pick a direction. The four careers (SPEC D32) from the owner-approved mockup, then the quiz teaser.
// Without script every career's details are shown in full, one after another, and each card is a link to its
// details: nothing is hidden and there is no figure. With script (scripts/home/careers.ts, no GSAP, every
// reader) the links become buttons (aria-expanded, aria-controls) that open one detail panel at a time, Data
// Analyst first. CSS draws that state from the first paint where script runs, so nothing moves when it arrives;
// `.is-static` (set when the chunk fails) brings back the full list. The looping canvas figure on the left of
// the panel is a deferred chunk loaded when the section nears (scripts/home/careers-figures.ts).
import Heading from './Heading.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['careers'];
	startHref: string;
	quizHref: string;
}
const { t, startHref, quizHref } = Astro.props;
/** "Not sure which *career fits you?*": the starred part is the muted second voice. */
const unsure = t.unsure.heading.split('*').map((seg, i) => ({ seg, em: i % 2 === 1 }));
---

<section class="block careers" id="careers" aria-labelledby="careers-h" data-tb-name={t.short} data-careers>
	<span class="rule" aria-hidden="true"></span>
	<div class="head">
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="careers-h" />
	</div>
	<ul class="cr-cards">
		{
			t.careers.map((c, i) => (
				<li>
					<a class:list={['cr-card', i === 0 && 'is-on']} href={`#cr-${c.key}`} data-k={c.key}>
						<span class="mono">{c.label}</span>
						<span class="cr-name">{c.name}</span>
						<span class="cr-line">{c.line}</span>
						<span class="cr-more">
							{t.more} <i aria-hidden="true">+</i>
						</span>
					</a>
				</li>
			))
		}
	</ul>
	<div class="cr-detail">
		<div>
			<div class="cr-in">
				<div class="cr-stage" aria-hidden="true">
					<span class="mono cr-cap">{t.careers[0].figure}</span>
				</div>
				<div class="cr-panels">
					{
						t.careers.map((c, i) => (
							<div class:list={['cr-panel', i > 0 && 'is-off']} id={`cr-${c.key}`} data-k={c.key} data-fig={c.figure}>
								<h3>{c.name}</h3>
								<ul class="cr-does">
									{c.does.map((d) => (
										<li>{d}</li>
									))}
								</ul>
								<ol class="cr-path" aria-label={t.pathLabel}>
									{t.path.map((s) => (
										<li>{s}</li>
									))}
									<li>
										<b>{c.name}</b>
									</li>
								</ol>
								<p class="cr-port">{c.portfolio}</p>
								<p>
									<a class="btn solid" href={startHref}>
										{t.cta} <span class="arr" aria-hidden="true">→</span>
									</a>
								</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
	<div class="cr-unsure">
		<div>
			<h3>{unsure.map((p) => (p.em ? <em>{p.seg}</em> : p.seg))}</h3>
			<p>{t.unsure.text}</p>
		</div>
		<p>
			<a class="btn solid" href={quizHref}>
				{t.unsure.cta} <span class="arr" aria-hidden="true">→</span>
			</a>
		</p>
	</div>
</section>
