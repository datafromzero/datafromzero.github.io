---
// The homepage for one language. All copy comes from src/i18n/home; links are language-aware.
import HomeLayout from '../../layouts/HomeLayout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import CoreTrack from './CoreTrack.astro';
import Branches from './Branches.astro';
import Tools from './Tools.astro';
import History from './History.astro';
import Careers from './Careers.astro';
import HomeFooter from './HomeFooter.astro';
import Taskbar from '../taskbar/Taskbar.astro';
import { SITE_NAME } from '../../site';
import { homeHref, homeStrings, type HomeLang } from '../../i18n/home';

interface Props {
	lang: HomeLang;
}
const { lang } = Astro.props;
const t = homeStrings(lang);
const start = homeHref(lang, '/start/');
const sections = [
	{ href: '#path', name: t.core.short },
	{ href: '#branches', name: t.branch.short },
	{ href: '#tools', name: t.tools.short },
	{ href: '#history', name: t.history.short },
	{ href: '#careers', name: t.careers.short },
];
---

<HomeLayout lang={lang} title={`${SITE_NAME}: ${t.meta.tagline}`} description={t.meta.description}>
	<a class="skip" href="#main">{t.nav.skip}</a>
	<Nav t={t.nav} roadmapHref={start} />
	<main id="main">
		<Hero t={t.hero} />
		<CoreTrack t={t.core} />
		<Branches t={t.branch} />
		<Tools t={t.tools} />
		<History t={t.history} startHref={start} />
		<Careers t={t.careers} startHref={start} quizHref={homeHref(lang, '/career-quiz/')} />
	</main>
	<HomeFooter t={t.footer} github={t.nav.github} lang={lang} />
	<Taskbar lang={lang} label={SITE_NAME} kick={t.hero.short} top="#top" sections={sections} />
</HomeLayout>
