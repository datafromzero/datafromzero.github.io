---
import { AUTHOR_NAME, CURRICULUM_VERSION, GITHUB_REPO } from '../../site';
import type { HomeStrings } from '../../i18n/home';
import { projectHref, siteUi } from '../../i18n/site-ui';
import { loadCitation } from '../../lib/citation';

interface Props {
	t: HomeStrings['footer'];
	github: string;
	lang: string;
}
const { t, github, lang } = Astro.props;
const nav = siteUi(lang).nav;
const { doi } = loadCitation(); // concept DOI: always resolves to the latest release (SPEC §9)
const links = [
	['about', nav.about],
	['cite', nav.cite],
	['changelog', nav.changelog],
	['license', nav.license],
	['privacy', nav.privacy],
	['translate', nav.translate],
] as const;
---

<footer class="site-foot mono">
	<p class="foot-meta">
		<span>© 2026 {AUTHOR_NAME}</span>
		<span>{t.content} · {t.code}</span>
		<span>{t.version.replace('{version}', CURRICULUM_VERSION)}</span>
		{doi && <a href={`https://doi.org/${doi}`} rel="noopener">DOI {doi} ↗</a>}
		<a href={`https://github.com/${GITHUB_REPO}`} rel="noopener">{github} ↗</a>
	</p>
	<nav class="project-links" aria-label={nav.label}>
		{links.map(([slug, label]) => <a href={projectHref(lang, slug)}>{label}</a>)}
	</nav>
</footer>
