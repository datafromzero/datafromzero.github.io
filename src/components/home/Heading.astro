---
// Heading copy: "\n" starts a new line, *text* is the muted second voice (design/README.md §2).
// split: words are wrapped at build time (hero only) so the CSS entrance needs no JS. The heading keeps
// one accessible name (aria-label) and the word spans are hidden from assistive tech.
// data-label carries the same name for the runtime splits (SplitText drops <br> when it builds its own).
// Other headings stay plain text; SplitText splits them in the browser when they near the viewport.
interface Props {
	text: string;
	as?: 'h1' | 'h2';
	id?: string;
	class?: string;
	split?: boolean;
}
const { text, as: Tag = 'h2', class: cls, id, split = false } = Astro.props;
const lines = text.split('\n').map((line) => line.split('*').map((seg, i) => ({ seg, em: i % 2 === 1 })));
const label = lines.map((parts) => parts.map((p) => p.seg).join('')).join(' ');
let n = 0;
---

<Tag class={cls} id={id} data-split={split ? 'built' : ''} data-label={label} aria-label={split ? label : undefined}>
	{
		lines.map((parts, i) => (
			<>
				{i > 0 && <br />}
				{parts.map((p) => {
					const words = p.seg.split(' ').filter(Boolean);
					const inner = split
						? words.map((word, wi) => (
								<>
									{wi > 0 && ' '}
									<span class="hw" aria-hidden="true">
										<span style={`--i:${n++}`}>{word}</span>
									</span>
								</>
							))
						: p.seg;
					const wrapped = split ? (
						<>
							{p.seg.startsWith(' ') && ' '}
							{inner}
							{p.seg.endsWith(' ') && p.seg.trim() !== '' && ' '}
						</>
					) : (
						inner
					);
					return p.em ? <em>{wrapped}</em> : wrapped;
				})}
			</>
		))
	}
</Tag>
