---
// The mark from design/logo/logo-inline-currentColor.svg, inlined so the void follows --logo-bg.
// Keep the class names (disc, void, bands): the animation depends on them.
// `animated` adds the thin trace ring and normalizes stroke lengths (pathLength=1) so the intro
// (design/README.md §4) can run as plain CSS keyframes, before any JavaScript is loaded.
import markSvg from '../../assets/logo/logo-inline-currentColor.svg?raw';

interface Props {
	class?: string;
	/** Accessible name. Omit for a decorative mark. */
	label?: string;
	animated?: boolean;
}
const { class: cls = '', label, animated = false } = Astro.props;
const attrs = label ? `role="img" aria-label="${label.replace(/"/g, '&quot;')}"` : 'aria-hidden="true"';
let svg = markSvg.replace('<svg class="logo"', `<svg class="logo ${cls}" ${attrs}`);
if (animated) {
	svg = svg
		.replace('<circle class="disc"', '<circle class="trace" cx="50" cy="50" r="46" pathLength="1" transform="rotate(-90 50 50)"/><circle class="disc"')
		.replace(/<path d="(M29 (?:31|45|59)C)/g, '<path pathLength="1" d="$1');
}
---

<Fragment set:html={svg} />
