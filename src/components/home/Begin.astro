---
import Logo from './Logo.astro';
import Heading from './Heading.astro';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['begin'];
	startHref: string;
}
const { t, startHref } = Astro.props;
---

<section class="block end pin-wrap" aria-labelledby="begin-h">
	<span class="rule" aria-hidden="true"></span>
	<div class="pin-stage">
		<Logo class="endmark" />
		<span class="mono">{t.label}</span>
		<Heading text={t.heading} id="begin-h" />
		<div class="magnet"><a class="btn solid" href={startHref}>{t.cta} <span class="arr" aria-hidden="true">→</span></a></div>
	</div>
</section>
