---
import Logo from './Logo.astro';
import { SITE_NAME, GITHUB_REPO } from '../../site';
import type { HomeStrings } from '../../i18n/home';

interface Props {
	t: HomeStrings['nav'];
	roadmapHref: string;
}
const { t, roadmapHref } = Astro.props;
---

<div class="progress" aria-hidden="true"></div>
<header class="site-head">
	<nav aria-label={t.label}>
		<a class="brand" href="#top">
			<Logo class="mini" />
			<span class="wm">{SITE_NAME}</span>
		</a>
		<div class="navlinks">
			<a href={roadmapHref}>{t.roadmap}</a>
			<a href="#modes">{t.reference}</a>
			<a href={`https://github.com/${GITHUB_REPO}`} rel="noopener">{t.github} ↗</a>
		</div>
	</nav>
</header>
