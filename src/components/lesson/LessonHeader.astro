---
// Rendered from frontmatter above the lesson content (SPEC §5.1). No client-side JavaScript.
import type { Lesson } from '../../lib/content-schemas.ts';
import { lessonLinks } from '../../lib/lessons.ts';

const { entry, locale } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const lesson = entry.data as unknown as Lesson;
const reviewed = new Date(lesson.reviewed).toISOString().slice(0, 10);
const prerequisites = await lessonLinks(lesson.prerequisites, locale);
const replacement = lesson.status === 'deprecated' && lesson.replaced_by
	? (await lessonLinks([lesson.replaced_by], locale))[0]
	: undefined;
---

<div class="lesson-header not-content">
	{replacement && (
		<p class="deprecated">
			{t('lesson.deprecated')} <a href={replacement.href}>{replacement.title}</a>
		</p>
	)}
	<p class="meta">
		<span>{t(`lesson.level.${lesson.level}`)}</span>
		<span aria-hidden="true">·</span>
		<span>{t('lesson.minutes', { minutes: lesson.duration })}</span>
		<span aria-hidden="true">·</span>
		<time datetime={reviewed}>{t('lesson.reviewed', { date: reviewed })}</time>
	</p>
	<h2 class="label">{t('lesson.objectives')}</h2>
	<ul>
		{lesson.objectives.map((o) => <li>{o}</li>)}
	</ul>
	{prerequisites.length > 0 && (
		<>
			<h2 class="label">{t('lesson.prerequisites')}</h2>
			<ul>
				{prerequisites.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
			</ul>
		</>
	)}
</div>

<style>
	@layer starlight.core {
		.lesson-header {
			margin-top: 1rem;
			padding-bottom: 1.25rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-2);
		}
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 0.5rem;
			margin: 0 0 1rem;
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			color: var(--mute);
		}
		.deprecated {
			margin: 0 0 1rem;
			padding: 0.5rem 0.75rem;
			border: 1px solid var(--dim);
			border-radius: var(--radius-panel);
			color: var(--fg);
		}
		.label {
			margin: 1rem 0 0.25rem;
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			font-weight: 500;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--mute);
		}
		ul {
			margin: 0;
			padding-inline-start: 1.25rem;
		}
		li {
			margin: 0.125rem 0;
		}
		a {
			color: var(--fg);
		}
	}
</style>
