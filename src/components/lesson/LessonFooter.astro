---
// Rendered from frontmatter below the lesson content (SPEC §5.1, §9). No client-side JavaScript.
import type { Lesson } from '../../lib/content-schemas.ts';
import { unlockedLessons } from '../../lib/lessons.ts';
import { classify } from '../../lib/content-schemas.ts';
import { cheatsheetLink } from '../../data/cheatsheets/index.ts';
import { lessonCode } from '../../lib/roadmap.ts';
import { AUTHOR_NAME, CURRICULUM_VERSION, GITHUB_BRANCH, GITHUB_REPO } from '../../site.ts';

const { entry, locale } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const lesson = entry.data as unknown as Lesson;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date(lesson.reviewed).getUTCFullYear();
const title = entry.data.title;
const slug = classify(entry.id).path.split('/')[1] ?? '';
// Only English lessons of a stage with a cheatsheet (D44); the link is built from the sheet's own data.
const sheetLink = lesson.status === 'published' && locale !== 'vi' ? cheatsheetLink(lesson.stage, slug, lesson.order) : undefined;
const unlocked = await unlockedLessons(lesson.id, locale);

// A static page cannot know the reader's access date, so the citation omits it and the note says so.
// The author is the organization (src/site.ts), so the site name is not repeated.
const citation = `${AUTHOR_NAME}. (${year}). ${title}. Curriculum version ${CURRICULUM_VERSION}. ${pageUrl}`;

const repoUrl = `https://github.com/${GITHUB_REPO}`;
const editUrl = `${repoUrl}/edit/${GITHUB_BRANCH}/${entry.filePath}`;
// The same issue form as the taskbar's "Report a problem" (SPEC D37), with the page and the title filled in.
const code = lessonCode(lesson.stage, lesson.order);
const issueUrl = `${repoUrl}/issues/new?${new URLSearchParams({
	template: 'page-report.yml',
	page: pageUrl,
	title: code ? `[${code}] ${title}` : title,
})}`;
---

<section class="lesson-footer not-content">
	{unlocked.length > 0 && (
		<>
			<h2 class="label">{t('lesson.unlocks')}</h2>
			<ul>
				{unlocked.map((u) => <li>{u.code && <span class="code">{u.code} </span>}<a href={u.href}>{u.title}</a></li>)}
			</ul>
		</>
	)}
	{sheetLink && (
		<p class="sheet">
			<a href={sheetLink.href}>{t('lesson.cheatsheet', { stage: sheetLink.stage })}</a>
		</p>
	)}
	<h2 class="label">{t('lesson.sources')}</h2>
	<ul>
		{lesson.sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
	</ul>
	<h2 class="label">{t('lesson.cite')}</h2>
	<p class="cite">{citation}</p>
	<p class="note">{t('lesson.citeNote')}</p>
	<p class="links">
		<a href={editUrl}>{t('lesson.suggestEdit')}</a>
		<a href={issueUrl}>{t('lesson.reportIssue')}</a>
	</p>
</section>

<style>
	@layer starlight.core {
		.lesson-footer .code {
			font-family: var(--font-mono);
			color: var(--sl-color-gray-3);
		}
		.lesson-footer {
			margin-top: 3rem;
			padding-top: 1.25rem;
			border-top: 1px solid var(--line);
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-2);
		}
		.label {
			margin: 1rem 0 0.25rem;
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			font-weight: 500;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--mute);
		}
		.label:first-child {
			margin-top: 0;
		}
		ul {
			margin: 0;
			padding-inline-start: 1.25rem;
		}
		li {
			margin: 0.125rem 0;
		}
		.cite {
			margin: 0;
			padding: 0.75rem;
			border: 1px solid var(--line);
			border-radius: var(--radius-panel);
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			overflow-wrap: anywhere;
			user-select: all;
			color: var(--fg);
		}
		.sheet {
			margin: 0.75rem 0 0;
		}
		.note {
			margin: 0.25rem 0 0;
			font-size: var(--sl-text-xs);
			color: var(--mute);
		}
		.links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem 1.5rem;
			margin: 1.25rem 0 0;
		}
		a {
			color: var(--fg);
		}
	}
</style>
