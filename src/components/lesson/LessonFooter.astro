---
// Rendered from frontmatter below the lesson content (SPEC §5.1, §9). No client-side JavaScript.
import type { Lesson } from '../../lib/content-schemas.ts';
import { unlockedLessons } from '../../lib/lessons.ts';
import { classify } from '../../lib/content-schemas.ts';
import { cheatsheetLink } from '../../data/cheatsheets/index.ts';
import { AUTHOR_NAME, CURRICULUM_VERSION, FEEDBACK_URL } from '../../site.ts';

const { entry, locale } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const lesson = entry.data as unknown as Lesson;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date(lesson.reviewed).getUTCFullYear();
const title = entry.data.title;
const slug = classify(entry.id).path.split('/')[1] ?? '';
// Only English lessons of a stage with a cheatsheet (D44); the link is built from the sheet's own data.
const sheetLink = lesson.status === 'published' && locale !== 'vi' ? cheatsheetLink(lesson.stage, slug, lesson.order) : undefined;
const unlocked = await unlockedLessons(lesson.id, locale);

// A static page cannot know the reader's access date, so the citation omits it and the note says so.
// The author is the organization (src/site.ts), so the site name is not repeated.
const citation = `${AUTHOR_NAME}. (${year}). ${title}. Curriculum version ${CURRICULUM_VERSION}. ${pageUrl}`;

---

<section class="lesson-footer not-content">
	{/* "Mark this lesson done" (D64): hidden until src/scripts/lesson-done.ts runs; the room is held while JavaScript runs, so nothing moves. */}
	<p class="done dfz-noprint" data-lesson-done={lesson.id} hidden>
		<button type="button" data-on="Done ✓ · undo" data-off="Mark this lesson done">Mark this lesson done</button>
	</p>
	{unlocked.length > 0 && (
		<>
			<h2 class="label">{t('lesson.unlocks')}</h2>
			<ul>
				{unlocked.map((u) => <li>{u.code && <span class="code">{u.code} </span>}<a href={u.href}>{u.title}</a></li>)}
			</ul>
		</>
	)}
	{sheetLink && (
		<p class="sheet">
			<a href={sheetLink.href}>{t('lesson.cheatsheet', { stage: sheetLink.stage })}</a>
		</p>
	)}
	<h2 class="label">{t('lesson.sources')}</h2>
	<ul>
		{lesson.sources.map((s) => <li><a href={s.url}>{s.title}</a></li>)}
	</ul>
	<h2 class="label">{t('lesson.cite')}</h2>
	<p class="cite">{citation}</p>
	<p class="note">{t('lesson.citeNote')}</p>
	<div class="links dfz-noprint">
		{FEEDBACK_URL !== '' && (
			<details class="report">
				<summary>{t('lesson.reportIssue')}</summary>
				<form method="post" action={FEEDBACK_URL} class="report-form">
					<input type="hidden" name="page" value={Astro.url.pathname} />
					<input type="hidden" name="lesson_id" value={lesson.id} />
					<input type="hidden" name="lesson_title" value={title} />
					<input type="hidden" name="reviewed" value={new Date(lesson.reviewed).toISOString().slice(0, 10)} />
					<label for="fb-category">What is it?</label>
					<select id="fb-category" name="category" required>
						<option value="mistake">A mistake in the lesson</option>
						<option value="unclear">Something is unclear</option>
						<option value="broken">The code or data does not work</option>
						<option value="idea">An idea</option>
					</select>
					<label for="fb-message">Your message</label>
					<textarea id="fb-message" name="message" rows="5" minlength="5" maxlength="2000" required></textarea>
					{/* Honeypot: off screen, skipped by keyboards and screen readers; only a bot fills it. */}
					<div class="hp" aria-hidden="true">
						<label for="fb-website">Leave this field empty</label>
						<input id="fb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>
					<p class="privacy">Your message becomes a public issue on GitHub. Do not include your name, email or other personal details.</p>
					<button type="submit">Send</button>
				</form>
			</details>
		)}
	</div>
</section>

<script>
	import '../../scripts/lesson-done';
</script>

<style>
	@layer starlight.core {
		.done {
			margin: 0 0 1rem;
		}
		.done[hidden] {
			display: none;
		}
		/* Starlight's head script sets data-theme before first paint only when JavaScript runs: then the button's room is held
		   but not drawn. Without JavaScript the paragraph takes no room. */
		:global(:root[data-theme]) .done[hidden] {
			display: block;
			visibility: hidden;
		}
		.done button {
			min-height: 2.75rem;
			padding: 0.5rem 1.25rem;
			font: inherit;
			font-weight: 500;
			color: var(--fg);
			background: none;
			border: 1px solid var(--fg);
			border-radius: var(--radius-pill);
			cursor: pointer;
		}
		.done button[data-state='on'] {
			color: var(--bg);
			background: var(--fg);
		}
		.done button:focus-visible {
			outline: 2px solid var(--fg);
			outline-offset: 2px;
		}
		.lesson-footer .code {
			font-family: var(--font-mono);
			color: var(--sl-color-gray-3);
		}
		.lesson-footer {
			margin-top: 3rem;
			padding-top: 1.25rem;
			border-top: 1px solid var(--line);
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-2);
		}
		.label {
			margin: 1rem 0 0.25rem;
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			font-weight: 500;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--mute);
		}
		.label:first-child {
			margin-top: 0;
		}
		ul {
			margin: 0;
			padding-inline-start: 1.25rem;
		}
		li {
			margin: 0.125rem 0;
		}
		.cite {
			margin: 0;
			padding: 0.75rem;
			border: 1px solid var(--line);
			border-radius: var(--radius-panel);
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			overflow-wrap: anywhere;
			user-select: all;
			color: var(--fg);
		}
		.sheet {
			margin: 0.75rem 0 0;
		}
		.note {
			margin: 0.25rem 0 0;
			font-size: var(--sl-text-xs);
			color: var(--mute);
		}
		.links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem 1.5rem;
			color: var(--fg);
			margin: 1.25rem 0 0;
		}
		a {
			color: var(--fg);
		}
		/* "Report an issue" is a disclosure that is a plain flex item of the same row, so it works in every browser
		   (no display: contents, which drops the details semantics in some of them). Closed, it is one more link.
		   Open, it takes a full line of its own below the other links, summary centered above the form. */
		.links > :global(*) {
			white-space: nowrap;
		}
		.report[open] {
			flex: 0 0 100%;
			order: 1;
		}
		.report summary {
			list-style: none;
			cursor: pointer;
			text-decoration: underline;
			text-underline-offset: 0.2em;
			width: fit-content;
			margin-inline: auto;
		}
		.report summary::-webkit-details-marker {
			display: none;
		}
		.report summary:hover {
			color: var(--sl-color-white);
		}
		.report summary:focus-visible,
		.report-form :is(select, textarea, input, button):focus-visible {
			outline: 2px solid var(--fg);
			outline-offset: 2px;
		}
		.report-form {
			white-space: normal;
			display: grid;
			gap: 0.375rem;
			max-width: 32rem;
			margin: 0.5rem auto 0;
			text-align: start;
		}
		.report-form label {
			font-family: var(--font-mono);
			font-size: var(--sl-text-xs);
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--mute);
		}
		.report-form :is(select, textarea) {
			width: 100%;
			box-sizing: border-box;
			padding: 0.5rem 0.625rem;
			font: inherit;
			font-size: 1rem; /* 16px keeps phones from zooming into the field */
			color: var(--fg);
			background: var(--bg);
			border: 1px solid var(--dim);
			border-radius: var(--radius-panel);
		}
		.report-form textarea {
			resize: vertical;
			min-height: 7rem;
		}
		.report-form .privacy {
			margin: 0.5rem 0 0;
			font-size: var(--sl-text-xs);
			color: var(--mute);
		}
		.report-form button {
			justify-self: start;
			margin-top: 0.25rem;
			padding: 0.5rem 1.25rem;
			font: inherit;
			font-weight: 500;
			color: var(--bg);
			background: var(--fg);
			border: 0;
			border-radius: var(--radius-pill);
			cursor: pointer;
		}
		.hp {
			position: absolute;
			left: -10000px;
			width: 1px;
			height: 1px;
			overflow: hidden;
		}
		/* Three links stay on one line on a phone (owner): below 30rem the gap and the text shrink a little with the width
		   (14px at 360 px and wider, 12px at the narrowest), they never wrap. */
		@media (max-width: 30rem) {
			.links {
				column-gap: clamp(0.5rem, 3vw, 1.5rem);
				font-size: clamp(0.75rem, 3.7vw, var(--sl-text-sm));
			}
		}
	}
</style>
