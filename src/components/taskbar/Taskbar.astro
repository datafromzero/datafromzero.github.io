---
// The bottom bar on every page (SPEC D31, D35): a floating glass bar with two controls. Left, the menu button: a
// two-line label (small mono line "E8 · current section", then the lesson or page title) that opens the sheet.
// Right, the primary button: "Next E9 →" on a lesson, "Start E1 →" on /start/, "Start here →" everywhere else. The sheet has two tabs,
// "This lesson" (the page's own headings) and "Course" (the published lessons by stage), and a bottom row with Home,
// Career quiz, Report a problem and the light / dark switch; the Course pane ends with "About this site" (the project links; docs pages with a sidebar show
// them below 50rem only, the homepage and pages without a sidebar always). Phones get no other navigation: Starlight's header menu button
// and its "On this page" bar are hidden below the widths where they appear (CSS at the end of this file).
// One small script (scripts/taskbar.ts, < 1 KB gzipped) and CSS transitions only: no GSAP, no library.
// Without script the menu is a <details> toggle (the sheet opens through :has()), the tabs are radio inputs, the
// theme switch is hidden and back-to-top is a plain anchor.
import { getCollection } from 'astro:content';
import { projectHref, siteUi } from '../../i18n/site-ui';
import { classify, type Lesson } from '../../lib/content-schemas.ts';
import { groupRoadmap, nextLesson, type MapLesson } from '../../lib/roadmap.ts';
import { firstLesson } from '../../lib/lessons.ts';
import { FEEDBACK_URL } from '../../site.ts';

interface Props {
	lang: string;
	/** Second line of the menu button: the page title (the site name on the homepage). */
	label: string;
	/** In-page anchor of the top of the page (back-to-top without script). */
	top: string;
	/** The page's own headings (docs pages: the h2s; homepage: its sections), the sheet's first tab. */
	sections?: { href: string; name: string }[];
	/** Lessons: the code (E8) that starts the small line, and the lesson id that picks "Next". */
	lesson?: { id: string; code?: string };
	/** First text of the small line when it is not the lesson code (homepage: the first section's name). */
	kick?: string;
	/** Docs pages: whether Starlight shows the sidebar (it does not on `splash` pages such as the playground and the 404). */
	hasSidebar?: boolean;
}
const { lang, label, top, sections = [], lesson, kick, hasSidebar = false } = Astro.props;
const ui = siteUi(lang);
const t = ui.taskbar;
const path = Astro.url.pathname.replace(/index\.html$/, '');
const start = projectHref(lang, 'start');
// The course: published English lessons by stage (drafts never appear, SPEC D18).
const docs = await getCollection('docs');
const published: MapLesson[] = docs
	.filter((d) => {
		const c = classify(d.id);
		return c.kind === 'lesson' && c.locale === null && (d.data as Lesson).status === 'published';
	})
	.map((d) => {
		const l = d.data as Lesson;
		return { id: l.id, title: d.data.title, short_title: l.short_title, stage: l.stage, order: l.order, href: `/${classify(d.id).path}/`, prerequisites: [], status: l.status };
	});
const stages = groupRoadmap(published, new Set());
const filled = stages.filter((s) => s.lessons.length > 0);
const openStage = filled.find((s) => s.lessons.some((l) => l.id === lesson?.id))?.id ?? filled[0]?.id;
const next = lesson && nextLesson(stages, lesson.id);
// Right-hand button (owner decisions): Next on a lesson (the roadmap after the last one); on /start/ itself, the first
// published lesson ("Start E1"), so it never points back at the page you are on; on every other page, "Start here".
const first = await firstLesson();
const onStart = path === start;
const primary = next
	? { href: next.href, text: `${t.next} ${next.code}`, aria: `${t.next}: ${next.code} ${next.title}` }
	: lesson
		? { href: start, text: t.roadmap }
		: onStart && first
			? { href: first.href, text: `${t.begin} ${first.code}`, aria: `${t.begin}: ${first.code} ${first.title}` }
			: { href: start, text: t.start };
const tabbed = sections.length > 0;
// "About this site" (owner, 2026-11-24): the project links, in the sheet. Pages with a sidebar show them only below 50rem, where the
// sidebar (which has the same group) is not on screen; the homepage and splash pages (playground, 404) have none, so they show them at every width.
const isHome = path === '/' || path === '/vi/';
const aboutAlways = isHome || !hasSidebar;
const about = (['about', 'cite', 'changelog', 'license', 'privacy', 'translate'] as const).map((slug) => [projectHref(lang, slug), ui.nav[slug]] as const);
const current = (href: string) => (href === path ? 'page' : undefined);
const foot = [
	[lang === 'vi' ? '/vi/' : '/', t.home],
	[projectHref(lang, 'career-quiz'), t.quiz],
];
// "Report a problem" (SPEC D37, D58): a plain POST form to the feedback Worker, the same as the lesson footer's. No page links
// to the GitHub issue tracker (owner, 2026-11-25): while FEEDBACK_URL is empty the pane only says reporting is off.
const kicker = kick ?? lesson?.code ?? '';
---

<div class="tb-gap" aria-hidden="true"></div>
<nav class="tb" aria-label={t.label}>
	<div class="tb-card">
		<div class="tb-sheet" id="tb-sheet">
			<div>
				<div class="tb-radios" role="radiogroup" aria-label={t.tabs}>
					<input class="tb-r" type="radio" name="tb-tab" id="tb-t2" checked />
					{tabbed && <input class="tb-r" type="radio" name="tb-tab" id="tb-t1" />}
					<input class="tb-r" type="radio" name="tb-tab" id="tb-t3" />
				</div>
				{
					tabbed ? (
						<div class="tb-tabs">
							<label for="tb-t2">{t.course}</label>
							<label for="tb-t1">{lesson ? t.thisLesson : t.thisPage}</label>
						</div>
					) : (
						<p class="tb-head tb-head-course">{t.course}</p>
					)
				}
				<div class="tb-panes">
					{
						tabbed && (
							<div class="tb-pane tb-p1">
								<ul class="tb-on">
									{sections.map((x) => <li><a href={x.href}>{x.name}</a></li>)}
								</ul>
							</div>
						)
					}
					<div class="tb-pane tb-p2">
						{
							filled.map((s) => (
								<details class="tb-stage" open={s.id === openStage}>
									<summary>{s.title}<span class="tb-n">{s.lessons.length}</span></summary>
									<ul>
										{s.lessons.map((l) => (
											<li><a href={l.href} aria-current={l.id === lesson?.id ? 'page' : undefined}><span class="tb-code">{l.code}</span><span>{l.label}</span></a></li>
										))}
									</ul>
								</details>
							))
						}
						<ul class="tb-soon">
							{stages.filter((s) => s.lessons.length === 0).map((s) => <li>{s.title} · {t.soon}</li>)}
						</ul>
						<a class="tb-all" href={start}>{t.roadmapAll}<span aria-hidden="true">→</span></a>
						<a class="tb-all" href="/sql/playground/" aria-current={current('/sql/playground/')}>{t.playground}<span aria-hidden="true">→</span></a>
						<nav class:list={['tb-about', { 'tb-about-always': aboutAlways }]} aria-labelledby="tb-about-head">
							<p class="tb-head" id="tb-about-head">{ui.nav.label}</p>
							<ul>
								{about.map(([href, text]) => <li><a href={href} aria-current={current(href)}>{text}</a></li>)}
							</ul>
						</nav>
					</div>
					<div class="tb-pane tb-p3">
						<p class="tb-head">{t.report}</p>
						{FEEDBACK_URL !== '' ? (
							<form method="post" action={FEEDBACK_URL}>
								<input type="hidden" name="page" value={path} />
								{lesson && <input type="hidden" name="lesson_id" value={lesson.id} />}
								<input type="hidden" name="lesson_title" value={label} />
								<label class="tb-fl">
									{t.reportKind}
									<select name="category" required>{t.reportKinds.map(([value, text]) => <option value={value}>{text}</option>)}</select>
								</label>
								<label class="tb-fl">
									{t.reportDetails}
									<textarea name="message" rows="4" minlength="5" maxlength="2000" required placeholder={t.reportHint}></textarea>
								</label>
								{/* Honeypot: hidden from people, keyboards and screen readers; only a bot fills it. */}
								<div class="tb-hp" aria-hidden="true">
									<label>Leave this field empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
								</div>
								<p class="tb-note">{t.reportNote}</p>
								<button class="tb-go" type="submit">{t.reportSent}</button>
							</form>
						) : (
							<p class="tb-note">{t.reportOff}</p>
						)}
					</div>
				</div>
				<div class="tb-foot">
					{foot.map(([href, text]) => <a href={href} aria-current={current(href)}>{text}</a>)}
					<label class="tb-icon tb-flag" for="tb-t3">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 21V4m0 0h11l-2 4 2 4H5"></path>
						</svg>
						<span class="tb-sr">{t.report}</span>
					</label>
					<button class="tb-icon tb-theme tb-js" type="button" aria-label={t.toLight} data-light={t.toLight} data-dark={t.toDark}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
							<circle cx="12" cy="12" r="8.5"></circle>
							<path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
		<div class="tb-row">
			<button class="tb-menu tb-js" type="button" aria-expanded="false" aria-controls="tb-sheet">
				<span class="tb-burger" aria-hidden="true"><i></i><i></i></span>
				<span class="tb-label">
					<span class="tb-kick" data-c={lesson?.code}>{kicker}</span>
					<span class="tb-title">{label}</span>
				</span>
				<span class="tb-sr">, {t.shortcuts}</span>
			</button>
			<noscript>
				<details class="tb-fallback">
					<summary class="tb-menu">
						<span class="tb-burger" aria-hidden="true"><i></i><i></i></span>
						<span class="tb-label">
							<span class="tb-kick">{kicker}</span>
							<span class="tb-title">{label}</span>
						</span>
						<span class="tb-sr">, {t.shortcuts}</span>
					</summary>
				</details>
				<style is:inline>
					.tb-js {
						display: none !important;
					}
				</style>
			</noscript>
			<a class="tb-learn" href={primary.href} aria-label={primary.aria}>
				<span class={primary.short ? 'tb-long' : undefined}>{primary.text}</span>{primary.short && <span class="tb-short">{primary.short}</span>}
				<span class="tb-arr" aria-hidden="true">→</span>
			</a>
			<a class="tb-icon tb-top" href={top} aria-label={t.top}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 14l6-6 6 6"></path>
				</svg>
			</a>
		</div>
	</div>
</nav>

<script>
	import '../../scripts/taskbar';
</script>

<style>
	/* Colors come from the site tokens (src/styles/tokens.css); only the glass tints are the bar's own. */
	:global(:root) {
		--tb-space: calc(88px + env(safe-area-inset-bottom, 0px));
		/* Liquid glass (owner request): see-through enough to show the page moving under the bar, blurred so it never
		   competes with the menu text. */
		--tb-glass: rgba(16, 16, 16, 0.5);
		--tb-edge: rgba(255, 255, 255, 0.12);
		--tb-sheen: rgba(255, 255, 255, 0.07);
		--tb-chip: rgba(255, 255, 255, 0.07);
		/* small labels on the dark glass need more than --mute for AA (13px text) */
		--tb-label: #8a8a8a;
		--tb-ease: cubic-bezier(0.16, 1, 0.3, 1);
		/* a small overshoot, like a spring, for the sheet's rows and button presses */
		--tb-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	:global(:root[data-theme='light']) {
		--tb-glass: rgba(252, 252, 252, 0.55);
		--tb-edge: rgba(0, 0, 0, 0.1);
		--tb-sheen: rgba(255, 255, 255, 0.6);
		--tb-chip: rgba(0, 0, 0, 0.06);
		--tb-label: var(--mute);
	}
	/* Room under the last content (footer, pagination) so the floating bar never covers it. */
	.tb-gap {
		height: var(--tb-space);
	}
	/* The consent banner (SPEC §11) sits above the bar. */
	:global(.dfz-consent) {
		bottom: var(--tb-space) !important;
	}

	.tb {
		position: fixed;
		left: 50%;
		bottom: calc(16px + env(safe-area-inset-bottom, 0px));
		z-index: 40;
		width: min(720px, calc(100% - 2 * max(16px, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px))));
		transform: translateX(-50%);
		color: var(--fg);
		font-family: var(--font-sans);
		line-height: 1.5;
	}
	/* Docs pages with the fixed sidebar: centered on the main frame, so the sidebar never covers the bar. */
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) .tb {
			left: calc(50% + var(--sl-sidebar-width) / 2);
			width: min(720px, calc(100% - var(--sl-sidebar-width) - 32px));
		}
	}
	/* With the table of contents on the right too: centered on the content column between them (the TOC is
	   a fixed column, --dfz-toc-width in tokens.css), so neither sidebar draws over the bar. */
	@media (min-width: 72rem) {
		:global(:root[data-has-sidebar][data-has-toc]) .tb {
			left: calc(var(--sl-sidebar-width) + (100% - var(--sl-sidebar-width) - var(--dfz-toc-width)) / 2);
			width: min(720px, calc(100% - var(--sl-sidebar-width) - var(--dfz-toc-width) - 32px));
		}
	}
	.tb-card {
		position: relative;
		overflow: hidden;
		background: var(--tb-glass);
		border: 1px solid var(--tb-edge);
		border-radius: 16px;
		-webkit-backdrop-filter: blur(14px) saturate(1.8);
		backdrop-filter: blur(14px) saturate(1.8);
		box-shadow:
			inset 0 1px 0 var(--tb-sheen),
			0 12px 40px rgba(0, 0, 0, 0.22);
	}
	/* The glass sheen: a soft light from the top edge, drawn over the tint and under the content. */
	.tb-card::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(180deg, var(--tb-sheen), transparent 38%);
		opacity: 0.6;
		pointer-events: none;
	}
	/* Browsers without backdrop blur get a solid bar, so text never sits on a busy page. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.tb-card {
			background: var(--bg);
		}
	}
	/* Light motion, CSS only (D31: no GSAP off the homepage): rows rise into place one after another when the sheet
	   opens, and buttons give a little when pressed. */
	.tb-on li,
	.tb-stage,
	.tb-foot > * {
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.3s ease,
			transform 0.5s var(--tb-spring);
	}
	.tb.open :is(.tb-on li, .tb-stage, .tb-foot > *),
	.tb:has(.tb-fallback[open]) :is(.tb-on li, .tb-stage, .tb-foot > *) {
		opacity: 1;
		transform: none;
	}
	.tb.open .tb-on li:nth-child(2) { transition-delay: 0.03s; }
	.tb.open .tb-on li:nth-child(3) { transition-delay: 0.06s; }
	.tb.open .tb-on li:nth-child(4) { transition-delay: 0.09s; }
	.tb.open .tb-on li:nth-child(5) { transition-delay: 0.12s; }
	.tb.open .tb-on li:nth-child(6) { transition-delay: 0.15s; }
	.tb.open .tb-on li:nth-child(n + 7) { transition-delay: 0.18s; }
	.tb.open .tb-foot > * { transition-delay: 0.12s; }
	.tb-menu,
	.tb-learn,
	.tb-icon {
		transition: transform 0.25s var(--tb-spring), background-color 0.2s;
	}
	.tb-menu:active,
	.tb-learn:active,
	.tb-icon:active {
		transform: scale(0.96);
	}
	.tb ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tb a {
		color: var(--fg);
		text-decoration: none;
	}
	.tb :is(a, button, summary):focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: -2px;
	}

	.tb-row {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 56px;
		padding: 0 6px;
	}
	/* Without script the <noscript> wrapper is the row's first flex item (Astro does not scope it). Never
	   change its display: with script its content is raw text that must stay hidden. */
	.tb-row :global(noscript) {
		flex: 1 1 0;
		min-width: 0;
	}
	.tb-menu {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		flex: 1 1 0;
		height: 48px;
		margin: 0;
		padding: 0 12px;
		border: 0;
		border-radius: 10px;
		background: none;
		color: var(--fg);
		font: inherit;
		text-align: start;
		cursor: pointer;
		list-style: none;
	}
	.tb-menu::-webkit-details-marker {
		display: none;
	}
	.tb-menu:hover {
		background: var(--tb-chip);
	}
	/* Two lines: the small mono line (code and current section) over the title. Both end in an ellipsis when too long. */
	.tb-label {
		display: grid;
		flex: 1;
		min-width: 0;
	}
	.tb-label > * {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.tb-kick {
		color: var(--tb-label);
		font: 500 11px/1.35 var(--font-mono);
	}
	/* No code and no section yet (top of a project page): drop the line so the title sits level with the icon. */
	.tb-kick:empty {
		display: none;
	}
	.tb-title {
		font: 500 15px/1.3 var(--font-sans);
		letter-spacing: -0.01em;
	}
	.tb-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.tb-burger {
		position: relative;
		flex: none;
		width: 20px;
		height: 14px;
	}
	.tb-burger i {
		position: absolute;
		left: 0;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.4s var(--tb-ease);
	}
	/* Two lines, 6px apart around the middle of the 14px box, so they cross into an X without a third line to hide. */
	.tb-burger i:nth-child(1) {
		top: 3px;
	}
	.tb-burger i:nth-child(2) {
		top: 9px;
	}
	.tb-learn {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 18px;
		border-radius: 10px;
		background: var(--fg);
		font: 500 14px/1 var(--font-sans);
		white-space: nowrap;
	}
	.tb .tb-learn {
		color: var(--bg);
	}
	.tb-arr {
		transition: transform 0.3s var(--tb-ease);
	}
	.tb-learn:hover .tb-arr {
		transform: translateX(3px);
	}
	.tb .tb-learn:focus-visible {
		outline-offset: 2px;
	}
	.tb-short {
		display: none;
	}
	@media (max-width: 420px) {
		.tb-long {
			display: none;
		}
		.tb-short {
			display: inline;
		}
		.tb-learn {
			padding: 0 12px;
		}
		.tb-menu {
			gap: 10px;
			padding: 0 10px;
		}
	}
	.tb-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 10px;
		background: var(--tb-chip);
		color: var(--fg);
		cursor: pointer;
		transition: opacity 0.3s;
	}
	.tb-icon svg {
		width: 20px;
		height: 20px;
	}
	.tb-icon:hover {
		outline: 1px solid var(--tb-edge);
	}
	.tb-icon[aria-disabled='true'] {
		opacity: 0.35;
		pointer-events: none;
	}

	/* The sheet: the card grows upward from the bar. Closed, it is collapsed and hidden (no focus, no
	   reading); the script also makes it inert. */
	.tb-sheet {
		display: grid;
		grid-template-rows: 0fr;
		visibility: hidden;
		transition:
			grid-template-rows 0.55s var(--tb-ease),
			visibility 0s 0.55s;
	}
	.tb-sheet > div {
		min-height: 0;
		overflow: hidden;
	}
	.tb.open .tb-sheet,
	.tb:has(.tb-fallback[open]) .tb-sheet {
		grid-template-rows: 1fr;
		visibility: visible;
		transition-delay: 0s;
	}
	.tb.open .tb-burger i:nth-child(1),
	.tb-fallback[open] .tb-burger i:nth-child(1) {
		transform: translateY(3px) rotate(45deg);
	}
	.tb.open .tb-burger i:nth-child(2),
	.tb-fallback[open] .tb-burger i:nth-child(2) {
		transform: translateY(-3px) rotate(-45deg);
	}
	/* Tabs: radio inputs and labels, switched with :has(); no script. The radios are visually hidden but focusable
	   (arrow keys move between tabs); the focus ring is drawn on the label. */
	.tb-tabs {
		position: relative;
		display: flex;
		gap: 4px;
		margin: 12px 12px 0;
		padding: 3px;
		border-radius: 12px;
		background: var(--tb-chip);
	}
	/* One list only (no headings): a plain heading instead of a one-button control. */
	.tb-head {
		margin: 0;
		padding: 16px 16px 0;
		font: 500 14px/1 var(--font-sans);
	}
	.tb-radios {
		position: relative;
		height: 0;
	}
	.tb-r {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	/* The Report pane hides the Course heading that stands in for the tabs on pages without headings. */
