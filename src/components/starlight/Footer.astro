---
// Lesson footer (sources, citation, edit and issue links) above Starlight's own footer, plus the
// project page links, the build-time content of project pages (map, citation, changelog, license,
// privacy), the consent banner (renders nothing while analytics is off) and the bottom taskbar (SPEC D31,
// its one small script). No motion script: GSAP runs on the homepage only (SPEC D28).
import Default from '@astrojs/starlight/components/Footer.astro';
import LessonFooter from '../lesson/LessonFooter.astro';
import ProjectExtras from '../project/ProjectExtras.astro';
import Consent from '../project/Consent.astro';
import CookieSettings from '../project/CookieSettings.astro';
import Taskbar from '../taskbar/Taskbar.astro';
import { classify, type Lesson } from '../../lib/content-schemas.ts';
import { lessonCode } from '../../lib/roadmap.ts';
import { projectHref, siteUi } from '../../i18n/site-ui';

const { entry, locale, headings } = Astro.locals.starlightRoute;
const isLesson = classify(entry.id).kind === 'lesson';
const lang = locale === 'vi' ? 'vi' : 'en';
// The page's own h2s for the taskbar sheet. From `headings`, not `toc`: pages with `tableOfContents: false` (privacy,
// cite, license) have no ToC but do have h2s.
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, name: h.text }));
const l = isLesson ? (entry.data as unknown as Lesson) : undefined;
const lesson = l && { id: l.id, code: lessonCode(l.stage, l.order) };
const t = siteUi(lang).nav;
const links = [
	['about', t.about],
	['cite', t.cite],
	['changelog', t.changelog],
	['license', t.license],
	['privacy', t.privacy],
	['translate', t.translate],
] as const;
---

{isLesson && <LessonFooter />}
<ProjectExtras id={entry.id.replace(/^vi\//, '')} lang={lang} />
{/* Lessons end with their own Suggest an edit / Report an issue links only (owner, 2026-11-23); the project
    links stay in the sidebar's "About this site" group, and Cookie settings in the footer of every project page. */}
{!isLesson && (
	<nav class="project-links not-content dfz-noprint" aria-label={t.label}>
		{links.map(([slug, label]) => <a href={projectHref(lang, slug)}>{label}</a>)}
		<CookieSettings lang={lang} />
	</nav>
)}
<Default><slot /></Default>
<Consent lang={lang} />
<Taskbar lang={lang} label={entry.data.title} top="#_top" sections={sections} lesson={lesson} />

<style>
	.project-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 20px;
		margin-top: 32px;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	/* Six links do not fit one line on a phone: show them as an even 3 x 2 grid instead of a ragged wrap. */
	@media (max-width: 30rem) {
		.project-links {
			display: grid;
			grid-template-columns: repeat(3, auto);
			justify-content: center;
			justify-items: center;
			gap: 12px 28px;
		}
	}
	.project-links a {
		color: inherit;
		text-underline-offset: 0.2em;
	}
	.project-links a:hover,
	.project-links :global(button):hover {
		color: var(--sl-color-white);
	}
</style>
