---
// Lesson footer (sources, citation, issue form) above Starlight's own footer, plus the build-time content of
// project pages (map, citation, changelog, license, privacy), the consent banner (renders nothing while analytics is off)
// and the bottom taskbar (SPEC D31, its one small script). No motion script: GSAP runs on the homepage only (SPEC D28).
import Default from '@astrojs/starlight/components/Footer.astro';
import LessonFooter from '../lesson/LessonFooter.astro';
import PlacementScript from '../lesson/PlacementScript.astro';
import ProjectExtras from '../project/ProjectExtras.astro';
import Consent from '../project/Consent.astro';
import Taskbar from '../taskbar/Taskbar.astro';
import { classify, type Lesson } from '../../lib/content-schemas.ts';
import { lessonCode } from '../../lib/roadmap.ts';

const { entry, locale, headings, hasSidebar } = Astro.locals.starlightRoute;
const isLesson = classify(entry.id).kind === 'lesson';
const lang = locale === 'vi' ? 'vi' : 'en';
// The page's own h2s for the taskbar sheet. From `headings`, not `toc`: pages with `tableOfContents: false` (privacy,
// cite, license) have no ToC but do have h2s.
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, name: h.text }));
const l = isLesson ? (entry.data as unknown as Lesson) : undefined;
const lesson = l && { id: l.id, code: lessonCode(l.stage, l.order) };
---

{isLesson && <LessonFooter />}
{/* A page with a placement test (stage pages and the lessons that end a core part) gets the script of its "mark these lessons done" button (D67). */}
{(entry.body ?? '').includes('data-placement-test') && <PlacementScript />}
<ProjectExtras id={entry.id.replace(/^vi\//, '')} lang={lang} />
{/* Nothing else ends a page: the project links live only in the sidebar's "About this site" group and Cookie settings only on
    /privacy/ (owner, 2026-11-24). Do not add a link row here again. */}
<Default><slot /></Default>
<Consent lang={lang} />
<Taskbar lang={lang} label={entry.data.title} top="#_top" sections={sections} lesson={lesson} hasSidebar={hasSidebar} />

