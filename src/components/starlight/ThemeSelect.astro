---
// Dark / light picker. Replaces Starlight's three-way picker, whose "auto" option follows the OS
// color scheme; SPEC D9 makes dark the default instead.
import { Icon } from '@astrojs/starlight/components';
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select>
	<Select
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[
			{ label: Astro.locals.t('themeSelect.dark'), selected: true, value: 'dark' },
			{ label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
		]}
		width="5.5em"
	>
		<Fragment slot="icon">
			<Icon name="moon" class="sl-theme-icon-dark" />
			<Icon name="sun" class="sl-theme-icon-light" />
		</Fragment>
	</Select>
</starlight-theme-select>

{/* Inlined to avoid a flash of the wrong value. */}
<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem('starlight-theme');
		} catch (e) {}
		const theme = stored === 'light' ? 'light' : 'dark';
		document.querySelectorAll('starlight-theme-select select').forEach((s) => {
			s.value = theme;
		});
	})();
</script>

<style>
	@layer starlight.components {
		starlight-theme-select:has([value='dark']:not(:checked)) :global(.sl-theme-icon-dark),
		starlight-theme-select:has([value='light']:not(:checked)) :global(.sl-theme-icon-light) {
			display: none;
		}
	}
</style>

<script>
	type Theme = 'dark' | 'light';
	const storageKey = 'starlight-theme';

	const parseTheme = (value: unknown): Theme => (value === 'light' ? 'light' : 'dark');

	function loadTheme(): Theme {
		try {
			return parseTheme(localStorage.getItem(storageKey));
		} catch {
			return 'dark';
		}
	}

	function applyTheme(theme: Theme, persist: boolean): void {
		document
			.querySelectorAll<HTMLSelectElement>('starlight-theme-select select')
			.forEach((select) => {
				select.value = theme;
			});
		document.documentElement.dataset.theme = theme;
		if (!persist) return;
		try {
			localStorage.setItem(storageKey, theme);
		} catch {
			// Storage can be blocked; the choice then lasts for this page view only.
		}
	}

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme(), false);
			this.querySelector('select')?.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					applyTheme(parseTheme(e.currentTarget.value), true);
				}
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>
