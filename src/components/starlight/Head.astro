---
// Starlight's head plus a preload of the one font file every docs page needs for its first text
// (Geist 400, Latin), so the first paint does not wait for the stylesheet to discover it.
import Default from '@astrojs/starlight/components/Head.astro';
import geistRegular from '@fontsource/geist/files/geist-latin-400-normal.woff2?url';
---

<Default><slot /></Default>
<link rel="preload" href={geistRegular} as="font" type="font/woff2" crossorigin />
