---
// Starlight's page banner slot (the top of the content column, in normal flow, under the fixed header) plus the
// consent banner (SPEC §11). Like GOV.UK and Microsoft Learn, the consent banner sits at the top of the page and is
// never fixed, so it covers no content, no focused element (WCAG 2.2 SC 2.4.11) and not the bottom taskbar.
import Default from '@astrojs/starlight/components/Banner.astro';
import Consent from '../project/Consent.astro';

const lang = Astro.locals.starlightRoute.locale === 'vi' ? 'vi' : 'en';
---

<Consent lang={lang} />
<Default />
