---
// Starlight's title plus, on lesson pages, the lesson header (SPEC §5.1); on /start/, the "Continue" link (D64); on a
// stage index page (/excel/ and the others, D64), the stage's lesson list, so the page's own Markdown (the placement
// test, later) reads after it; on a glossary term (D68), a link back to the A to Z list.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import LessonHeader from '../lesson/LessonHeader.astro';
import ContinueLink from '../project/ContinueLink.astro';
import StageLessons from '../project/StageLessons.astro';
import { classify, STAGES } from '../../lib/content-schemas.ts';

const { entry } = Astro.locals.starlightRoute;
const isLesson = classify(entry.id).kind === 'lesson';
const isStage = (STAGES as readonly string[]).includes(entry.id);
const isTerm = classify(entry.id).kind === 'glossary';
---

<Default><slot /></Default>
{isLesson && <LessonHeader />}
{entry.id === 'start' && <div class="not-content"><ContinueLink top="14px" hold /></div>}
{isStage && <StageLessons stage={entry.id} />}
{isTerm && <p class="back not-content"><a href="/reference/glossary/">← All words</a></p>}

<style>
	.back {
		margin: 4px 0 0;
		font-size: var(--sl-text-sm);
	}
	.back a {
		color: var(--mute);
		text-underline-offset: 0.2em;
	}
	.back a:hover {
		color: var(--fg);
	}
</style>
