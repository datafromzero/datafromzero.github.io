---
// SPEC D9: dark unless the visitor has explicitly chosen light. Starlight's stock provider falls
// back to the OS color scheme; this one falls back to dark. Without JavaScript no data-theme is
// set and tokens.css already defaults to dark.
---

{/* Inlined to avoid a flash of the wrong theme. */}
<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem('starlight-theme');
		} catch (e) {}
		document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
	})();
</script>
