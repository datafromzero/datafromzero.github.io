}

{
	name === 'wide' && (
		<svg class="csf" viewBox="-1 -1 340 200" role="img" aria-labelledby="csf-wide-t csf-wide-d">
			<title id="csf-wide-t">Wide and long</title>
			<desc id="csf-wide-d">
				A wide table has one row per store and one column per payment method: store 1 has 421 card, 91 cash and 217 mobile
				orders, and store 2 has 400, 107 and 209. melt turns the three column headings into the values of one column,
				payment_method, and gives a long table with one row per store and method, six rows in all. pivot turns it back.
			</desc>
			<text class="n" x="0" y="9">wide: a column for each method</text>
			<g class="r-src">
				{wideCols.map((c) => (
					<g>
						<rect class="box fill" x={c.x} y="14" width={c.w} height="16" rx="3" />
