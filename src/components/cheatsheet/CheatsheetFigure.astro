					</g>
				))}
				{wideRows.map((r, i) => wideCols.map((c, j) => (
					<g>
						<rect class="box" x={c.x} y={34 + i * 20} width={c.w} height="16" rx="3" />
						<text class="s" x={c.x + 5} y={45.5 + i * 20}>{r[j]}</text>
					</g>
				)))}
			</g>
			<text class="n" x="200" y="25.5">the headings card, cash</text>
