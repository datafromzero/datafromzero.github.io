---
// The small drawings of the stage cheatsheets (SPEC D44). SQL: the order a query runs its clauses, the join types, and
// aggregate against window. Excel: a messy sheet against a tidy table, a lookup as a key-matched join, and a pivot as rows
// collapsing into groups (numbers from the lessons E1, E5 and E8). Our own drawings, built at build time as inline SVG: no script, no image file. Colors are
// the clause roles of D41 (the same seven hues as `src/styles/step-animation.css`); text and outlines use the site
// tokens, so it reads in dark and light, and in print everything turns black on white. Every drawing has a title, a
// description and a caption in words, so color is never the only cue.
interface Props {
	name: 'order' | 'joins' | 'window' | 'tidy' | 'lookup' | 'pivot';
}
const { name } = Astro.props;

// ---- 1. The logical execution order -------------------------------------------------------------------------------
const W = 70;
const GAP = 14;
const steps = [
	{ n: 1, word: 'FROM', note: 'the table', role: 'src', row: 0, col: 0 },
	{ n: 2, word: 'WHERE', note: 'keep rows', role: 'flt', row: 0, col: 1 },
	{ n: 3, word: 'GROUP BY', note: 'make groups', role: 'grp', row: 0, col: 2 },
	{ n: 4, word: 'HAVING', note: 'keep groups', role: 'flt', row: 0, col: 3 },
	{ n: 5, word: 'SELECT', note: 'pick columns', role: 'out', row: 1, col: 0 },
	{ n: 6, word: 'ORDER BY', note: 'sort', role: 'ord', row: 1, col: 1 },
	{ n: 7, word: 'LIMIT', note: 'cut', role: 'ord', row: 1, col: 2 },
].map((s) => ({ ...s, x: s.col * (W + GAP), y: 6 + s.row * 58 }));
const centerX = (col: number) => col * (W + GAP) + W / 2;

// ---- 2. Join types -------------------------------------------------------------------------------------------------
const leftKeys = ['A', 'B', 'C'];
const rightKeys = ['B', 'C', 'D'];
const panels = [
	{ x: 0, role: 'src', head: 'INNER JOIN', rows: [['B', 'B'], ['C', 'C']], count: '2 rows' },
	{ x: 113, role: 'src', head: 'LEFT JOIN', rows: [['A', 'NULL'], ['B', 'B'], ['C', 'C']], count: '3 rows' },
	{ x: 226, role: 'flt', head: 'ANTI JOIN', rows: [['A', 'NULL']], count: '1 row' },
];

// ---- 3. Aggregate against window -----------------------------------------------------------------------------------
const groups = ['A', 'A', 'B', 'B'];

// ---- 4. Messy sheet against tidy table (E1) ------------------------------------------------------------------------
const messy = [
	{ cells: [{ w: 160, t: 'OLD TOWN: WEEKLY SALES' }], dash: true },
	{ cells: [{ w: 160, t: '' }], dash: true },
	{ cells: [{ w: 58, t: 'Mon Jan 5' }, { w: 102, t: '4 orders, $36.75' }], dash: false },
	{ cells: [{ w: 58, t: 'Tue Jan 6' }, { w: 102, t: '5 orders, $68.75' }], dash: false },
	{ cells: [{ w: 58, t: 'TOTAL' }, { w: 102, t: '30 orders, $362.50' }], dash: true },
];
const tidyCols = [{ x: 180, w: 62, h: 'date' }, { x: 242, w: 40, h: 'orders' }, { x: 282, w: 56, h: 'sales_usd' }];
const tidyRows = [['2026-01-05', '4', '36.75'], ['2026-01-06', '5', '68.75']];

// ---- 5. A lookup as a key-matched join (E8) ------------------------------------------------------------------------
const lines = [[10, '3.25'], [6, '4.75'], [1, '3.00']] as const;
const products = [[1, '3.00'], [6, '4.75'], [10, '3.25']] as const;

// ---- 6. A pivot: rows collapse into groups (E5, E15) ---------------------------------------------------------------
const orderRows = [['Campus', '14.00', 'grp'], ['Old Town', '12.50', 'src'], ['Campus', '12.50', 'grp']] as const;
---

{
	name === 'order' && (
		<svg class="csf" viewBox="-1 -1 324 116" role="img" aria-labelledby="csf-order-t csf-order-d">
			<title id="csf-order-t">The order a query runs its clauses</title>
			<desc id="csf-order-d">
				Seven boxes in the order they run: 1 FROM, 2 WHERE, 3 GROUP BY, 4 HAVING, 5 SELECT, 6 ORDER BY, 7 LIMIT. The first four
				choose and shape the rows, then SELECT picks the columns.
			</desc>
			{steps.map((s) => (
				<g class={`r-${s.role}`}>
					<rect class="box" x={s.x} y={s.y} width={W} height="36" rx="5" />
					<text class="w" x={s.x + 7} y={s.y + 15}>{s.n} {s.word}</text>
					<text class="n" x={s.x + 7} y={s.y + 28}>{s.note}</text>
				</g>
			))}
			{[0, 1, 2].map((i) => (
				<path class="arr" d={`M${(i + 1) * (W + GAP) - GAP + 1} 24 H${(i + 1) * (W + GAP) - 2} m-3 -3 l3 3 l-3 3`} />
			))}
			{[0, 1].map((i) => (
				<path class="arr" d={`M${(i + 1) * (W + GAP) - GAP + 1} 82 H${(i + 1) * (W + GAP) - 2} m-3 -3 l3 3 l-3 3`} />
			))}
			<path class="arr" d={`M${centerX(3)} 43 V52 H${centerX(0)} V61 m-3 -3 l3 3 l3 -3`} />
		</svg>
	)
}

{
	name === 'joins' && (
		<svg class="csf" viewBox="-1 -1 332 176" role="img" aria-labelledby="csf-joins-t csf-joins-d">
			<title id="csf-joins-t">What each join type keeps</title>
			<desc id="csf-joins-d">
				The left table has the keys A, B and C and the right table has B, C and D. B and C find a partner. An inner join keeps
				B and C, two rows. A left join keeps A with NULL, B and C, three rows. An anti join keeps only A, the left row with no
				partner, one row.
			</desc>
			<text class="n" x="0" y="9">left table</text>
			<text class="n" x="96" y="9">right table</text>
			{leftKeys.map((k, i) => (
				<g class="r-src">
					<rect class="box" x="0" y={14 + i * 20} width="40" height="16" rx="3" />
					<text class="w m" x="20" y={26 + i * 20}>{k}</text>
				</g>
			))}
			{rightKeys.map((k, i) => (
				<g class="r-src">
					<rect class="box" x="96" y={14 + i * 20} width="40" height="16" rx="3" />
					<text class="w m" x="116" y={26 + i * 20}>{k}</text>
				</g>
			))}
			<path class="match" d="M40 42 L96 22 M40 62 L96 42" />
			<text class="n" x="152" y="26">B and C: a partner</text>
			<text class="n" x="152" y="46">A: none on the right</text>
			<text class="n" x="152" y="66">D: none on the left</text>
			{panels.map((p) => (
				<g class={`r-${p.role}`}>
					<text class="w" x={p.x} y="92">{p.head}</text>
					<path class="rule" d={`M${p.x} 98 H${p.x + 104}`} />
					{p.rows.map(([l, r], i) => (
						<g>
							<rect class={r === 'NULL' ? 'box dash' : 'box'} x={p.x} y={104 + i * 20} width="104" height="16" rx="3" />
							<text class="w" x={p.x + 8} y={116 + i * 20}>{l}</text>
							<text class="n" x={p.x + 40} y={116 + i * 20}>{r}</text>
						</g>
					))}
					<text class="n" x={p.x} y="170">{p.count}</text>
				</g>
			))}
		</svg>
	)
}

{
	name === 'window' && (
		<svg class="csf" viewBox="-1 -1 332 126" role="img" aria-labelledby="csf-window-t csf-window-d">
			<title id="csf-window-t">An aggregate collapses rows, a window keeps them</title>
			<desc id="csf-window-d">
				Four rows in two groups, A A B B. With GROUP BY they collapse into two rows, one per group, each holding the group total.
				With OVER all four rows stay, and each row gets its group total beside it.
			</desc>
			{[0, 178].map((x, side) => (
				<g class={side === 0 ? 'r-grp' : 'r-win'}>
					<text class="w" x={x} y="12">{side === 0 ? 'GROUP BY' : 'OVER'}</text>
					<text class="n" x={x} y="25">{side === 0 ? 'rows collapse into groups' : 'every row stays'}</text>
					{groups.map((g, i) => (
						<g>
							<rect class="box" x={x} y={34 + i * 20} width="54" height="16" rx="3" />
							<text class="w" x={x + 6} y={46 + i * 20}>Row {i + 1} {g}</text>
						</g>
					))}
					<path class="arr" d={`M${x + 60} 70 H${x + 78} m-3 -3 l3 3 l-3 3`} />
					{(side === 0 ? [0, 2] : [0, 1, 2, 3]).map((i) => (
						<g>
							<rect class="box fill" x={x + 84} y={side === 0 ? 43 + (i / 2) * 40 : 34 + i * 20} width="66" height="16" rx="3" />
							<text class="w" x={x + 91} y={(side === 0 ? 55 + (i / 2) * 40 : 46 + i * 20)}>{groups[i]} · Σ {groups[i]}</text>
						</g>
					))}
				</g>
			))}
		</svg>
	)
}

{
	name === 'tidy' && (
		<svg class="csf" viewBox="-1 -1 340 142" role="img" aria-labelledby="csf-tidy-t csf-tidy-d">
			<title id="csf-tidy-t">A sheet to read against a table to analyze</title>
			<desc id="csf-tidy-d">
				On the left, a weekly report with a merged title, a blank row, two facts in one cell such as 4 orders and 36.75 dollars,
				and a total row inside the data. On the right, the same week as a table: a header row of date, orders and sales_usd,
				and one row per day. One row is one record, one column is one field, one fact per cell.
			</desc>
			<text class="n" x="0" y="9">a sheet to read</text>
			<text class="n" x="180" y="9">a table to analyze</text>
			{messy.map((r, i) => {
				let x = 0;
				return r.cells.map((c) => {
					const cx = x;
					x += c.w;
					return (
						<g class={r.dash ? 'r-flt' : 'r-ord'}>
							<rect class={r.dash ? 'box dash' : 'box'} x={cx} y={14 + i * 18} width={c.w} height="16" rx="3" />
							<text class="w s" x={cx + 5} y={25.5 + i * 18}>{c.t}</text>
						</g>
					);
				});
			})}
			<path class="arr" d="M164 59 H176 m-3 -3 l3 3 l-3 3" />
			<g class="r-src">
				{tidyCols.map((c) => (
					<g>
						<rect class="box fill" x={c.x} y="14" width={c.w} height="16" rx="3" />
						<text class="w s" x={c.x + 5} y="25.5">{c.h}</text>
					</g>
				))}
				{tidyRows.map((r, i) => (
					<g>
						{tidyCols.map((c, j) => (
							<g>
								<rect class={i === 0 ? 'box row' : 'box'} x={c.x} y={32 + i * 18} width={c.w} height="16" rx="3" />
								<text class="s" x={c.x + 5} y={43.5 + i * 18}>{r[j]}</text>
							</g>
						))}
					</g>
				))}
				<text class="n" x="186" y="75">…</text>
			</g>
			<g class="r-flt">
				<text class="n" x="0" y="112">a title, a blank row,</text>
				<text class="n" x="0" y="123">two facts in one cell,</text>
				<text class="n" x="0" y="134">a total inside the data</text>
			</g>
			<text class="n" x="180" y="112">one row = one record</text>
			<text class="n" x="180" y="123">one column = one field</text>
			<text class="n" x="180" y="134">one fact per cell</text>
		</svg>
	)
}

{
	name === 'lookup' && (
		<svg class="csf" viewBox="-1 -1 290 142" role="img" aria-labelledby="csf-lookup-t csf-lookup-d">
			<title id="csf-lookup-t">A lookup pairs rows by the key</title>
			<desc id="csf-lookup-d">
				On the left, order lines with product ids 10, 6, 1 and 17, and a price column to fill. On the right, the products table
				with ids 1, 6 and 10 and prices 3.00, 4.75 and 3.25. Lines pair each id with the same id on the right, not with the row
				in the same position, and bring the price back: 3.25, 4.75 and 3.00. Id 17 has no partner and shows #N/A.
			</desc>
			<text class="n" x="0" y="9">order lines</text>
			<text class="n" x="186" y="9">products</text>
			<g class="r-src">
				<rect class="box" x="0" y="14" width="40" height="16" rx="3" />
				<rect class="box" x="40" y="14" width="52" height="16" rx="3" />
				<text class="w s" x="5" y="25.5">id</text>
				<text class="w s" x="45" y="25.5">price</text>
				<rect class="box" x="186" y="14" width="40" height="16" rx="3" />
				<rect class="box" x="226" y="14" width="52" height="16" rx="3" />
				<text class="w s" x="191" y="25.5">id</text>
				<text class="w s" x="231" y="25.5">price</text>
				{lines.map(([k, p], i) => (
					<g>
						<rect class="box" x="0" y={34 + i * 20} width="40" height="16" rx="3" />
						<rect class="box fill" x="40" y={34 + i * 20} width="52" height="16" rx="3" />
						<text class="s" x="5" y={45.5 + i * 20}>{k}</text>
						<text class="w s" x="45" y={45.5 + i * 20}>{p}</text>
					</g>
				))}
				{products.map(([k, p], i) => (
					<g>
						<rect class="box" x="186" y={34 + i * 20} width="40" height="16" rx="3" />
						<rect class="box" x="226" y={34 + i * 20} width="52" height="16" rx="3" />
						<text class="s" x="191" y={45.5 + i * 20}>{k}</text>
						<text class="s" x="231" y={45.5 + i * 20}>{p}</text>
					</g>
				))}
				<text class="n" x="191" y="105">…</text>
			</g>
			<path class="match" d="M92 42 L186 82 M92 62 L186 62 M92 82 L186 42" />
			<g class="r-flt">
				<rect class="box" x="0" y="94" width="40" height="16" rx="3" />
				<rect class="box dash" x="40" y="94" width="52" height="16" rx="3" />
				<text class="s" x="5" y="105.5">17</text>
				<text class="w s" x="45" y="105.5">#N/A</text>
				<text class="n" x="100" y="105.5">17: no partner</text>
			</g>
			<text class="n" x="0" y="126">the key picks the row, never the position</text>
			<text class="n" x="0" y="137">no partner: #N/A, or the words you choose</text>
		</svg>
	)
}

{
	name === 'pivot' && (
		<svg class="csf" viewBox="-1 -1 346 130" role="img" aria-labelledby="csf-pivot-t csf-pivot-d">
			<title id="csf-pivot-t">A pivot collapses rows into groups</title>
			<desc id="csf-pivot-d">
				Three order rows: Campus 14.00, Old Town 12.50 and Campus 12.50. A PivotTable with store in Rows and the sum of amount_usd
				in Values collapses them into two rows: Campus 26.50 and Old Town 12.50. The grand total, 39.00, equals the sum of the
				three source rows.
			</desc>
			<text class="n" x="0" y="9">rows of the table</text>
			<text class="n" x="174" y="9">PivotTable, store in Rows</text>
			<g class="r-ord">
				<rect class="box" x="0" y="14" width="52" height="16" rx="3" />
				<rect class="box" x="52" y="14" width="62" height="16" rx="3" />
				<text class="w s" x="5" y="25.5">store</text>
				<text class="w s" x="57" y="25.5">amount_usd</text>
			</g>
			{orderRows.map(([st, amt, role], i) => (
				<g class={`r-${role}`}>
					<rect class="box" x="0" y={34 + i * 20} width="52" height="16" rx="3" />
					<rect class="box" x="52" y={34 + i * 20} width="62" height="16" rx="3" />
					<text class="s" x="5" y={45.5 + i * 20}>{st}</text>
					<text class="s" x="57" y={45.5 + i * 20}>{amt}</text>
					<path class="ln" d={`M118 ${42 + i * 20} L168 ${i === 1 ? 62 : 42}`} />
					<circle class="dot" cx="168" cy={i === 1 ? 62 : 42} r="2.5" />
				</g>
			))}
			<g class="r-ord">
				<rect class="box" x="174" y="14" width="64" height="16" rx="3" />
				<rect class="box" x="238" y="14" width="106" height="16" rx="3" />
				<text class="w s" x="179" y="25.5">store</text>
				<text class="w s" x="243" y="25.5">Sum of amount_usd</text>
			</g>
			<g class="r-grp">
				<rect class="box fill" x="174" y="34" width="64" height="16" rx="3" />
				<rect class="box fill" x="238" y="34" width="106" height="16" rx="3" />
				<text class="s" x="179" y="45.5">Campus</text>
				<text class="w s" x="243" y="45.5">26.50</text>
			</g>
			<g class="r-src">
				<rect class="box fill" x="174" y="54" width="64" height="16" rx="3" />
				<rect class="box fill" x="238" y="54" width="106" height="16" rx="3" />
				<text class="s" x="179" y="65.5">Old Town</text>
				<text class="w s" x="243" y="65.5">12.50</text>
			</g>
			<g class="r-ord">
				<path class="rule" d="M174 76 H344" />
				<text class="w s" x="179" y="89">Grand Total</text>
				<text class="w s" x="243" y="89">39.00</text>
			</g>
			<text class="n" x="0" y="112">3 rows collapse into 2 groups</text>
			<text class="n" x="0" y="123">grand total 39.00 = 14.00 + 12.50 + 12.50</text>
		</svg>
	)
}

<style>
	.csf {
		display: block;
		width: 100%;
		height: auto;
		max-width: 26rem;
		/* The clause roles of D41; the same hues as step-animation.css. */
		--c-src: #0072b2;
		--c-flt: #c0392b;
		--c-grp: #00a07a;
		--c-out: #ad9100;
		--c-win: #d6479a;
		--c-ord: #808080;
		font-family: var(--font-mono);
	}
	.csf .box {
		fill: none;
		stroke: var(--c);
		stroke-width: 1.5;
	}
	.csf .box.fill {
		fill: color-mix(in srgb, var(--c) 18%, transparent);
	}
	.csf .box.dash {
		stroke-dasharray: 3 2;
	}
	.csf .r-src { --c: var(--c-src); }
	.csf .r-flt { --c: var(--c-flt); }
	.csf .r-grp { --c: var(--c-grp); }
	.csf .r-out { --c: var(--c-out); }
	.csf .r-win { --c: var(--c-win); }
	.csf .r-ord { --c: var(--c-ord); }
	.csf text {
		fill: var(--fg);
		font-size: 10px;
	}
	.csf .w {
		font-weight: 500;
	}
	.csf .m {
		text-anchor: middle;
	}
	.csf .s {
		font-size: 9px;
	}
	.csf .box.row {
		fill: color-mix(in srgb, var(--c) 18%, transparent);
	}
	.csf .ln {
		fill: none;
		stroke: var(--c);
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	.csf .dot {
		fill: var(--c);
	}
	.csf .n {
		fill: var(--mute);
		font-family: var(--font-sans);
		font-size: 9.5px;
	}
	.csf .arr {
		fill: none;
		stroke: var(--mute);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.csf .match {
		fill: none;
		stroke: #9a6be0; /* ON: the match between two tables */
		stroke-width: 1.5;
	}
	.csf .rule {
		fill: none;
		stroke: var(--c);
		stroke-width: 2;
	}
	@media print {
		.csf {
			--c-src: #000;
			--c-flt: #000;
			--c-grp: #000;
			--c-out: #000;
			--c-win: #000;
			--c-ord: #000;
			max-width: 100%;
		}
		.csf .match {
			stroke: #000;
		}
		.csf text,
		.csf .n {
			fill: #000;
		}
		.csf .box.fill,
		.csf .box.row {
			fill: #ddd;
		}
	}
</style>
