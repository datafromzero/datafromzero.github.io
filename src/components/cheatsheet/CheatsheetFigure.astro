			<path class="arr" d="M40 76 V92 m-3 -3 l3 3 l3 -3" />
			<path class="arr" d="M120 92 V76 m-3 3 l3 -3 l3 3" />
			<text class="n" x="50" y="88">melt</text>
			<text class="n" x="130" y="88">pivot</text>
			<text class="n" x="0" y="106">long: a row for each store and method</text>
			<g class="r-grp">
				{longCols.map((c) => (
					<g>
						<rect class="box fill" x={c.x} y="112" width={c.w} height="16" rx="3" />
						<text class="w s" x={c.x + 5} y="123.5">{c.h}</text>
					</g>
				))}
				{longRows.map((r, i) => longCols.map((c, j) => (
					<g>
						<rect class="box" x={c.x} y={132 + i * 20} width={c.w} height="16" rx="3" />
						<text class="s" x={c.x + 5} y={143.5 + i * 20}>{r[j]}</text>
